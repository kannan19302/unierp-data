enum BlockchainTxStatus {
  PENDING /// Queued, not yet submitted to Fabric
  SUBMITTED /// Submitted to Fabric, awaiting confirmation
  CONFIRMED /// Confirmed in a committed block
  FAILED /// Submission failed (Fabric error)
  RETRYING /// Queued for retry after failure
}

enum VerificationResult {
  VERIFIED /// On-chain hash matches local data
  TAMPERED /// Hash mismatch — data was modified after anchoring
  NOT_FOUND /// No on-chain record exists yet
  NETWORK_ERROR /// Fabric was unreachable during verification
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tenantId  String    @map("tenant_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tenantId  String    @map("tenant_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String? // e.g. "Chrome on Windows" — set from the User-Agent at subscribe time
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

model MfaPushChallenge {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  token     String   @unique // hash of the MFA challenge JWT, ties this row to one login attempt
  status    String   @default("PENDING") // PENDING, APPROVED, DENIED, EXPIRED
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([tenantId, userId])
  @@map("mfa_push_challenges")
}
