generator client {
  provider = "prisma-client-js"
  output   = "../src/idp-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  email        String
  passwordHash String?   @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  avatar       String?
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  preferences  Json      @default("{}")

  emailVerifiedAt DateTime? @map("email_verified_at")

  mfaEnabled       Boolean @default(false) @map("mfa_enabled")
  mfaSecret        String? @map("mfa_secret")
  mfaPending       Boolean @default(false) @map("mfa_pending")
  mfaRecoveryCodes Json    @default("[]") @map("mfa_recovery_codes")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime? @map("password_changed_at")

  roles            UserRole[]
  userSessions     UserSession[]
  groupMemberships UserGroupMember[]
  identities       UserIdentity[]
  apiTokens        AuthApiToken[]
  profile          UserProfile?
  directReports    UserProfile[]     @relation("UserProfileManager")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model UserProfile {
  id         String @id @default(cuid())
  tenantId   String @map("tenant_id")
  userId     String @unique @map("user_id")
  employeeId String @map("employee_id") // system-generated, 6 digits, unique per tenant

  pronouns              String?
  jobTitle              String? @map("job_title")
  departmentId          String? @map("department_id")
  managerId             String? @map("manager_id") // -> User.id (reports-to)
  timezone              String?
  workingHoursStart     String? @map("working_hours_start") // "09:00"
  workingHoursEnd       String? @map("working_hours_end") // "18:00"
  workingDays           Json    @default("[\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\"]") @map("working_days")
  workingLocation       String? @map("working_location")
  overview              String? @db.Text
  pronunciationAudioUrl String? @map("pronunciation_audio_url") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager User? @relation("UserProfileManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@index([managerId])
  @@index([departmentId])
  @@map("user_profiles")
}

model UserIdentity {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  hashedKey   String    @unique @map("hashed_key")
  prefix      String
  rateLimit   Int       @default(60) @map("rate_limit") // Requests per min
  status      String    @default("ACTIVE") // ACTIVE, REVOKED
  apiScopes   String?   @map("api_scopes")
  ipWhitelist String?   @map("ip_whitelist")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("api_keys")
}

model AuthApiToken {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  scopes     Json      @default("[]")
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("auth_api_tokens")
}

model UserSession {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  userId           String    @map("user_id")
  token            String    @unique
  device           String?
  browser          String?
  ipAddress        String?   @map("ip_address")
  location         String?
  isActive         Boolean   @default(true) @map("is_active")
  startedAt        DateTime  @default(now()) @map("started_at")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at")
  expiresAt        DateTime? @map("expires_at")
  refreshTokenHash String?   @unique @map("refresh_token_hash")
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  rememberMe       Boolean   @default(false) @map("remember_me")
  // Multi-client device identity (.ai/MULTI_CLIENT_MASTER_PLAN.md § 7) — set
  // by Flutter mobile/desktop clients via X-Device-Id/X-Platform/X-App-Version
  // headers; null for browser sessions. deviceId lets notifications bind a
  // push token to a specific installed app instance.
  deviceId         String?   @map("device_id")
  platform         String?   @map("platform")
  appVersion       String?   @map("app_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("user_sessions")
}

model UserGroup {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members UserGroupMember[]

  @@unique([tenantId, name])
  @@map("user_groups")
}

model UserGroupMember {
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("user_group_members")
}

