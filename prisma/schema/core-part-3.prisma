  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  plan SaaSPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("saas_plan_features")
}

model SaaSInvoice {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  subscriptionId String?   @map("subscription_id")
  invoiceNumber  String    @unique @map("invoice_number")
  status         String    @default("DRAFT") // DRAFT, PENDING, PAID, OVERDUE, CANCELLED, REFUNDED
  currency       String    @default("USD")
  subtotal       Decimal   @default(0) @db.Decimal(15, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(15, 2)
  amountDue      Decimal   @default(0) @map("amount_due") @db.Decimal(15, 2)
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  dueDate        DateTime? @map("due_date")
  paidAt         DateTime? @map("paid_at")
  notes          String?
  pdfUrl         String?   @map("pdf_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription?   @relation(fields: [subscriptionId], references: [id])
  lines        SaaSInvoiceLineItem[]
  transactions PaymentTransaction[]

  @@index([tenantId])
  @@index([status])
  @@map("saas_invoices")
}

model SaaSInvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  description String
  type        String // PLAN, ADDON, OVERAGE, CREDIT, TAX, DISCOUNT
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(15, 2)
  totalPrice  Decimal  @default(0) @map("total_price") @db.Decimal(15, 2)
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  invoice SaaSInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("saas_invoice_line_items")
}

model UsageAlertRule {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  metric          String // STORAGE_MB, API_CALLS_COUNT, USERS_COUNT
  thresholdPct    Int       @default(80) @map("threshold_pct")
  notifyEmail     Boolean   @default(true) @map("notify_email")
  notifyWebhook   Boolean   @default(false) @map("notify_webhook")
  notifyInApp     Boolean   @default(true) @map("notify_in_app")
  webhookUrl      String?   @map("webhook_url")
  isActive        Boolean   @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alertLogs UsageAlertLog[]

  @@unique([tenantId, metric])
  @@map("usage_alert_rules")
}

model UsageAlertLog {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  ruleId       String?  @map("rule_id")
  metric       String
  level        String   @default("WARNING") // INFO, WARNING, CRITICAL
  message      String
  currentValue Decimal? @map("current_value") @db.Decimal(15, 2)
  limitValue   Decimal? @map("limit_value") @db.Decimal(15, 2)
  sentEmail    Boolean  @default(false) @map("sent_email")
  sentWebhook  Boolean  @default(false) @map("sent_webhook")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule   UsageAlertRule? @relation(fields: [ruleId], references: [id])

  @@index([tenantId])
  @@map("usage_alert_logs")
}

model TenantApiKey {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  keyPrefix   String    @map("key_prefix")
  keyHash     String    @map("key_hash")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  permissions Json      @default("[]") // array of permission strings
  ipWhitelist Json?     @map("ip_whitelist") // array of CIDR ranges
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([keyHash])
  @@map("tenant_api_keys")
}

model TenantAuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String // subscription.change, invoice.paid, api.key.created, settings.updated etc.
  resource   String? // e.g. "subscription", "invoice", "api-key"
  resourceId String?  @map("resource_id")
  details    Json?    @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@map("tenant_audit_logs")
}

model TenantSupportTicket {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  userId      String?   @map("user_id")
  subject     String
  description String
  category    String    @default("GENERAL") // BILLING, TECHNICAL, FEATURE, GENERAL
  priority    String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, WAITING_CUSTOMER, RESOLVED, CLOSED
  assignedTo  String?   @map("assigned_to")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  resolvedAt  DateTime? @map("resolved_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([tenantId])
  @@index([status])
  @@map("tenant_support_tickets")
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String   @map("ticket_id")
  userId      String?  @map("user_id")
  message     String
  attachments Json?    @default("[]")
  isStaff     Boolean  @default(false) @map("is_staff")
  createdAt   DateTime @default(now()) @map("created_at")

  ticket TenantSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model TenantDomain {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  domain          String    @unique
  isPrimary       Boolean   @default(false) @map("is_primary")
  verificationKey String?   @map("verification_key")
  verifiedAt      DateTime? @map("verified_at")
  sslStatus       String    @default("PENDING") // PENDING, ISSUED, EXPIRED, FAILED
  sslExpiresAt    DateTime? @map("ssl_expires_at")
  status          String    @default("PENDING") // PENDING, ACTIVE, FAILED
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandings TenantBranding[]

  @@unique([tenantId, domain])
  @@map("tenant_domains")
}

model TenantSsoConfig {
  id               String   @id @default(cuid())
  tenantId         String   @unique @map("tenant_id")
  provider         String   @default("OIDC") // OIDC, SAML, GOOGLE, MICROSOFT, GITHUB
  issuerUrl        String?  @map("issuer_url")
  clientId         String?  @map("client_id")
  clientSecret     String?  @map("client_secret")
  authorizationUrl String?  @map("authorization_url")
  tokenUrl         String?  @map("token_url")
  userInfoUrl      String?  @map("user_info_url")
  jwksUrl          String?  @map("jwks_url")
  attributeMapping Json?    @default("{}") // maps IdP attributes to user fields
  isEnabled        Boolean  @default(false) @map("is_enabled")
  requireMfa       Boolean  @default(false) @map("require_mfa")
  domains          Json?    @default("[]") // allowed email domains
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_sso_configs")
}

model TenantBranding {
  id             String   @id @default(cuid())
  tenantId       String   @unique @map("tenant_id")
  logoUrl        String?  @map("logo_url")
  faviconUrl     String?  @map("favicon_url")
  primaryColor   String?  @default("#2563EB") @map("primary_color")
  accentColor    String?  @default("#7C3AED") @map("accent_color")
  companyName    String?  @map("company_name")
  supportEmail   String?  @map("support_email")
  supportUrl     String?  @map("support_url")
  customCss      String?  @map("custom_css")
  customDomainId String?  @map("custom_domain_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customDomain TenantDomain? @relation(fields: [customDomainId], references: [id])

  @@map("tenant_branding")
}

model DataExportJob {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  type         String // EXPORT, IMPORT
  format       String // CSV, JSON, XLSX
  scope        Json      @default("{}") // {modules: ["finance", "crm"], dateRange: {}}
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETE, FAILED
  fileUrl      String?   @map("file_url")
  fileSize     Int?      @map("file_size")
  errorMessage String?   @map("error_message")
  recordCount  Int?      @map("record_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("data_export_jobs")
}
