  assignedAt DateTime @default(now()) @map("assigned_at")
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  ticket HrTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId])
