model HrTicketCategory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?  @db.Text
  slaHours    Int?     @map("sla_hours")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tickets HrTicket[]

  @@index([tenantId])
  @@map("hr_ticket_categories")
}

model HrTicket {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  categoryId        String?   @map("category_id")
  employeeId        String    @map("employee_id")
  subject           String
  description       String    @db.Text
  priority          String    @default("MEDIUM")
  status            String    @default("OPEN")
  assignedTo        String?   @map("assigned_to")
  source            String    @default("PORTAL")
  slaDeadline       DateTime? @map("sla_deadline")
  resolvedAt        DateTime? @map("resolved_at")
  resolution        String?   @db.Text
  satisfactionScore Int?      @map("satisfaction_score")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  category    HrTicketCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignments HrTicketAssignment[]

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@index([tenantId, assignedTo])
  @@map("hr_advanced_tickets")
}

model HrTicketAssignment {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
