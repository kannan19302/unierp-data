model Employee {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  orgId          String    @map("org_id")
  userId         String?   @map("user_id")
  departmentId   String?   @map("department_id")
  employeeCode   String    @map("employee_code")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String
  phone          String?
  designation    String?
  dateOfBirth    DateTime? @map("date_of_birth")
  dateOfJoining  DateTime  @map("date_of_joining")
  dateOfLeaving  DateTime? @map("date_of_leaving")
  employmentType String    @default("FULL_TIME") @map("employment_type")
  status         String    @default("ACTIVE")
  address        Json?
  bankDetails    Json?     @map("bank_details")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  department          Department?          @relation(fields: [departmentId], references: [id])
  trainingEnrollments TrainingEnrollment[]
  fixedAssets         FixedAsset[]

  @@unique([tenantId, orgId, employeeCode])
  @@index([tenantId])
  @@map("employees")
}

model EmployeeDocument {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  employeeId String    @map("employee_id")
  name       String
  docType    String    @map("doc_type") // OFFER_LETTER, CONTRACT, TAX_FORM, ID_PROOF, CERTIFICATION
  fileUrl    String?   @map("file_url")
  expiryDate DateTime? @map("expiry_date")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("employee_documents")
}

model EmployeeSkill {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  employeeId       String   @map("employee_id")
  skillName        String   @map("skill_name")
  proficiency      Int      @default(1) // 1-5
  category         String   @default("TECHNICAL") // TECHNICAL, SOFT, MANAGEMENT, LANGUAGE
  certified        Boolean  @default(false)
  certificationUrl String?  @map("certification_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, employeeId, skillName])
  @@index([tenantId])
  @@map("employee_skills")
}

model PayrollRun {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  status          String   @default("DRAFT") // DRAFT, PAID
  totalGross      Decimal  @map("total_gross") @db.Decimal(15, 2)
  totalDeductions Decimal  @map("total_deductions") @db.Decimal(15, 2)
  totalNet        Decimal  @map("total_net") @db.Decimal(15, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  slips PayrollSlip[]

  @@index([tenantId])
  @@map("payroll_runs")
}

model PayrollSlip {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  payrollRunId String   @map("payroll_run_id")
  employeeId   String   @map("employee_id")
  grossSalary  Decimal  @map("gross_salary") @db.Decimal(15, 2)
  deductions   Decimal  @db.Decimal(15, 2)
  netSalary    Decimal  @map("net_salary") @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payroll_slips")
}

model LeavePolicy {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  name              String
  leaveType         String   @map("leave_type") // SICK, CASUAL, ANNUAL, MATERNITY
  annualAllocation  Int      @map("annual_allocation")
  carryForwardLimit Int      @default(0) @map("carry_forward_limit")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  requests LeaveRequest[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("leave_policies")
}

model LeaveRequest {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  employeeId String    @map("employee_id")
  policyId   String    @map("policy_id")
  startDate  DateTime  @map("start_date")
  endDate    DateTime  @map("end_date")
  reason     String?
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")
