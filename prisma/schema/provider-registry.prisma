// ─────────────────────────────────────────────────
// Provider registry — Track M (Provider Admin OS), M03.
//
// Platform-owned, not tenant-owned: no tenantId, no RLS. Same precedent as
// ControlPlaneAuditLog / ControlPlaneApproval / ControlPlaneReviewTask —
// these describe the platform's own capability-to-vendor bindings, not a
// customer's business data.
//
// ProviderCredential is secret-ref only. There is deliberately no column a
// literal secret value could be written into — a `secretRef` points at an
// external secrets manager entry (Vault path, cloud secrets-manager ARN).
// ─────────────────────────────────────────────────

model Provider {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// ACTIVE | DISABLED | DISABLED_EXPIRED_CREDENTIAL
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bindings     ProviderBinding[]
  credentials  ProviderCredential[]
  capabilities ProviderCapability[]
  healthChecks ProviderHealthCheck[]
  quotas       ProviderQuota[]
  priceSheet   ProviderPriceSheetEntry[]

  @@index([status])
  @@map("providers")
}

/// A provider's CLAIM to serve a capability (capability-registry.ts's
/// CapabilityContract.id, e.g. "email.send"). Distinct from ProviderCapability,
/// which is what discovery actually found the provider supports.
model ProviderBinding {
  id           String   @id @default(cuid())
  providerId   String   @map("provider_id")
  capabilityId String   @map("capability_id")
  createdAt    DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capabilityId])
  @@index([capabilityId])
  @@map("provider_bindings")
}

model ProviderCredential {
  id         String    @id @default(cuid())
  providerId String    @map("provider_id")
  /// Pointer into an external secrets manager. Never the secret itself.
  secretRef  String    @map("secret_ref")
  label      String?
  rotatedAt  DateTime? @map("rotated_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([expiresAt])
  @@map("provider_credentials")
}

/// What discovery against the live provider actually found, as opposed to
/// what ProviderBinding claims. discoveredAt is when this row was last
/// refreshed by a discovery run, not when the row was first created.
model ProviderCapability {
  id              String   @id @default(cuid())
  providerId      String   @map("provider_id")
  capabilityId    String   @map("capability_id")
  discoveredAt    DateTime @default(now()) @map("discovered_at")
  discoveryDetail Json?    @map("discovery_detail")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capabilityId])
  @@map("provider_capabilities")
}

// ── M04 · health, limits, quotas and pricing — all observed, not declared ──
//
// The one exception is the health-check INTERVAL itself (M04's exit
// criterion names it "declared"): how often a probe should run is
// configuration; whether the provider is actually healthy is only ever
// what the most recent probe observed.

model ProviderHealthConfig {
  id               String @id @default(cuid())
  providerId       String @unique @map("provider_id")
  intervalSeconds  Int    @map("interval_seconds")

  @@map("provider_health_configs")
}

/// One probe result. Health is derived from the MOST RECENT row for a
/// provider, not stored as a mutable flag — an unhealthy provider's history
/// stays intact rather than being overwritten by its next check.
model ProviderHealthCheck {
  id         String   @id @default(cuid())
  providerId String   @map("provider_id")
  checkedAt  DateTime @default(now()) @map("checked_at")
  healthy    Boolean
  latencyMs  Int?     @map("latency_ms")
  error      String?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, checkedAt])
  @@map("provider_health_checks")
}

/// Observed, not configured: what has actually been measured for a
/// provider+capability, e.g. by reading the provider's own rate-limit
/// response headers or its published quota — never a value someone typed in.
model ProviderQuota {
  id           String   @id @default(cuid())
  providerId   String   @map("provider_id")
  capabilityId String   @map("capability_id")
  limitValue   Int      @map("limit_value")
  windowSeconds Int     @map("window_seconds")
  observedAt   DateTime @default(now()) @map("observed_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capabilityId])
  @@map("provider_quotas")
}

/// The single price sheet M06 (routing) and M25 (cost allocation) both read
/// — not a second copy either phase maintains on its own.
model ProviderPriceSheetEntry {
  id           String   @id @default(cuid())
  providerId   String   @map("provider_id")
  capabilityId String   @map("capability_id")
  operation    String
  unit         String
  pricePerUnit Decimal  @map("price_per_unit") @db.Decimal(19, 4)
  currency     String   @default("USD")
  observedAt   DateTime @default(now()) @map("observed_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capabilityId, operation, unit])
  @@map("provider_price_sheet_entries")
}
