// ─────────────────────────────────────────────────
// Provider registry — Track M (Provider Admin OS), M03.
//
// Platform-owned, not tenant-owned: no tenantId, no RLS. Same precedent as
// ControlPlaneAuditLog / ControlPlaneApproval / ControlPlaneReviewTask —
// these describe the platform's own capability-to-vendor bindings, not a
// customer's business data.
//
// ProviderCredential is secret-ref only. There is deliberately no column a
// literal secret value could be written into — a `secretRef` points at an
// external secrets manager entry (Vault path, cloud secrets-manager ARN).
// ─────────────────────────────────────────────────

model Provider {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// ACTIVE | DISABLED | DISABLED_EXPIRED_CREDENTIAL
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bindings     ProviderBinding[]
  credentials  ProviderCredential[]
  capabilities ProviderCapability[]
  healthChecks ProviderHealthCheck[]
  quotas       ProviderQuota[]
  priceSheet   ProviderPriceSheetEntry[]

  @@index([status])
  @@map("providers")
}

/// A provider's CLAIM to serve a capability (capability-registry.ts's
/// CapabilityContract.id, e.g. "email.send"). Distinct from ProviderCapability,
/// which is what discovery actually found the provider supports.
model ProviderBinding {
  id           String   @id @default(cuid())
  providerId   String   @map("provider_id")
  capabilityId String   @map("capability_id")
  /// Lower number = tried first. M06's primary/secondary/fallback order.
  priority     Int      @default(100)
  createdAt    DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capabilityId])
  @@index([capabilityId, priority])
  @@map("provider_bindings")
}

model ProviderCredential {
  id         String    @id @default(cuid())
  providerId String    @map("provider_id")
  /// Pointer into an external secrets manager. Never the secret itself.
  secretRef  String    @map("secret_ref")
  label      String?
  rotatedAt  DateTime? @map("rotated_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([expiresAt])
  @@map("provider_credentials")
}

/// What discovery against the live provider actually found, as opposed to
/// what ProviderBinding claims. discoveredAt is when this row was last
/// refreshed by a discovery run, not when the row was first created.
model ProviderCapability {
  id              String   @id @default(cuid())
  providerId      String   @map("provider_id")
  capabilityId    String   @map("capability_id")
  discoveredAt    DateTime @default(now()) @map("discovered_at")
  discoveryDetail Json?    @map("discovery_detail")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capabilityId])
  @@map("provider_capabilities")
}

// ── M04 · health, limits, quotas and pricing — all observed, not declared ──
//
// The one exception is the health-check INTERVAL itself (M04's exit
// criterion names it "declared"): how often a probe should run is
// configuration; whether the provider is actually healthy is only ever
// what the most recent probe observed.

model ProviderHealthConfig {
  id               String @id @default(cuid())
  providerId       String @unique @map("provider_id")
  intervalSeconds  Int    @map("interval_seconds")

  @@map("provider_health_configs")
}

/// One probe result. Health is derived from the MOST RECENT row for a
/// provider, not stored as a mutable flag — an unhealthy provider's history
/// stays intact rather than being overwritten by its next check.
model ProviderHealthCheck {
  id         String   @id @default(cuid())
  providerId String   @map("provider_id")
  checkedAt  DateTime @default(now()) @map("checked_at")
  healthy    Boolean
  latencyMs  Int?     @map("latency_ms")
  error      String?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, checkedAt])
  @@map("provider_health_checks")
}

/// Observed, not configured: what has actually been measured for a
/// provider+capability, e.g. by reading the provider's own rate-limit
/// response headers or its published quota — never a value someone typed in.
model ProviderQuota {
  id           String   @id @default(cuid())
  providerId   String   @map("provider_id")
  capabilityId String   @map("capability_id")
  limitValue   Int      @map("limit_value")
  windowSeconds Int     @map("window_seconds")
  observedAt   DateTime @default(now()) @map("observed_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capabilityId])
  @@map("provider_quotas")
}

// ── M06 · routing, priority, fallback and tenant selection ──

/// A tenant pinned to a specific provider for a capability. Absolute: M06's
/// router checks this BEFORE priority/health/fallback, and a pinned tenant
/// is never routed to anything else — including while that provider's own
/// health would otherwise trigger fallback for every other tenant.
model TenantProviderOverride {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  capabilityId String   @map("capability_id")
  providerId   String   @map("provider_id")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, capabilityId])
  @@map("tenant_provider_overrides")
}

/// Sticky routing: once a (tenant, capability, stickyKey) triple is routed
/// to a provider, later calls with the same key return to it as long as
/// it's still healthy — for providers that hold state across calls (a
/// conversational session, a multi-step upload).
model StickyRouteAssignment {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  capabilityId String   @map("capability_id")
  stickyKey    String   @map("sticky_key")
  providerId   String   @map("provider_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  @@unique([tenantId, capabilityId, stickyKey])
  @@map("sticky_route_assignments")
}

/// Consecutive-failure circuit breaking, independent of M04's health probe:
/// a provider can pass its periodic health check and still be failing every
/// real call (slow degradation a probe's own cadence hasn't caught yet).
model ProviderCircuitState {
  id                  String    @id @default(cuid())
  providerId          String    @unique @map("provider_id")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  /// Set when the breaker trips; cleared on the next successful call after
  /// the cool-down window has passed.
  openedAt            DateTime? @map("opened_at")

  @@map("provider_circuit_states")
}

/// The single price sheet M06 (routing) and M25 (cost allocation) both read
/// — not a second copy either phase maintains on its own.
model ProviderPriceSheetEntry {
  id           String   @id @default(cuid())
  providerId   String   @map("provider_id")
  capabilityId String   @map("capability_id")
  operation    String
  unit         String
  pricePerUnit Decimal  @map("price_per_unit") @db.Decimal(19, 4)
  currency     String   @default("USD")
  observedAt   DateTime @default(now()) @map("observed_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capabilityId, operation, unit])
  @@map("provider_price_sheet_entries")
}

// ── M25 · provider billing and cost ingestion ──
//
// One batch per (providerId, period): re-ingesting the same period
// upserts this row and REPLACES its line items rather than appending —
// that replace-not-append is the entire "does not double-count"
// mechanism, not a dedup step layered on top of an append.
model CostIngestionBatch {
  id            String   @id @default(cuid())
  providerId    String   @map("provider_id")
  /// The billing period, e.g. "2026-08" — one batch per provider per period.
  period        String
  currency      String   @default("USD")
  invoiceTotal  Decimal  @map("invoice_total") @db.Decimal(19, 4)
  lineItemCount Int      @default(0) @map("line_item_count")
  ingestedAt    DateTime @default(now()) @map("ingested_at")

  lineItems CostLineItem[]

  @@unique([providerId, period])
  @@map("cost_ingestion_batches")
}

model CostLineItem {
  id          String  @id @default(cuid())
  batchId     String  @map("batch_id")
  /// The provider's own line identifier from the billing export — kept
  /// only for traceability; uniqueness within a batch is not required
  /// since a replace-on-reingest batch is deleted and recreated whole.
  sourceLineId String @map("source_line_id")
  description String
  amount      Decimal @db.Decimal(19, 4)
  /// M27 — the single resource this line item bills, when the export
  /// says one. Null for genuinely shared or unattributable lines; not a
  /// "0 means unattributed" convention, an actual absent value.
  resourceId  String? @map("resource_id")
  /// M27 — set instead of `resourceId` when this line item is a SHARED
  /// cost the provider billed once for several resources (e.g. a
  /// shared load balancer). Split evenly across these, in whole cents,
  /// with any remainder cent assigned to the first resource in the list
  /// so the split always sums back to the line item's own amount exactly.
  sharedResourceIds Json?  @map("shared_resource_ids")

  batch CostIngestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("cost_line_items")
}

// ── M29 · budgets, forecasts and quota binding ──

/// A budget threshold for one tenant/period. `enforcementResourceId` +
/// `enforcementDesiredState`, when both set, are what a crossed budget
/// executes AS A PLAN through M09/M12 — never a direct write. Null means
/// "alert only," a deliberately valid, common configuration.
model BudgetPolicy {
  id                      String   @id @default(cuid())
  tenantId                String   @map("tenant_id")
  period                  String
  thresholdAmount         Decimal  @map("threshold_amount") @db.Decimal(19, 4)
  enforcementResourceId   String?  @map("enforcement_resource_id")
  enforcementDesiredState Json?    @map("enforcement_desired_state")
  createdAt               DateTime @default(now()) @map("created_at")

  @@unique([tenantId, period])
  @@map("budget_policies")
}

/// M30 — a provider's OWN reported consumption for one tenant/metric/
/// period, independent of anything UniERP itself counted. Reconciliation
/// compares this against C14's MeteringEvent sum for the same
/// tenant/metric/period — two genuinely independent sources of truth for
/// the same real-world quantity, not a self-consistency check against
/// our own snapshot (that is what C14's own `reconcile()` already does).
model ProviderConsumptionReport {
  id                String   @id @default(cuid())
  providerId        String   @map("provider_id")
  tenantId          String   @map("tenant_id")
  metric            String
  period            String
  reportedQuantity  Int      @map("reported_quantity")
  reportedAt        DateTime @default(now()) @map("reported_at")

  @@unique([providerId, tenantId, metric, period])
  @@map("provider_consumption_reports")
}

/// M31 — a FinOps recommendation is never advice-only: it always carries
/// a `recommendedDesiredState`, the exact M07 desired-state change
/// executing it means, and a `predictedSaving` sourced from M25's real
/// ingested cost, never an estimate typed in free text. `actualSaving`/
/// `variance` are filled in only after execution AND a follow-up cost
/// measurement — the "measured afterwards, difference shown" half.
model FinOpsRecommendation {
  id                     String    @id @default(cuid())
  resourceId             String    @map("resource_id")
  kind                   String    // IDLE | ORPHANED | OVER_PROVISIONED | UNATTRIBUTED
  costBefore             Decimal   @map("cost_before") @db.Decimal(19, 4)
  predictedSaving        Decimal   @map("predicted_saving") @db.Decimal(19, 4)
  recommendedDesiredState Json     @map("recommended_desired_state")
  status                 String    @default("PENDING") // PENDING | EXECUTED
  executedAt             DateTime? @map("executed_at")
  actualCostAfter        Decimal?  @map("actual_cost_after") @db.Decimal(19, 4)
  actualSaving           Decimal?  @map("actual_saving") @db.Decimal(19, 4)
  variance               Decimal?  @db.Decimal(19, 4)
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([resourceId])
  @@map("finops_recommendations")
}

// ── M32 · staff identity, SSO, MFA and session governance ──

/// A completed step-up MFA challenge for one operator, presented as a
/// short-lived token on the destructive request itself. Consumed once:
/// `usedAt` set on first successful check, so a token cannot be replayed
/// across two separate destructive calls.
model StepUpMfaVerification {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  token       String    @unique
  verifiedAt  DateTime  @default(now()) @map("verified_at")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")

  @@map("step_up_mfa_verifications")
}

/// A just-in-time privilege grant with a hard expiry. Audited on BOTH
/// grant and expiry — `expiredAuditedAt` is set the first time
/// `isElevated()`/`expireDue()` discovers the grant has passed its
/// `expiresAt`, so the expiry audit fires exactly once, not on every
/// subsequent check.
model PrivilegeElevation {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  privilege        String
  grantedBy        String    @map("granted_by")
  grantedAt        DateTime  @default(now()) @map("granted_at")
  expiresAt        DateTime  @map("expires_at")
  expiredAuditedAt DateTime? @map("expired_audited_at")

  @@index([userId, privilege])
  @@map("privilege_elevations")
}

// ── M35 · incidents, SLO/SLA, error budgets and on-call ──

model SloDefinition {
  id             String   @id @default(cuid())
  service        String
  tenantId       String?  @map("tenant_id")
  targetPercent  Float    @map("target_percent") // e.g. 99.9
  /// The tenant's monthly fee this SLO's credits are computed against —
  /// Decimal(19,4), never a Float, consistent with M25/M27's own money
  /// discipline.
  monthlyFee     Decimal  @map("monthly_fee") @db.Decimal(19, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  incidents Incident[]

  @@map("slo_definitions")
}

model Incident {
  id              String    @id @default(cuid())
  sloDefinitionId String    @map("slo_definition_id")
  tenantId        String    @map("tenant_id")
  severity        String    // MINOR | MAJOR | CRITICAL
  status          String    @default("OPEN") // OPEN | RESOLVED
  actualPercent   Float     @map("actual_percent")
  creditAmount    Decimal   @map("credit_amount") @db.Decimal(19, 4)
  invoiceAdjustmentId String? @map("invoice_adjustment_id")
  openedAt        DateTime  @default(now()) @map("opened_at")
  resolvedAt      DateTime? @map("resolved_at")

  slo SloDefinition @relation(fields: [sloDefinitionId], references: [id])

  @@map("incidents")
}
