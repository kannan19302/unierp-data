// ─────────────────────────────────────────────────
// Resource model — Track M (Provider Admin OS), M07.
//
// Platform-owned, not tenant-owned: same precedent as the provider-registry
// models. Every resource the platform manages — compute, DNS zones, storage
// buckets, whatever a later stage provisions — is declared here once, with
// its desired state, its last observed actual state, its dependency edges,
// and any detected drift between the two.
// ─────────────────────────────────────────────────

model ResourceKind {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  resources Resource[]

  @@map("resource_kinds")
}

model Resource {
  id           String   @id @default(cuid())
  kindId       String   @map("kind_id")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  kind ResourceKind @relation(fields: [kindId], references: [id])

  desiredState DesiredState?
  observedState ObservedState?
  driftRecords DriftRecord[]

  /// Edges where THIS resource depends on another.
  dependsOn    Dependency[] @relation("DependentResource")
  /// Edges where another resource depends on THIS one — read before delete.
  dependedOnBy Dependency[] @relation("DependencyResource")

  @@map("resources")
}

/// The single current desired state per resource, versioned so M14 can build
/// rollback on top without this phase needing to keep full history itself.
model DesiredState {
  id         String   @id @default(cuid())
  resourceId String   @unique @map("resource_id")
  state      Json
  version    Int      @default(1)
  setAt      DateTime @default(now()) @map("set_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("desired_states")
}

/// M14 — full history DesiredState itself never kept. Every version a
/// resource's desired state has ever held, so "roll back to any prior
/// version" has something to roll back TO. A rollback does not resurrect a
/// row here; it reads one and submits its state as a NEW plan through the
/// same pipeline every other change goes through — version-control
/// semantics, not a special-cased bypass.
model DesiredStateVersion {
  id         String   @id @default(cuid())
  resourceId String   @map("resource_id")
  version    Int
  state      Json
  setAt      DateTime @default(now()) @map("set_at")

  @@unique([resourceId, version])
  @@index([resourceId])
  @@map("desired_state_versions")
}

/// The last known ACTUAL state, as reported by whatever observes the real
/// resource — a probe, a webhook, a reconciliation sweep. Overwritten on
/// each report; DriftRecord is what preserves history of divergence.
model ObservedState {
  id         String   @id @default(cuid())
  resourceId String   @unique @map("resource_id")
  state      Json
  observedAt DateTime @default(now()) @map("observed_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("observed_states")
}

/// A directed edge: `resourceId` depends on `dependsOnId`. The dependency
/// GRAPH refuses a cycle at insert time — enforced in code, not by this
/// table's own constraints, since Postgres cannot express "no cycle" as a
/// column-level check.
model Dependency {
  id          String @id @default(cuid())
  resourceId  String @map("resource_id")
  dependsOnId String @map("depends_on_id")

  resource  Resource @relation("DependentResource", fields: [resourceId], references: [id], onDelete: Cascade)
  dependsOn Resource @relation("DependencyResource", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([resourceId, dependsOnId])
  @@index([dependsOnId])
  @@map("dependencies")
}

/// One detected divergence between desired and observed state. Append-only:
/// resolving drift (by reconciliation or by accepting the new actual state
/// as desired) marks a record resolved rather than deleting it, so drift
/// history survives.
model DriftRecord {
  id         String   @id @default(cuid())
  resourceId String   @map("resource_id")
  detectedAt DateTime @default(now()) @map("detected_at")
  /// Field-level diff: [{ field, desiredValue, observedValue }, ...]
  diff       Json
  resolved   Boolean  @default(false)
  resolvedAt DateTime? @map("resolved_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, resolved])
  @@map("drift_records")
}

/// M18 — the ONE attribution mapping resource, service and environment
/// ownership hangs off. A resource with no row here (or one missing any of
/// the four fields) is unattributed — read via `age` against
/// `Resource.createdAt`, never hidden by omission. M27 (cost allocation)
/// reads this same table rather than building its own tenant/resource map.
model ResourceAttribution {
  id          String   @id @default(cuid())
  resourceId  String   @unique @map("resource_id")
  tenantId    String?  @map("tenant_id")
  service     String?
  environment String?
  owner       String?
  attributedAt DateTime @default(now()) @map("attributed_at")
  attributedBy String  @map("attributed_by")

  @@map("resource_attributions")
}

/// M24 — a real, timestamped capacity reading for one resource/metric
/// pair (e.g. cpu_utilization on a compute-instance). The capacity
/// forecaster reads a SERIES of these, never a single synthetic number —
/// "checked against a real historical shortfall" means the trend the
/// model projects from is exactly what got recorded here over time.
model CapacityObservation {
  id         String   @id @default(cuid())
  resourceId String   @map("resource_id")
  metric     String
  value      Float
  capacity   Float
  observedAt DateTime @map("observed_at")

  @@index([resourceId, metric, observedAt])
  @@map("capacity_observations")
}

/// M26 — a single telemetry reading. `getUtilization()` reads the most
/// recent row for a resource/metric; whether that row is "fresh enough"
/// is a property of the CALLER's clock at read time versus this row's
/// observedAt, never baked into the row itself.
model TelemetrySample {
  id         String   @id @default(cuid())
  resourceId String   @map("resource_id")
  metric     String
  value      Float
  observedAt DateTime @map("observed_at")

  @@index([resourceId, metric, observedAt])
  @@map("telemetry_samples")
}

/// M33 — an attribute-scoped grant over the estate, independent of C02's
/// RBAC permission registry: no `platform.*` (or any other) RBAC
/// wildcard is ever consulted by EstateAbacService, so a role's general
/// permissions can never satisfy an estate-scoped check. Every non-null
/// field on a grant NARROWS it — a grant with `region` set only matches
/// resources whose actual region equals it; a resource in a different
/// region provably does not match, not "matches but gets filtered."
model EstateGrant {
  id          String   @id @default(cuid())
  subjectId   String   @map("subject_id")
  capability  String   // "read" | "plan"
  resourceKind String? @map("resource_kind")
  region      String?
  environment String?
  tenantId    String?  @map("tenant_id")
  accountId   String?  @map("account_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([subjectId, capability])
  @@map("estate_grants")
}

// ── M36 · backup, restore, DR and failover ──
//
// Platform-owned, resource-scoped — architecturally distinct from C22's
// tenant migration (which operates on Tenant/SaasMultiTenantCluster/
// UsageRecord, moving a TENANT between clusters). This models backup
// objectives and rehearsal HISTORY for one M07 Resource; a "restore" is
// a plan against that resource's desired state, never a tenant-level
// data move.

model BackupPolicy {
  id                 String   @id @default(cuid())
  resourceId         String   @unique @map("resource_id")
  rpoObjectiveMinutes Int     @map("rpo_objective_minutes")
  rtoObjectiveMinutes Int     @map("rto_objective_minutes")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("backup_policies")
}

/// One rehearsed restore's MEASURED numbers against the policy's
/// objective — "measured rather than declared." `passed` is false the
/// instant either measurement exceeds its objective; a miss is recorded
/// as a failure here, never silently averaged away.
model RestoreRehearsal {
  id                  String   @id @default(cuid())
  resourceId          String   @map("resource_id")
  measuredRpoMinutes  Int      @map("measured_rpo_minutes")
  measuredRtoMinutes  Int      @map("measured_rto_minutes")
  rpoObjectiveMinutes Int      @map("rpo_objective_minutes")
  rtoObjectiveMinutes Int      @map("rto_objective_minutes")
  passed              Boolean
  reconciled          Boolean
  rehearsedAt         DateTime @default(now()) @map("rehearsed_at")

  @@map("restore_rehearsals")
}

/// One rehearsed region failover, and (once complete) its failback —
/// "a region failover is rehearsed with a PROVEN failback": `failbackAt`
/// and `failbackVerified` are null/false until a second, separate call
/// actually reverts the resource's region and confirms it.
model FailoverRehearsal {
  id               String    @id @default(cuid())
  resourceId       String    @map("resource_id")
  fromRegion       String    @map("from_region")
  toRegion         String    @map("to_region")
  failedOverAt     DateTime  @default(now()) @map("failed_over_at")
  failbackAt       DateTime? @map("failback_at")
  failbackVerified Boolean   @default(false) @map("failback_verified")

  @@map("failover_rehearsals")
}
