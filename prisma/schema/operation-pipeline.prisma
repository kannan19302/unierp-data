// ─────────────────────────────────────────────────
// Operation pipeline scheduling — Track M (Provider Admin OS), M11.
// Platform-owned, no tenantId/RLS, same precedent as every other Track M
// model.
// ─────────────────────────────────────────────────

model BlackoutPeriod {
  id        String   @id @default(cuid())
  reason    String
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([startTime, endTime])
  @@map("blackout_periods")
}

// ── M12 · durable execution ──
//
// A Job is the durable record of one plan's execution: its steps, and each
// step's own state. `stepIndex` advances ONLY after a step's write commits,
// so a process killed mid-step leaves stepIndex pointing at the last
// COMPLETED step, never a partially-applied one — that is the entire
// mechanism "resumes without repeating a completed step" rests on.

model Job {
  id          String   @id @default(cuid())
  planId      String?  @map("plan_id")
  resourceId  String?  @map("resource_id")
  /// M34 — the SAME correlation id ControlPlaneAuditInterceptor already
  /// generates/reads (`x-correlation-id`) for the console request that
  /// triggered this job, when the caller threads it through. Folded into
  /// every one of this job's own pipeline-step audit records, so a single
  /// query by this id returns the console click and every provider call
  /// it led to, in order — one correlated view, no second trace store.
  correlationId String? @map("correlation_id")
  /// PENDING | RUNNING | DONE | FAILED | HALTED | COMPENSATED
  status      String   @default("PENDING")
  /// Index of the next step to run. Steps [0, stepIndex) are DONE.
  stepIndex   Int      @default(0) @map("step_index")
  steps       Json     // [{ name, status, result?, error? }, ...]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("jobs")
}

// ── M15 · bulk operations ──
//
// A BulkOperation applies one plan-shaped action across many resources, one
// item at a time, committing each item's outcome before moving to the next
// — the same "advance the cursor only after a durable write" invariant M12's
// Job uses, so a bulk run over 500 resources survives a crash mid-way and
// resumes at the first unprocessed item rather than repeating or skipping.
// Per-item outcomes are never collapsed into a single pass/fail: a partial
// failure names exactly which resourceId failed and why.

// Named PlatformBulkOperation, not BulkOperation: that name is already
// taken by the tenant-scoped ERP model in core-part-5.prisma (bulk edits
// over business records, with tenantId/RLS). This one is platform-owned,
// no tenantId, same precedent as every other Track M model — it bulk-plans
// over Resources (M07), not tenant business data.
model PlatformBulkOperation {
  id          String   @id @default(cuid())
  kind        String   @map("kind")
  /// PENDING | RUNNING | DONE | FAILED (FAILED = at least one item failed; still DONE-terminal)
  status      String   @default("PENDING")
  /// Index of the next resourceId to process. items[0, cursor) are settled.
  cursor      Int      @default(0)
  items       Json     // [{ resourceId, status: PENDING|SUCCESS|FAILED, error? }, ...]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("platform_bulk_operations")
}

/// A plan scheduled for future (or recurring) execution. `approvalId`, when
/// set, points at the ControlPlaneApproval (C04's own model) this
/// destructive plan required — the same table, not a second one.
model ScheduledOperation {
  id            String    @id @default(cuid())
  planId        String    @map("plan_id")
  resourceId    String    @map("resource_id")
  scheduledFor  DateTime  @map("scheduled_for")
  /// Cron-style recurrence, null for a one-off.
  recurrence    String?
  approvalId    String?   @map("approval_id")
  status        String    @default("SCHEDULED") // SCHEDULED | EXECUTED | CANCELLED
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([scheduledFor, status])
  @@map("scheduled_operations")
}
