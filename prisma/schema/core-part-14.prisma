  pageNumber Int      @default(1) @map("page_number")
  x          Float    @default(0)
  y          Float    @default(0)
  width      Float    @default(0)
  height     Float    @default(0)
  type       String   @default("HIGHLIGHT") // HIGHLIGHT, COMMENT, STRIKETHROUGH, UNDERLINE, DRAWING, STICKY_NOTE
  content    String?
  color      String?  @default("#FFEB3B")
