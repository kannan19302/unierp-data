model DeploymentStage {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  deploymentId String   @map("deployment_id")
  name         String
  status       String   @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED, SKIPPED
  sequence     Int      @default(0)
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  duration     Int?     // seconds
  logOutput    String?  @map("log_output") @db.Text
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  deployment Deployment @relation("DeploymentStages", fields: [deploymentId], references: [id], onDelete: Cascade)
  // P6: `environmentsForDeployment` removed. It was the back-reference for
  // `Deployment.environmentId -> DeploymentStage`, which was simply the wrong
  // target — a deployment's environment is an Environment, not one of its own
  // stages. `Deployment.environmentId` now points at `Environment`.

  @@index([tenantId])
  @@index([deploymentId])
  @@map("deployment_stages")
}

model Environment {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  name             String
  slug             String
  type             String   @default("DEVELOPMENT") // DEVELOPMENT, STAGING, PRODUCTION, DR
  application      String?
  baseUrl          String?  @map("base_url")
  healthUrl        String?  @map("health_url")
  region           String?
  cluster          String?
  namespace        String?
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE, DEGRADED
  configVersion    Int      @default(1) @map("config_version")
  lastDeployAt     DateTime? @map("last_deploy_at")
  lastHealthCheckAt DateTime? @map("last_health_check_at")
  healthStatus     String?  @map("health_status")
  monitoringEnabled Boolean  @default(true) @map("monitoring_enabled")
  autoDeployEnabled Boolean  @default(false) @map("auto_deploy_enabled")
  metadata         Json     @default("{}")
  /// P6 — absorbs `BuilderEnvironment.settings` so the two environment models
  /// can be merged. `BuilderEnvironment` is dropped in P8.
  settings         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  configs      EnvironmentConfig[]
  deployments  Deployment[]
  releases     Release[]
  developerBindings EnvironmentBinding[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("environments")
}

model EnvironmentConfig {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  environmentId String   @map("environment_id")
  key           String
  value         String   @db.Text
  valueType     String   @default("STRING") // STRING, NUMBER, BOOLEAN, JSON, SECRET
  isSecret      Boolean  @default(false) @map("is_secret")
  description   String?
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, environmentId, key])
  @@index([tenantId])
  @@map("environment_configs")
}

model Release {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  name           String
  version        String
  application    String
  description    String?  @db.Text
  releaseType    String   @default("STANDARD") // STANDARD, HOTFIX, EMERGENCY, MAJOR, MINOR, PATCH
  environmentId  String?  @map("environment_id")
  status         String   @default("DRAFT") // DRAFT, BUILDING, TESTING, APPROVED, RELEASED, ROLLED_BACK, FAILED
  releaseNotes   String?  @map("release_notes") @db.Text
  changelog      Json     @default("[]")
  approvedBy     String?  @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  releasedBy     String?  @map("released_by")
  releasedAt     DateTime? @map("released_at")
  branch         String?
  commitSha      String?  @map("commit_sha")
  tag            String?
  isRollback     Boolean  @default(false) @map("is_rollback")
  rollbackFrom   String?  @map("rollback_from")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  environment Environment? @relation(fields: [environmentId], references: [id])
  artifacts   ReleaseArtifact[]

  @@index([tenantId])
  @@index([tenantId, application, version])
  @@index([tenantId, status])
  @@map("releases")
}

model ReleaseArtifact {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  releaseId    String   @map("release_id")
  deploymentId String?  @map("deployment_id")
  name         String
  fileType     String   @map("file_type") // DOCKER_IMAGE, JAR, ZIP, JS_BUNDLE, DB_MIGRATION, CONFIG
  fileUrl      String?  @map("file_url")
  fileHash     String?  @map("file_hash")
  fileSize     Int?     @map("file_size")
  dockerTag    String?  @map("docker_tag")
  dockerImage  String?  @map("docker_image")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  release    Release    @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  deployment Deployment? @relation(fields: [deploymentId], references: [id])

  @@index([tenantId])
  @@index([releaseId])
  @@map("release_artifacts")
}

model BuildLog {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
