model BudgetScenario {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  orgId        String   @map("org_id")
  name         String
  description  String?
  type         String   @default("BASE") // BASE, UPSIDE, DOWNSIDE, ACTUALS, CUSTOM
  fiscalYear   Int      @map("fiscal_year")
  isLocked     Boolean  @default(false) @map("is_locked")
  isDefault    Boolean  @default(false) @map("is_default")
  clonedFromId String?  @map("cloned_from_id")
  status       String   @default("DRAFT") // DRAFT, APPROVED, ARCHIVED
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String   @map("created_by")
  updatedBy    String   @map("updated_by")

  lines      BudgetScenarioLine[]
  clonedFrom BudgetScenario?      @relation("BudgetScenarioClones", fields: [clonedFromId], references: [id])
  clones     BudgetScenario[]     @relation("BudgetScenarioClones")

  @@index([tenantId, orgId, fiscalYear])
  @@map("budget_scenarios")
}

model BudgetScenarioLine {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  scenarioId   String   @map("scenario_id")
  accountId    String   @map("account_id")
  costCenterId String?  @map("cost_center_id")
  month        Int // 1-12
  amount       Decimal  @db.Decimal(15, 2)
  driverType   String?  @map("driver_type") // HEADCOUNT, UNITS, PERCENTAGE, MANUAL
  driverValue  Decimal? @map("driver_value") @db.Decimal(15, 4) // e.g. headcount count
  driverRate   Decimal? @map("driver_rate") @db.Decimal(15, 4) // e.g. salary per head
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  scenario BudgetScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scenarioId, accountId, month])
  @@index([tenantId, scenarioId])
  @@map("budget_scenario_lines")
}

