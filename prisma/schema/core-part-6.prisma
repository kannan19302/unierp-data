model VendorRmaRequest {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  orgId            String    @map("org_id")
  rmaNumber        String    @map("rma_number")
  purchaseReturnId String    @map("purchase_return_id")
  vendorId         String    @map("vendor_id")
  reasonCodeId     String?   @map("reason_code_id")
  status           String    @default("PENDING")
  // PENDING → SUBMITTED → AUTHORIZED → REJECTED → COMPLETED
  vendorRmaRef     String?   @map("vendor_rma_ref") // vendor-assigned RMA#
  requestedAt      DateTime  @default(now()) @map("requested_at")
  submittedAt      DateTime? @map("submitted_at")
  authorizedAt     DateTime? @map("authorized_at")
  rejectedAt       DateTime? @map("rejected_at")
  rejectionReason  String?   @map("rejection_reason")
  notes            String?
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  vendor       Vendor                 @relation(fields: [vendorId], references: [id])
  organization Organization           @relation(fields: [orgId], references: [id])
  reasonCode   ReturnReasonCode?      @relation(fields: [reasonCodeId], references: [id])
  shipments    VendorReturnShipment[]

  @@unique([tenantId, rmaNumber])
  @@index([tenantId])
  @@index([tenantId, purchaseReturnId])
  @@map("vendor_rma_requests")
}

model VendorReturnShipment {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  rmaRequestId   String    @map("rma_request_id")
  warehouseId    String    @map("warehouse_id")
  shipmentNumber String    @map("shipment_number")
  carrier        String?
  trackingNumber String?   @map("tracking_number")
  status         String    @default("PENDING")
  // PENDING → PACKED → SHIPPED → DELIVERED → LOST
