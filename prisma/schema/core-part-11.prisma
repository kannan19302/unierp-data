model AnalyticsKpiDefinition {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  name            String
  code            String
  description     String?
  formula         String   // e.g. "SUM(revenue) / COUNT(orders)"
  target          Float?
  unit            String?  // %, $, count, days
  visualization   String   @default("NUMBER") // NUMBER, GAUGE, BAR, LINE, PIE
  category        String?
  sourceTable     String?  // e.g. "invoices", "orders"
  sourceColumn    String?
  isActive        Boolean  @default(true) @map("is_active")
  config          Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  trendResults    AnalyticsTrendResult[]
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, category])
  @@map("analytics_kpi_definitions")
}

model AnalyticsTrendResult {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  kpiDefinitionId String   @map("kpi_definition_id")
  period          String   // MONTHLY, QUARTERLY, YEARLY
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  value           Float
  previousValue   Float?
  changePercent   Float?
  trend           String?  // UP, DOWN, FLAT
  metadata        Json?
  computedAt      DateTime @default(now()) @map("computed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  kpiDefinition AnalyticsKpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)

  @@unique([kpiDefinitionId, period, periodStart, periodEnd])
  @@index([tenantId])
  @@index([kpiDefinitionId])
  @@index([periodStart, periodEnd])
  @@map("analytics_trend_results")
}

