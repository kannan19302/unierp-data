  @@map("analytics_cross_filter_dashboards")
}

model AnalyticsBiMetricDefinition {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  name            String
  code            String
  description     String?
  sourceTable     String   // schema.table_name
  sourceColumn    String   // column_name
