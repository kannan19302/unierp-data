model DriveFolder {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  parentId    String?   @map("parent_id")
  ownerId     String    @map("owner_id")
  description String?
  color       String?
  icon        String?
  isStarred   Boolean   @default(false) @map("is_starred")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  path        String?
  size        BigInt    @default(0)
  fileCount   Int       @default(0) @map("file_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent      DriveFolder?            @relation("DriveFolderTree", fields: [parentId], references: [id])
  children    DriveFolder[]           @relation("DriveFolderTree")
  permissions DriveFolderPermission[]
  files       DriveFile[]
  activities  DriveActivity[]
  shares      DriveFolderShare[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([parentId])
  @@index([tenantId, isDeleted])
  @@index([tenantId, isStarred])
  @@map("drive_folders")
}

model DriveFolderPermission {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  folderId  String   @map("folder_id")
  userId    String   @map("user_id")
  role      String   @default("VIEWER")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  folder DriveFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([folderId])
  @@index([userId])
  @@map("drive_folder_permissions")
}

model DriveFile {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  folderId       String?   @map("folder_id")
  name           String
  mimeType       String    @map("mime_type")
  extension      String?
  size           BigInt    @default(0)
  storagePath    String    @map("storage_path")
  checksum       String?
  ownerId        String    @map("owner_id")
  description    String?
  isStarred      Boolean   @default(false) @map("is_starred")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  currentVersion Int       @default(1) @map("current_version")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  folder     DriveFolder?       @relation(fields: [folderId], references: [id])
  versions   DriveFileVersion[]
  comments   DriveFileComment[]
  shareLinks DriveShareLink[]
  activities DriveActivity[]
  tagMappings DriveFileTagMapping[]
  trashItems  DriveTrashItem[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([folderId])
  @@index([tenantId, isDeleted])
  @@index([tenantId, isStarred])
  @@map("drive_files")
}

model DriveFileVersion {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  fileId      String   @map("file_id")
  version     Int
  size        BigInt   @default(0)
  storagePath String   @map("storage_path")
  checksum    String?
  metadata    Json?
  uploadedBy  String   @map("uploaded_by")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  file DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fileId])
  @@map("drive_file_versions")
}

model DriveFileComment {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  fileId    String   @map("file_id")
  userId    String   @map("user_id")
  content   String
  parentId  String?  @map("parent_id")
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  file    DriveFile          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  parent  DriveFileComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies DriveFileComment[] @relation("CommentReplies")

  @@index([tenantId])
  @@index([fileId])
  @@index([parentId])
  @@map("drive_file_comments")
}

model DriveShareLink {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
