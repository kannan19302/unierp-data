// Plan phase P1 — the unified id space for the developer platform's
// project-first reshape. Before this, "Apps" (`BuilderModule`) and "Sites"
// (`WebSite`) were two disjoint entities with no common parent, so a tenant's
// developer-platform home page ("apps and sites, side by side, with recents")
// had nothing to query — it would have needed a hand-merged union of two
// unrelated tables and nowhere to record which project a user opened last.
//
// `DevProject` does not replace `BuilderModule` or `WebSite` — see
// PLATFORM_ARCHITECTURE and the developer-platform reshape plan for why they
// stay separate (different permission planes, different tenancy semantics
// for `BuilderModule`'s eventual marketplace distribution). It is a thin
// identity row alongside each one, existing only so the home page, the
// recents rail and (in a later phase) the artifact-ownership registry have
// one id space to point at instead of a polymorphic (app_id | site_id) pair
// on every table that needs to reference "whichever project this belongs to".

/// One row per App or Site the tenant has. Exactly one of `appId` / `siteId`
/// is set — enforced by a hand-written CHECK constraint in this model's
/// migration (`dev_projects_kind_target_xor`), since Prisma cannot express
/// a cross-column conditional constraint.
model DevProject {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  kind        String // APP | SITE
  name        String
  slug        String
  description String?
  icon        String?
  color       String?
  status      String    @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  appId       String?   @unique @map("app_id")
  siteId      String?   @unique @map("site_id")
  archivedAt  DateTime? @map("archived_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  app  BuilderModule? @relation(fields: [appId], references: [id], onDelete: Cascade)
  site WebSite?       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  recents        DevProjectRecent[]
  ownedArtifacts BuilderArtifact[]           @relation("ArtifactOwner")
  attachments    BuilderArtifactAttachment[]
  releases       ProjectRelease[]
  installations  ProjectInstallation[]
  validationRuns ProjectValidationRun[]
  testRuns       ProjectTestRun[]
  releaseApprovals ProjectReleaseApproval[]
  previewSessions ProjectPreviewSession[]
  auditEvents     DeveloperAuditEvent[]
  environmentBindings EnvironmentBinding[]
  changeSets ProjectChangeSet[]

  @@unique([tenantId, kind, slug])
  @@index([tenantId, kind, status])
  @@index([tenantId, updatedAt])
  @@map("dev_projects")
}

/// Powers the developer platform home page's "recently opened" rail. One row
/// per (user, project); `lastOpenedAt` is upserted every time a user enters
/// a project's workspace.
model DevProjectRecent {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  projectId    String   @map("project_id")
  userId       String   @map("user_id")
  lastOpenedAt DateTime @default(now()) @map("last_opened_at")
  openCount    Int      @default(1) @map("open_count")

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([tenantId, userId, lastOpenedAt(sort: Desc)])
  @@map("dev_project_recents")
}

/// Plan phase P3 — the ownership plane for every authored artifact.
///
/// One row per artifact, whatever its kind. `ownerProjectId = NULL` means the
/// artifact lives in the tenant Library and belongs to no App or Site — which
/// is what finally makes `/library/*` mean "unowned" rather than the
/// tenant-wide "everything" it showed before this model existed.
///
/// `artifactId` is deliberately NOT a foreign key: it points into whichever
/// of the ~20 concrete artifact tables `artifactType` names, and Prisma has
/// no polymorphic relation. The cost is that nothing at the DB level stops an
/// `INSERT INTO builder_forms` without a matching registry row; the
/// mitigation is that all writes funnel through `ArtifactRegistryService` and
/// a reconciler reports orphans. That trade is taken knowingly — the
/// alternative (an `owner_project_id` column on all ~20 tables) means 20
/// migrations, 20 backfills, and 20 chances to forget one, and still leaves
/// the home screen and Library browse doing a 20-way union to paginate.
///
/// The display fields (name/slug/status/icon/updatedAt) are DENORMALISED from
/// the concrete row so those screens need no hydration at all in the common
/// case. They are a cache, never the source of truth.
model BuilderArtifact {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  artifactType   String    @map("artifact_type")
  artifactId     String    @map("artifact_id")
  ownerProjectId String?   @map("owner_project_id")
  name           String
  slug           String?
  status         String    @default("DRAFT")
  icon           String?
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  owner       DevProject?                 @relation("ArtifactOwner", fields: [ownerProjectId], references: [id], onDelete: SetNull)
  attachments BuilderArtifactAttachment[]
  revisions   ArtifactRevision[]
  dependencyTargets ArtifactDependency[] @relation("ArtifactDependencyTarget")
  packageItems DevPackageItem[]
  overlays ArtifactOverlay[]

  @@unique([tenantId, artifactType, artifactId])
  @@index([tenantId, ownerProjectId, artifactType])
  @@index([tenantId, artifactType, updatedAt(sort: Desc)])
  @@map("builder_artifacts")
}

/// Reviewable, hash-pinned pro-code changeset. This is platform-native and
/// can later be mapped to a Git branch/PR without making Git the source of
/// truth for tenant authorization or release evidence.
model ProjectChangeSet {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  projectId       String   @map("project_id")
  branch          String
  title           String
  description     String?
  bundle          Json
  bundleHash      String   @map("bundle_hash")
  baseFingerprint String   @map("base_fingerprint")
  status          String   @default("DRAFT")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  submittedAt     DateTime? @map("submitted_at")
  mergedAt        DateTime? @map("merged_at")
  mergedBy        String?  @map("merged_by")

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviews ProjectChangeSetReview[]

  @@index([tenantId, projectId, status, createdAt(sort: Desc)])
  @@map("project_change_sets")
}

model ProjectChangeSetReview {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  changeSetId String   @map("change_set_id")
  reviewerId  String   @map("reviewer_id")
  decision    String
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  changeSet ProjectChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)

  @@unique([changeSetId, reviewerId])
  @@index([tenantId, changeSetId, decision])
  @@map("project_change_set_reviews")
}

/// Control-plane assignment for the bounded runtime-cell topology. Assignment
/// is stable across deploys; relocation is an explicit, auditable operation
/// rather than a side-effect of a changed hash-ring configuration.
model RuntimeCellAssignment {
  id              String   @id @default(cuid())
  tenantId        String   @unique @map("tenant_id")
  cellId          String   @map("cell_id")
  shard           Int
  region          String
  topologyVersion String   @map("topology_version")
  status          String   @default("ACTIVE")
  relocationCount Int      @default(0) @map("relocation_count")
  assignedAt      DateTime @default(now()) @map("assigned_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  events RuntimeCellAssignmentEvent[]

  @@index([region, cellId, status])
  @@map("runtime_cell_assignments")
}

/// Tenant-scoped capacity/feature entitlement consumed by the shared project
/// governor. Values are policy data, never builder-specific forks.
model TenantDeveloperEntitlement {
  id        String   @id @default(cuid())
  tenantId  String   @unique @map("tenant_id")
  limits    Json     @default("{}")
  status    String   @default("ACTIVE")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_developer_entitlements")
}

/// Append-only control-plane evidence for placement and relocation decisions.
model RuntimeCellAssignmentEvent {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  assignmentId String   @map("assignment_id")
  action       String
  actorId      String?  @map("actor_id")
  previous     Json     @default("{}")
  target       Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  assignment RuntimeCellAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([assignmentId, createdAt(sort: Desc)])
  @@map("runtime_cell_assignment_events")
}

/// Immutable canonical source for one artifact. Mutable editor autosave may
/// advance the artifact's head, but a published package or release always
/// resolves an exact revision and content hash.
model ArtifactRevision {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  artifactId       String   @map("artifact_id")
  revision         Int
  parentRevisionId String?  @map("parent_revision_id")
  apiVersion       String   @default("unierp.dev/v1") @map("api_version")
  schemaVersion    Int      @default(1) @map("schema_version")
  source           Json
  contentHash      String   @map("content_hash")
  validationStatus String   @default("PENDING") @map("validation_status")
  validationResult Json?    @map("validation_result")
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  artifact    BuilderArtifact    @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  parent      ArtifactRevision?  @relation("ArtifactRevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  children    ArtifactRevision[] @relation("ArtifactRevisionParent")
  dependencies ArtifactDependency[]
  packageItems DevPackageItem[]
  overlays ArtifactOverlay[] @relation("OverlaySource")
  builds ArtifactBuild[]

  @@unique([artifactId, revision])
  @@unique([artifactId, contentHash])
  @@index([tenantId, artifactId, createdAt(sort: Desc)])
  @@index([parentRevisionId])
  @@map("artifact_revisions")
}

/// A typed dependency extracted deterministically from an immutable revision.
/// `targetCoordinate` is the portable package/interface coordinate;
/// `targetArtifactId` is populated only after a project installation resolves it.
model ArtifactDependency {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  sourceRevisionId String   @map("source_revision_id")
  alias             String
  targetKind        String   @map("target_kind")
  targetCoordinate  String   @map("target_coordinate")
  versionRange      String   @map("version_range")
  targetArtifactId  String?  @map("target_artifact_id")
  optional          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  sourceRevision ArtifactRevision @relation(fields: [sourceRevisionId], references: [id], onDelete: Cascade)
  targetArtifact BuilderArtifact? @relation("ArtifactDependencyTarget", fields: [targetArtifactId], references: [id], onDelete: SetNull)

  @@unique([sourceRevisionId, alias])
  @@index([tenantId, targetCoordinate])
  @@index([tenantId, targetArtifactId])
  @@map("artifact_dependencies")
}

/// Deterministic compiler output for an immutable revision. Output bytes live
/// in content-addressed object storage; this row is their verifiable index.
model ArtifactBuild {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  revisionId      String   @map("revision_id")
  compilerId      String   @map("compiler_id")
  compilerVersion String   @map("compiler_version")
  sourceHash      String   @map("source_hash")
  outputHash      String   @map("output_hash")
  status          String   @default("SUCCESS")
  diagnostics     Json     @default("[]")
  createdAt       DateTime @default(now()) @map("created_at")

  revision ArtifactRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, compilerId, compilerVersion])
  @@index([tenantId, outputHash])
  @@map("artifact_builds")
}

/// Stable distributable identity. Versions, never this row, carry content.
model DevPackage {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  namespace   String
  name        String
  description String?
  visibility  String   @default("PRIVATE")
  editability String   @default("INTERNAL")
  status      String   @default("ACTIVE")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions DevPackageVersion[]
  installations ProjectInstallation[]

  @@unique([tenantId, namespace, name])
  @@index([tenantId, visibility, status])
  @@map("dev_packages")
}

/// Public verification keys for tenant-authored packages. Private keys never
/// enter UniERP persistence; signing happens in the trusted build/CLI boundary.
model DevSigningKey {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  keyId      String    @map("key_id")
  algorithm  String    @default("Ed25519")
  publicKey  String    @map("public_key") @db.Text
  label      String
  status     String    @default("ACTIVE")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  @@unique([tenantId, keyId])
  @@index([tenantId, status])
  @@map("dev_signing_keys")
}

/// Immutable semantic package version and signed manifest.
model DevPackageVersion {
  id                   String    @id @default(cuid())
  tenantId             String    @map("tenant_id")
  packageId            String    @map("package_id")
  version              String
  manifest             Json
  contentHash          String    @map("content_hash")
  signature            String?
  requiredCapabilities Json      @default("[]") @map("required_capabilities")
  compatibility        Json      @default("{}")
  licenseExpression    String?   @map("license_expression")
  sbomDigest           String?   @map("sbom_digest")
  vulnerabilityStatus  String    @default("UNKNOWN") @map("vulnerability_status")
  vulnerabilityReport  Json      @default("[]") @map("vulnerability_report")
  status               String    @default("DRAFT")
  publishedBy          String?   @map("published_by")
  publishedAt          DateTime? @map("published_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  package       DevPackage            @relation(fields: [packageId], references: [id], onDelete: Cascade)
  items         DevPackageItem[]
  installations ProjectInstallation[]
  targetOverlays ArtifactOverlay[] @relation("OverlayTarget")
  certifications PackageCertification[]

  @@unique([packageId, version])
  @@unique([tenantId, contentHash])
  @@index([tenantId, status, publishedAt(sort: Desc)])
  @@map("dev_package_versions")
}

model DevPackageItem {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  packageVersionId String   @map("package_version_id")
  artifactId       String   @map("artifact_id")
  revisionId       String   @map("revision_id")
  exportName       String   @map("export_name")
  createdAt        DateTime @default(now()) @map("created_at")

  packageVersion DevPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  artifact       BuilderArtifact   @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  revision       ArtifactRevision  @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([packageVersionId, exportName])
  @@unique([packageVersionId, artifactId])
  @@index([tenantId, artifactId])
  @@index([revisionId])
  @@map("dev_package_items")
}

/// Certification evidence for a published package version. Marketplace
/// promotion is permitted only from a passing immutable certification.
model PackageCertification {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  packageVersionId String   @map("package_version_id")
  status           String   @default("RUNNING")
  report           Json     @default("[]")
  certifiedBy      String?  @map("certified_by")
  certifiedAt      DateTime? @map("certified_at")
  createdAt        DateTime @default(now()) @map("created_at")

  packageVersion DevPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, packageVersionId, status])
  @@map("package_certifications")
}

/// A resolved project dependency. Production always stores an exact version;
/// `requestedRange` records user intent while `lock` records deployable truth.
model ProjectInstallation {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  projectId         String    @map("project_id")
  packageId         String    @map("package_id")
  packageVersionId  String    @map("package_version_id")
  mode              String    @default("PINNED")
  requestedRange    String?   @map("requested_range")
  lock              Json
  resourceMappings  Json      @default("{}") @map("resource_mappings")
  capabilityGrants  Json      @default("[]") @map("capability_grants")
  status            String    @default("ACTIVE")
  installedBy       String?   @map("installed_by")
  installedAt       DateTime  @default(now()) @map("installed_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  removedAt         DateTime? @map("removed_at")
  deletedAt         DateTime? @map("deleted_at")

  project        DevProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  package        DevPackage        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  packageVersion DevPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)

  @@unique([projectId, packageId])
  @@index([tenantId, projectId, status])
  @@index([packageVersionId])
  @@map("project_installations")
}

/// Evidence that one exact project composition passed its release gates.
model ProjectValidationRun {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  projectId         String    @map("project_id")
  sourceFingerprint String    @map("source_fingerprint")
  status            String    @default("RUNNING")
  score             Int?
  checks            Json      @default("[]")
  evidence          Json      @default("[]")
  startedBy         String?   @map("started_by")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, sourceFingerprint, status])
  @@map("project_validation_runs")
}

/// Immutable evidence from executing project test-suite artifacts against one
/// exact source composition. Test runs are never overwritten; release gates
/// resolve them by `sourceFingerprint` so a later draft cannot borrow an old
/// passing result.
model ProjectTestRun {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  projectId         String    @map("project_id")
  sourceFingerprint String    @map("source_fingerprint")
  status            String    @default("RUNNING")
  summary           Json      @default("{}")
  evidence          Json      @default("[]")
  startedBy         String?   @map("started_by")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, sourceFingerprint, status])
  @@map("project_test_runs")
}

/// Authenticated approval evidence for a specific immutable release. The
/// deploy endpoint reads these rows; callers never provide approver IDs.
model ProjectReleaseApproval {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  projectId String   @map("project_id")
  releaseId String   @map("release_id")
  userId    String   @map("user_id")
  status    String   @default("APPROVED")
  createdAt DateTime @default(now()) @map("created_at")

  project DevProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release ProjectRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, userId])
  @@index([tenantId, projectId, releaseId, status])
  @@map("project_release_approvals")
}

/// Ephemeral, tenant-isolated preview control-plane record. The browser gets
/// the opaque token once; only its hash persists, and previews never point at
/// production release activation or secret values.
model ProjectPreviewSession {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  projectId         String    @map("project_id")
  sourceFingerprint String    @map("source_fingerprint")
  tokenHash         String    @unique @map("token_hash")
  context           Json      @default("{}")
  status            String    @default("ACTIVE")
  expiresAt         DateTime  @map("expires_at")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  revokedAt         DateTime? @map("revoked_at")

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, status, expiresAt])
  @@map("project_preview_sessions")
}

/// Append-only developer-platform audit event. Metadata contains identifiers,
/// hashes and policy outcomes only—never raw source secrets or preview tokens.
model DeveloperAuditEvent {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  projectId     String   @map("project_id")
  action        String
  actorId       String?  @map("actor_id")
  correlationId String?  @map("correlation_id")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, createdAt(sort: Desc)])
  @@index([tenantId, action, createdAt(sort: Desc)])
  @@map("developer_audit_events")
}

/// Non-secret, environment-specific reference to a vault/service binding.
model EnvironmentBinding {
  id                   String    @id @default(cuid())
  tenantId             String    @map("tenant_id")
  projectId            String    @map("project_id")
  environmentId        String    @map("environment_id")
  key                   String
  kind                  String
  reference             String
  requiredCapabilities  Json      @default("[]") @map("required_capabilities")
  status                String    @default("UNVERIFIED")
  verifiedAt            DateTime? @map("verified_at")
  createdBy             String?   @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  project     DevProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([projectId, environmentId, key])
  @@index([tenantId, environmentId, status])
  @@map("environment_bindings")
}

/// Consumer customization is separate from immutable installed source.
model ArtifactOverlay {
  id                     String   @id @default(cuid())
  tenantId               String   @map("tenant_id")
  artifactId             String   @map("artifact_id")
  sourceRevisionId       String   @map("source_revision_id")
  targetPackageVersionId String   @map("target_package_version_id")
  patch                  Json
  contentHash            String   @map("content_hash")
  conflictStatus         String   @default("CLEAN") @map("conflict_status")
  createdBy              String?  @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")

  artifact             BuilderArtifact   @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  sourceRevision       ArtifactRevision  @relation("OverlaySource", fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  targetPackageVersion DevPackageVersion @relation("OverlayTarget", fields: [targetPackageVersionId], references: [id], onDelete: Restrict)

  @@unique([artifactId, targetPackageVersionId, contentHash])
  @@index([tenantId, targetPackageVersionId])
  @@index([sourceRevisionId])
  @@map("artifact_overlays")
}

/// Many-to-many: a Library artifact published INTO one or more projects.
///
/// An owned artifact ALSO gets a row here with `isOwner = true`, so
/// "everything visible inside project X" is a single query rather than a
/// union of "owned by X" and "attached to X".
model BuilderArtifactAttachment {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  artifactId String    @map("artifact_id")
  projectId  String    @map("project_id")
  isOwner    Boolean   @default(false) @map("is_owner")
  /// Which release of the SOURCE artifact this attachment pinned. NULL =
  /// follow head. Reserved for plan phase P9; the column exists from day one
  /// so pinning does not need a second migration, but nothing writes it yet
  /// and every attachment today follows head.
  pinnedReleaseId String? @map("pinned_release_id")
  attachedBy String?   @map("attached_by")
  attachedAt DateTime  @default(now()) @map("attached_at")
  detachedAt DateTime? @map("detached_at")

  artifact BuilderArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  project  DevProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([artifactId, projectId])
  @@index([tenantId, projectId])
  @@map("builder_artifact_attachments")
}

/// Plan phase P6 — an immutable snapshot of a DevProject at a version.
///
/// Supersedes `AppRelease`, which hung off `BuilderModule` and so could only
/// ever version an App. A Site publish had nowhere to record what it
/// published. Because `DevProject` is one id space over both, this single
/// model versions either.
///
/// Deliberately NOT merged with `Release` (core-part-14): that model is the
/// platform's own CI pipeline — keyed by a free-text `application` string,
/// carrying an approval workflow and Docker artifacts that no tenant-authored
/// app has. Conflating "what a tenant authored" with "what we shipped" is the
/// exact mistake this file's split is meant to avoid; see the doc comments on
/// both.
model ProjectRelease {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  projectId     String    @map("project_id")
  version       String
  channel       String    @default("ORGANIZATION")
  releaseType   String    @default("STANDARD") @map("release_type")
  changelog     String?   @db.Text
  /// Frozen content. APP: {components, pages, dataModels, permissions,
  /// entities, relationships, meta}. SITE: {pages, menus, theme, seo,
  /// collections}.
  snapshot      Json      @default("{}")
  schemaVersion Int       @default(1) @map("schema_version")
  manifestHash  String?   @map("manifest_hash")
  signature     String?
  signingKeyId  String?   @map("signing_key_id")
  sourceFingerprint String? @map("source_fingerprint")
  policyBundleVersion String? @map("policy_bundle_version")
  testScore     Int?      @map("test_score")
  status        String    @default("DRAFT")
  publishedBy   String?   @map("published_by")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  project     DevProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments Deployment[]
  approvals ProjectReleaseApproval[]

  @@unique([projectId, version])
  @@index([tenantId, projectId, publishedAt(sort: Desc)])
  @@index([channel, status])
  @@index([tenantId, manifestHash])
  @@map("project_releases")
}

/// Plan phase P4/P8 — `builder_modules.pages`, promoted out of JSON.
///
/// The contract migration drops that column, and `builder_artifacts` is not a
/// home for it: a module page is not an authored artifact, it is a binding
/// that says "this app shows form X at slug Y". Storing it as a real row
/// keeps the exact shape the JSON held, so the legacy `/builder/modules/:id/pages`
/// routes keep returning what they always did — the point of the split is to
/// move where the data lives, not to change what callers see.
model BuilderModulePage {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  moduleId    String   @map("module_id")
  name        String
  slug        String
  /// form | list | dashboard
  type        String   @default("form")
  formId      String?  @map("form_id")
  dashboardId String?  @map("dashboard_id")
  /// The page-builder widget layout. Kept as Json because that is exactly
  /// what the module JSON stored; giving it a schema is page-builder work,
  /// not migration work, and inventing one here would risk rejecting layouts
  /// that render fine today.
  layout      Json     @default("[]")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  module BuilderModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, slug])
  @@index([tenantId, moduleId])
  @@map("builder_module_pages")
}

/// Plan phase P4/P8 — `builder_modules.dataModels`, promoted out of JSON.
///
/// Deliberately NOT folded into `BuilderDataModel` (core-part-13). That model
/// is a full custom-object definition with its own `BuilderDataField` and
/// `BuilderRelationship` tables; this is the module's own lightweight
/// `{name, fields[], relationships[]}` config. Mapping one onto the other
/// would either lose the module JSON's inline field definitions or invent
/// rows in the richer model that nothing asked for. Keeping `fields` and
/// `relationships` as Json here preserves the shape exactly, which is the
/// whole requirement: the column moves, the data does not change.
model BuilderModuleDataModel {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  moduleId      String   @map("module_id")
  name          String
  fields        Json     @default("[]")
  relationships Json     @default("[]")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  module BuilderModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([tenantId, moduleId])
  @@map("builder_module_data_models")
}
