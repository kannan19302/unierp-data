model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  orgId     String   @map("org_id")
  name      String
  code      String
  address   Json?
  type      String   @default("MAIN") // MAIN, TRANSIT, VIRTUAL, RETAIL, CONSIGNMENT
  managerId String?  @map("manager_id")
  capacity  Decimal? @db.Decimal(15, 3)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization              Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inventoryItems            InventoryItem[]
  stockLedgerEntries        StockLedgerEntry[]
  binLocations              BinLocation[]
  fixedAssets               FixedAsset[]
  cycleCountSchedules       CycleCountSchedule[]
  licensePlates             LicensePlate[]
  stockReservations         StockReservation[]
  transferApprovalRules     TransferApprovalRule[]
  pickWaves                 PickWave[]
  dockAppointments          DockAppointment[]
  consignmentStocks         ConsignmentStock[]
  demandForecastRuns        DemandForecastRun[]
  demandForecastLines       DemandForecastLine[]
  reorderSuggestions        ReorderSuggestion[]
  vendorReturnShipments     VendorReturnShipment[]
  atpRecords                AvailableToPromise[]
  customerConsignmentStocks CustomerConsignmentStock[]
  distributionPlansSource   DistributionPlan[]         @relation("SourceWarehouse")
  distributionPlansDest     DistributionPlan[]         @relation("DestWarehouse")
  subinventories            Subinventory[]

  @@unique([tenantId, orgId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model InventoryItem {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  productId     String    @map("product_id")
  warehouseId   String    @map("warehouse_id")
  quantity      Decimal   @default(0) @db.Decimal(15, 3)
  reservedQty   Decimal   @default(0) @map("reserved_qty") @db.Decimal(15, 3)
  committedQty  Decimal   @default(0) @map("committed_qty") @db.Decimal(15, 3)
  inTransitQty  Decimal   @default(0) @map("in_transit_qty") @db.Decimal(15, 3)
  reorderPoint  Decimal?  @map("reorder_point") @db.Decimal(15, 3)
  reorderQty    Decimal?  @map("reorder_qty") @db.Decimal(15, 3)
  valuationRate Decimal?  @map("valuation_rate") @db.Decimal(15, 4)
  lastCountDate DateTime? @map("last_count_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  product           Product            @relation(fields: [productId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  licensePlateItems LicensePlateItem[]
  putawayTasks      PutawayTask[]

  @@unique([tenantId, productId, warehouseId])
  @@index([tenantId])
  @@map("inventory_items")
}

model InventoryItemBin {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  productId     String   @map("product_id")
  warehouseId   String   @map("warehouse_id")
  binLocationId String   @map("bin_location_id")
  quantity      Decimal  @default(0) @db.Decimal(15, 3)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product     Product     @relation(fields: [productId], references: [id])
  binLocation BinLocation @relation(fields: [binLocationId], references: [id])

  @@unique([tenantId, productId, warehouseId, binLocationId])
  @@index([tenantId])
  @@index([binLocationId])
  @@map("inventory_item_bins")
}

model StockReservation {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  productId   String    @map("product_id")
  warehouseId String    @map("warehouse_id")
  quantity    Decimal   @db.Decimal(15, 3)
  sourceType  String    @map("source_type") // SALES_ORDER, TRANSFER, MANUAL
  sourceId    String?   @map("source_id")
  status      String    @default("ACTIVE") // ACTIVE, RELEASED, FULFILLED
  releasedAt  DateTime? @map("released_at")
  fulfilledAt DateTime? @map("fulfilled_at")
  notes       String?
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_reservations")
}

model StockTransferApproval {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  stockEntryId   String    @unique @map("stock_entry_id")
  thresholdValue Decimal   @db.Decimal(15, 2)
  entryValue     Decimal   @map("entry_value") @db.Decimal(15, 2)
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedBy    String?   @map("requested_by")
  approvedBy     String?   @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  stockEntry StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("stock_transfer_approvals")
}

model InvestmentPortfolio {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  orgId        String   @map("org_id")
  name         String
  assetClass   String   @map("asset_class") // e.g., BONDS, EQUITY, MUTUAL_FUNDS
  currentValue Decimal  @map("current_value") @db.Decimal(15, 2)
  yieldRate    Decimal? @map("yield_rate") @db.Decimal(5, 2)
  accountId    String   @map("account_id") // Asset GL Account
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([tenantId])
  @@map("investment_portfolios")
}

model StockLedgerEntry {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  productId     String   @map("product_id")
  warehouseId   String   @map("warehouse_id")
  stockEntryId  String?  @map("stock_entry_id")
  quantity      Decimal  @db.Decimal(15, 3)
  valuationRate Decimal  @default(0) @map("valuation_rate") @db.Decimal(15, 4)
  voucherType   String   @map("voucher_type") // STOCK_ENTRY, PURCHASE_RECEIPT, DELIVERY_NOTE, SALES_RETURN, PURCHASE_RETURN, WORK_ORDER, CYCLE_COUNT
  voucherId     String   @map("voucher_id")
  voucherNumber String   @default("") @map("voucher_number")
  postingDate   DateTime @default(now()) @map("posting_date")
  qtyIn         Decimal  @default(0) @map("qty_in") @db.Decimal(15, 3)
  qtyOut        Decimal  @default(0) @map("qty_out") @db.Decimal(15, 3)
  balanceQty    Decimal  @default(0) @map("balance_qty") @db.Decimal(15, 3)
  incomingRate  Decimal  @default(0) @map("incoming_rate") @db.Decimal(15, 4)
  stockValue    Decimal  @default(0) @map("stock_value") @db.Decimal(15, 2)
  batchNumber   String?  @map("batch_number")
  serialNumber  String?  @map("serial_number")
  remarks       String?
  createdAt     DateTime @default(now()) @map("created_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse  Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockEntry StockEntry? @relation(fields: [stockEntryId], references: [id])

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, postingDate])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_ledger_entries")
}

model StockEntry {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  orgId              String    @map("org_id")
  entryNumber        String    @map("entry_number")
  type               String    @default("MATERIAL_TRANSFER") // MATERIAL_RECEIPT, MATERIAL_ISSUE, MATERIAL_TRANSFER, STOCK_ADJUSTMENT, OPENING_STOCK, SCRAP
  purpose            String    @default("MATERIAL_TRANSFER")
  postingDate        DateTime  @default(now()) @map("posting_date")
  status             String    @default("DRAFT") // DRAFT, SUBMITTED, CANCELLED
  remarks            String?
  fromWarehouseId    String?   @map("from_warehouse_id")
  toWarehouseId      String?   @map("to_warehouse_id")
  referenceDoc       String?   @map("reference_doc")
  referenceType      String?   @map("reference_type")
  totalValue         Decimal   @default(0) @map("total_value") @db.Decimal(15, 2)
  submittedAt        DateTime? @map("submitted_at")
  submittedBy        String?   @map("submitted_by")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelReason       String?   @map("cancel_reason")
  createdBy          String?   @map("created_by")
  sourceCycleCountId String?   @map("source_cycle_count_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  items            StockEntryItem[]
  ledgerEntries    StockLedgerEntry[]
  originBatches    Batch[]                @relation("BatchOrigin")
  putawayTasks     PutawayTask[]
  transferApproval StockTransferApproval?

  @@unique([tenantId, orgId, entryNumber])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@map("stock_entries")
}

model StockEntryItem {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  stockEntryId    String   @map("stock_entry_id")
  productId       String   @map("product_id")
  fromWarehouseId String?  @map("from_warehouse_id")
  toWarehouseId   String?  @map("to_warehouse_id")
  fromBinId       String?  @map("from_bin_id")
  toBinId         String?  @map("to_bin_id")
  uomId           String?  @map("uom_id")
  qty             Decimal  @db.Decimal(15, 3)
  quantity        Decimal  @default(0) @db.Decimal(15, 3)
  uomQty          Decimal? @map("uom_qty") @db.Decimal(15, 3)
  valuationRate   Decimal  @default(0) @map("valuation_rate") @db.Decimal(15, 4)
  amount          Decimal  @default(0) @db.Decimal(15, 2)
  batchId         String?  @map("batch_id")
  batchNumber     String?  @map("batch_number")
  serialNo        String?  @map("serial_no")
  serialNumber    String?  @map("serial_number")
  sortOrder       Int      @default(0) @map("sort_order")

  stockEntry StockEntry     @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromBin    BinLocation?   @relation("FromBin", fields: [fromBinId], references: [id])
  toBin      BinLocation?   @relation("ToBin", fields: [toBinId], references: [id])
  uom        UnitOfMeasure? @relation(fields: [uomId], references: [id])
  batch      Batch?         @relation(fields: [batchId], references: [id])

  @@index([tenantId])
  @@index([stockEntryId])
  @@index([productId])
  @@map("stock_entry_items")
}

model InventoryValuation {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  productId     String   @map("product_id")
  warehouseId   String?  @map("warehouse_id")
  costingMethod String   @map("costing_method") // FIFO, LIFO, AVERAGE, SPECIFIC
  valuationDate DateTime @map("valuation_date")
  quantity      Decimal  @db.Decimal(15, 3)
  valuationRate Decimal  @map("valuation_rate") @db.Decimal(15, 4)
  stockValue    Decimal  @map("stock_value") @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, valuationDate])
  @@map("inventory_valuations")
}

model StockAlert {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  productId   String    @map("product_id")
  warehouseId String?   @map("warehouse_id")
  alertType   String    @map("alert_type") // LOW_STOCK, OUT_OF_STOCK, NEGATIVE_STOCK, EXPIRY_WARNING, OVERSTOCK
  severity    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  message     String
  threshold   Decimal?  @db.Decimal(15, 3)
  currentQty  Decimal?  @map("current_qty") @db.Decimal(15, 3)
  expiryDate  DateTime? @map("expiry_date")
  isRead      Boolean   @default(false) @map("is_read")
  isResolved  Boolean   @default(false) @map("is_resolved")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([tenantId, isResolved])
  @@index([tenantId, alertType])
  @@map("stock_alerts")
}

model InvestmentHolding {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  orgId         String    @map("org_id")
  securityName  String    @map("security_name")
  ticker        String?
  assetClass    String    @map("asset_class") // EQUITY, FIXED_INCOME, MONEY_MARKET, MUTUAL_FUND
  units         Decimal   @db.Decimal(15, 4)
  costBasis     Decimal   @map("cost_basis") @db.Decimal(15, 2)
  currentPrice  Decimal?  @map("current_price") @db.Decimal(15, 4)
  currentValue  Decimal?  @map("current_value") @db.Decimal(15, 2)
  unrealizedPnl Decimal?  @map("unrealized_pnl") @db.Decimal(15, 2)
  purchaseDate  DateTime  @map("purchase_date")
  maturityDate  DateTime? @map("maturity_date")
  currency      String    @default("USD")
  custodian     String?
  glAccountId   String?   @map("gl_account_id")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("investment_holdings")
}

model WarehouseShiftTemplate {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  shiftName   String   @map("shift_name")
  dayOfWeek   Int      @map("day_of_week") // 0=Sun..6=Sat
  startTime   String   @map("start_time") // HH:MM
  endTime     String   @map("end_time") // HH:MM
  headcount   Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, warehouseId])
  @@map("warehouse_shift_templates")
}

model InventoryHold {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  holdNumber   String    @map("hold_number")
  warehouseId  String    @map("warehouse_id")
  productId    String?   @map("product_id")
  batchId      String?   @map("batch_id")
  serialId     String?   @map("serial_id")
  holdType     String    @map("hold_type") // QUALITY, CUSTOMS, DAMAGE, RECALL, FINANCIAL
  reason       String
  heldQty      Decimal   @map("held_qty") @db.Decimal(15, 4)
  status       String    @default("ACTIVE") // ACTIVE, RELEASED, CANCELLED
  raisedBy     String?   @map("raised_by")
  releasedBy   String?   @map("released_by")
  releasedAt   DateTime? @map("released_at")
  releaseNotes String?   @map("release_notes")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, holdNumber])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@map("inventory_holds")
}

model WarehouseTask {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  taskNumber     String    @map("task_number")
  taskType       String    @map("task_type") // PICK | PUTAWAY | REPLENISH | BIN_TRANSFER | RECEIVE | PACK | CYCLE_COUNT
  priority       Int       @default(50) // 1-100, lower = higher priority
  status         String    @default("QUEUED") // QUEUED | ASSIGNED | IN_PROGRESS | COMPLETE | CANCELLED | FAILED
  warehouseId    String    @map("warehouse_id")
  zoneId         String?   @map("zone_id")
  sourceLocation String?   @map("source_location")
  destLocation   String?   @map("dest_location")
  productId      String?   @map("product_id")
  qty            Decimal?  @db.Decimal(15, 4)
  uom            String?
  referenceType  String?   @map("reference_type") // PICK_WAVE | ASN | PURCHASE_ORDER | MANUAL
  referenceId    String?   @map("reference_id")
  assignedTo     String?   @map("assigned_to") // userId
  assignedAt     DateTime? @map("assigned_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, taskNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, taskType, status])
  @@map("warehouse_tasks")
}

model StockoutPrediction {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  productId             String    @map("product_id")
  warehouseId           String    @map("warehouse_id")
  currentStock          Decimal   @map("current_stock") @db.Decimal(15, 4)
  avgDailyDemand        Decimal   @map("avg_daily_demand") @db.Decimal(15, 4)
  daysOfStock           Decimal   @map("days_of_stock") @db.Decimal(8, 2)
  predictedStockoutDate DateTime? @map("predicted_stockout_date")
  riskLevel             String    @map("risk_level") // LOW | MEDIUM | HIGH | CRITICAL
  recommendedAction     String?   @map("recommended_action")
  acknowledged          Boolean   @default(false)
  acknowledgedBy        String?   @map("acknowledged_by")
  acknowledgedAt        DateTime? @map("acknowledged_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, riskLevel])
  @@index([tenantId, productId])
  @@map("stockout_predictions")
}

model StockValuationPolicy {
  id            String          @id @default(cuid())
  tenantId      String          @map("tenant_id")
  productId     String?         @map("product_id")
  warehouseId   String?         @map("warehouse_id")
  method        ValuationMethod
  standardCost  Decimal?        @map("standard_cost") @db.Decimal(18, 6)
  currency      String          @default("USD")
  effectiveFrom DateTime        @default(now()) @map("effective_from")
