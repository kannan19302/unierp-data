}

model InventoryCostProfile {
  id           String        @id @default(cuid())
  tenantId     String
  productId    String
  warehouseId  String
  method       CostingMethod @default(WAC)
  standardCost Decimal?      @db.Decimal(18, 4)
  currency     String        @default("USD")
  activeFrom   DateTime      @default(now())
  notes        String?
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  costLayers InventoryCostLayer[]

  @@unique([tenantId, productId, warehouseId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@map("inventory_cost_profiles")
}

model InventoryCostLayer {
  id           String          @id @default(cuid())
  tenantId     String
  profileId    String
  receiptDate  DateTime
  receiptRef   String?
  unitCost     Decimal         @db.Decimal(18, 4)
  qtyReceived  Decimal         @db.Decimal(18, 4)
  qtyRemaining Decimal         @db.Decimal(18, 4)
  status       CostLayerStatus @default(OPEN)
  currency     String          @default("USD")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  profile InventoryCostProfile @relation(fields: [profileId], references: [id])

  @@index([tenantId])
  @@index([tenantId, profileId])
  @@index([tenantId, profileId, status])
  @@map("inventory_cost_layers")
}

model InventoryCostAdjustment {
  id               String             @id @default(cuid())
  tenantId         String
  adjustmentNumber String
  profileId        String
  adjustmentType   CostAdjustmentType
  amount           Decimal            @db.Decimal(18, 4)
  currency         String             @default("USD")
  reason           String
  adjustedById     String
  adjustedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())

  @@unique([tenantId, adjustmentNumber])
  @@index([tenantId])
  @@index([tenantId, profileId])
  @@map("inventory_cost_adjustments")
}

model WarehouseKpi {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  warehouseId           String?  @map("warehouse_id")
  kpiDate               DateTime @map("kpi_date")
  linesPicked           Int?     @map("lines_picked")
  linesPutaway          Int?     @map("lines_putaway")
  ordersShipped         Int?     @map("orders_shipped")
  ordersReceived        Int?     @map("orders_received")
  picksPerHour          Decimal? @map("picks_per_hour")
  putawayPerHour        Decimal? @map("putaway_per_hour")
  orderAccuracyPct      Decimal? @map("order_accuracy_pct")
  cycleCountAccuracyPct Decimal? @map("cycle_count_accuracy_pct")
  dockToStockMin        Decimal? @map("dock_to_stock_min")
  orderToShipMin        Decimal? @map("order_to_ship_min")
  laborUtilizationPct   Decimal? @map("labor_utilization_pct")
  laborCostPerOrder     Decimal? @map("labor_cost_per_order")
  storageUtilizationPct Decimal? @map("storage_utilization_pct")
  slotUtilizationPct    Decimal? @map("slot_utilization_pct")
  damagePct             Decimal? @map("damage_pct")
  totalLaborHours       Decimal? @map("total_labor_hours")
  activeWorkers         Int?     @map("active_workers")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([warehouseId])
  @@index([tenantId, kpiDate])
  @@index([warehouseId, kpiDate])
  @@map("warehouse_kpis")
}

model WarehouseNetworkDesign {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  name            String
  description     String?  @db.Text
  scenario        String   @default("CURRENT")
  totalCost       Decimal? @db.Decimal(19,4)   @map("total_cost")
  transportCost   Decimal? @db.Decimal(19,4)   @map("transport_cost")
  storageCost     Decimal? @db.Decimal(19,4)   @map("storage_cost")
  handlingCost    Decimal? @db.Decimal(19,4)   @map("handling_cost")
  serviceLevel    Float?   @map("service_level")
  co2Footprint    Float?   @map("co2_footprint")
  assumptions     Json?
  recommendations Json?
  status          String   @default("DRAFT")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  nodes           WarehouseNetworkNode[]
  @@index([tenantId])
  @@map("warehouse_network_designs")
}

model WarehouseNetworkNode {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  designId    String   @map("design_id")
  nodeType    String   @map("node_type")
  name        String
  location    String?
  latitude    Float?
  longitude   Float?
  isExisting  Boolean  @default(true) @map("is_existing")
  capacity    Float?
  fixedCost   Decimal? @db.Decimal(19,4)   @map("fixed_cost")
  variableCost Decimal? @db.Decimal(19,4)  @map("variable_cost")
  design      WarehouseNetworkDesign @relation(fields: [designId], references: [id])
  @@index([tenantId, designId])
  @@map("warehouse_network_nodes")
}
