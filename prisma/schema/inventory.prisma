  totalCost       Decimal         @map("total_cost") @db.Decimal(18, 4)
  runningQty      Decimal         @map("running_qty") @db.Decimal(18, 4)
  runningValue    Decimal         @map("running_value") @db.Decimal(18, 4)
  runningAvgCost  Decimal?        @map("running_avg_cost") @db.Decimal(18, 6)
  status          ValuationStatus @default(ACTIVE)
  postedAt        DateTime        @default(now()) @map("posted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, productId, warehouseId])
  @@index([transactionRef])
  @@map("stock_valuation_ledger")
}

model StockRevaluation {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  revaluationNumber String    @map("revaluation_number")
  description       String?
  revaluationDate   DateTime  @map("revaluation_date")
  status            String    @default("DRAFT") // DRAFT|POSTED|CANCELLED
  totalImpact       Decimal   @default(0) @map("total_impact") @db.Decimal(18, 4)
  currency          String    @default("USD")
  createdBy         String?   @map("created_by")
  postedAt          DateTime? @map("posted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  lines StockRevaluationLine[]

  @@unique([tenantId, revaluationNumber])
  @@index([tenantId])
  @@map("stock_revaluations")
}

model StockRevaluationLine {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  revaluationId   String   @map("revaluation_id")
  productId       String   @map("product_id")
  warehouseId     String?  @map("warehouse_id")
  currentQty      Decimal  @map("current_qty") @db.Decimal(18, 4)
  currentUnitCost Decimal  @map("current_unit_cost") @db.Decimal(18, 6)
  newUnitCost     Decimal  @map("new_unit_cost") @db.Decimal(18, 6)
  impactAmount    Decimal  @map("impact_amount") @db.Decimal(18, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  revaluation StockRevaluation @relation(fields: [revaluationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([revaluationId])
  @@map("stock_revaluation_lines")
}

enum StockTakeStatus {
  DRAFT
  IN_PROGRESS
  COUNTING
  VARIANCE_REVIEW
  APPROVED
  POSTED
  CANCELLED
}

enum StockTakeVarianceStatus {
  PENDING
  APPROVED
  REJECTED
}

model StockTake {
  id              String          @id @default(cuid())
  tenantId        String          @map("tenant_id")
  stockTakeNumber String          @map("stock_take_number")
  warehouseId     String          @map("warehouse_id")
  status          StockTakeStatus @default(DRAFT)
  countType       String          @default("FULL") @map("count_type") // FULL | ZONE | CATEGORY
  countDate       DateTime        @map("count_date")
  frozenAt        DateTime?       @map("frozen_at")
  completedAt     DateTime?       @map("completed_at")
  postedAt        DateTime?       @map("posted_at")
  notes           String?
  createdBy       String          @map("created_by")
  approvedBy      String?         @map("approved_by")
  approvedAt      DateTime?       @map("approved_at")
  postedBy        String?         @map("posted_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  sheets    CountSheet[]
  variances StockTakeVariance[]

  @@unique([tenantId, stockTakeNumber])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([status])
  @@map("stock_takes")
}

model StockTakeVariance {
  id              String                  @id @default(cuid())
  tenantId        String                  @map("tenant_id")
  stockTakeId     String                  @map("stock_take_id")
  productId       String                  @map("product_id")
  warehouseId     String                  @map("warehouse_id")
  binLocationId   String?                 @map("bin_location_id")
  systemQty       Decimal                 @map("system_qty") @db.Decimal(15, 4)
  countedQty      Decimal                 @map("counted_qty") @db.Decimal(15, 4)
  varianceQty     Decimal                 @map("variance_qty") @db.Decimal(15, 4)
  variancePct     Decimal                 @map("variance_pct") @db.Decimal(8, 4)
  unitCost        Decimal?                @map("unit_cost") @db.Decimal(15, 4)
  varianceValue   Decimal?                @map("variance_value") @db.Decimal(15, 4)
  status          StockTakeVarianceStatus @default(PENDING)
  approvedBy      String?                 @map("approved_by")
  approvedAt      DateTime?               @map("approved_at")
  rejectionReason String?                 @map("rejection_reason")
  postedLedgerId  String?                 @map("posted_ledger_id")
  createdAt       DateTime                @default(now()) @map("created_at")

  stockTake StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([stockTakeId])
  @@index([status])
  @@map("stock_take_variances")
}

model ItemBarcode {
  id               String           @id @default(cuid())
  tenantId         String           @map("tenant_id")
  packagingSpecId  String           @map("packaging_spec_id")
  symbology        BarcodeSymbology
  barcodeValue     String           @map("barcode_value")
  gtin14           String?          @map("gtin_14")
  gs1CompanyPrefix String?          @map("gs1_company_prefix")
  isPrimary        Boolean          @default(false) @map("is_primary")
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at")

  packagingSpec PackagingSpec @relation(fields: [packagingSpecId], references: [id], onDelete: Cascade)

  @@unique([tenantId, barcodeValue])
  @@index([tenantId])
  @@index([packagingSpecId])
  @@map("item_barcodes")
}

model StockWriteDownRequest {
  id                   String          @id @default(cuid())
  tenantId             String          @map("tenant_id")
  requestNumber        String          @map("request_number")
  warehouseId          String          @map("warehouse_id")
  productId            String          @map("product_id")
  batchId              String?         @map("batch_id")
  quantity             Decimal
  originalValuePerUnit Decimal         @map("original_value_per_unit")
  proposedValuePerUnit Decimal         @map("proposed_value_per_unit")
  writeDownReason      String          @map("write_down_reason")
  status               WriteDownStatus @default(DRAFT)
  requestedById        String          @map("requested_by_id")
  approvedById         String?         @map("approved_by_id")
  approvedAt           DateTime?       @map("approved_at")
  rejectionNotes       String?         @map("rejection_notes")
  appliedAt            DateTime?       @map("applied_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, requestNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("stock_write_down_requests")
}

model StockWriteOffRecord {
  id               String         @id @default(cuid())
  tenantId         String         @map("tenant_id")
  writeOffNumber   String         @map("write_off_number")
  warehouseId      String         @map("warehouse_id")
  productId        String         @map("product_id")
  batchId          String?        @map("batch_id")
  quantity         Decimal
  bookValuePerUnit Decimal        @map("book_value_per_unit")
  totalWriteOff    Decimal        @map("total_write_off")
  disposalMethod   String         @map("disposal_method")
  writeOffReason   String         @map("write_off_reason")
  status           WriteOffStatus @default(DRAFT)
  requestedById    String         @map("requested_by_id")
  approvedById     String?        @map("approved_by_id")
  approvedAt       DateTime?      @map("approved_at")
  completedAt      DateTime?      @map("completed_at")
  rejectionNotes   String?        @map("rejection_notes")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

