  isActive      Boolean         @default(true) @map("is_active")
  notes         String?
  createdBy     String?         @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, productId, warehouseId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@map("stock_valuation_policies")
}

model StockValuationLedger {
  id              String          @id @default(cuid())
  tenantId        String          @map("tenant_id")
  productId       String          @map("product_id")
  warehouseId     String?         @map("warehouse_id")
  method          ValuationMethod
  transactionType String          @map("transaction_type") // RECEIPT|ISSUE|ADJUSTMENT|REVALUATION
  transactionRef  String          @map("transaction_ref")
  qty             Decimal         @db.Decimal(18, 4)
