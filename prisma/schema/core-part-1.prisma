  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  presence       String // ACTIVE, AWAY, DND, OOO, etc.
  statusText     String?  @map("status_text")
  statusEmoji    String?  @map("status_emoji")
  startTime      DateTime @map("start_time")
  endTime        DateTime @map("end_time")
  isRecurring    Boolean  @default(false) @map("is_recurring")
  recurrenceRule String?  @map("recurrence_rule")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@index([tenantId, startTime, endTime])
  @@map("user_status_schedules")
}

model ChannelAnalytics {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  channelId    String   @map("channel_id")
  date         DateTime @map("date")
  messageCount Int      @default(0) @map("message_count")
  activeUsers  Int      @default(0) @map("active_users")
  reactions    Int      @default(0)
  threads      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channelId, date])
  @@index([tenantId, channelId])
  @@map("channel_analytics")
}

model ConnectPoll {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  channelId String   @map("channel_id")
  messageId String?  @map("message_id")
  userId    String   @map("user_id")
  question  String   @db.Text
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  options  ConnectPollOption[]
  messages Message[]
  votes    ConnectPollVote[]

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([tenantId, channelId])
  @@map("connect_polls")
}

model ConnectPollOption {
  id     String @id @default(cuid())
  pollId String @map("poll_id")
  label  String
  emoji  String @default("")

  poll  ConnectPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes ConnectPollVote[]

  @@map("connect_poll_options")
}

model ConnectPollVote {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  pollId    String   @map("poll_id")
  optionId  String   @map("option_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  option ConnectPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll   ConnectPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([tenantId, pollId])
  @@map("connect_poll_votes")
}

model CustomEmoji {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  name       String   @map("name")
  fileUrl    String   @map("file_url")
  fileSize   Int      @default(0) @map("file_size")
  uploadedBy String   @map("uploaded_by")
  category   String   @default("custom")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("custom_emojis")
}

model Reminder {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  text      String   @db.Text
  remindAt  DateTime @map("remind_at")
  channelId String?  @map("channel_id")
  messageId String?  @map("message_id")
  isSent    Boolean  @default(false) @map("is_sent")
  snoozed   Boolean  @default(false)
  recurRule String?  @map("recur_rule")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId, remindAt])
  @@index([remindAt, isSent])
  @@map("reminders")
}

model ChannelTemplate {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?  @db.Text
  channelType String   @default("PUBLIC") @map("channel_type")
  topic       String?
  emoji       String   @default("")
  tabs        Json     @default("[]")
  isPreset    Boolean  @default(true) @map("is_preset")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("channel_templates")
}

model MeetingSummary {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  meetingId   String   @map("meeting_id")
  summary     String   @db.Text
  keyPoints   Json     @default("[]") @map("key_points")
  actionItems Json     @default("[]") @map("action_items")
  generatedAt DateTime @default(now()) @map("generated_at")

  meeting ConnectMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([tenantId, meetingId])
  @@map("meeting_summaries")
}

model KnowledgeArticle {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  categoryId  String?   @map("category_id")
  title       String
  slug        String
  content     String    @db.Text
  excerpt     String?   @db.Text
  status      String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  authorId    String    @map("author_id")
  publishedAt DateTime? @map("published_at")
  viewCount   Int       @default(0) @map("view_count")
  featured    Boolean   @default(false)
  tags        Json      @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category KnowledgeCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions KnowledgeArticleVersion[]
  ratings  KnowledgeArticleRating[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("knowledge_articles")
}

model KnowledgeCategory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  parentId    String?  @map("parent_id")
  name        String
  slug        String
  description String?  @db.Text
  icon        String?  @default("BookOpen")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   KnowledgeCategory?  @relation("KnowledgeCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children KnowledgeCategory[] @relation("KnowledgeCategoryTree")
  articles KnowledgeArticle[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("knowledge_categories")
}

model KnowledgeArticleVersion {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  articleId String   @map("article_id")
  version   Int      @default(1)
  title     String
  content   String   @db.Text
  summary   String?  @db.Text
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, articleId, version])
  @@index([tenantId, articleId])
  @@map("knowledge_article_versions")
}

model KnowledgeArticleRating {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  articleId String   @map("article_id")
  userId    String   @map("user_id")
  rating    Int // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, articleId, userId])
  @@index([tenantId, articleId])
  @@map("knowledge_article_ratings")
}

model HelpdeskTicket {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  subject       String
  description   String    @db.Text
  status        String    @default("OPEN") // OPEN, PENDING, RESOLVED, CLOSED, ESCALATED
  priority      String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  source        String    @default("EMAIL") // EMAIL, CHAT, PHONE, PORTAL, SOCIAL
  category      String?   @default("GENERAL")
  assignedTo    String?   @map("assigned_to")
  customerId    String    @map("customer_id")
  customerEmail String    @map("customer_email")
  customerName  String    @map("customer_name")
  slaBreached   Boolean   @default(false) @map("sla_breached")
  escalatedAt   DateTime? @map("escalated_at")
  resolvedAt    DateTime? @map("resolved_at")
  closedAt      DateTime? @map("closed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  comments     TicketComment[]
  sla          TicketSla?
  satisfaction CustomerSatisfaction?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, priority])
  @@map("helpdesk_tickets")
}
