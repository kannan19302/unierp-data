  batchId         String?   @map("batch_id")
  paymentId       String?   @map("payment_id")
  recommendedRail String    @map("recommended_rail")
  estimatedCost   Decimal   @map("estimated_cost") @db.Decimal(10, 2)
  estimatedSpeed  Int       @map("estimated_speed")
