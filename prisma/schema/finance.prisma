  savingsAmount   Decimal?  @map("savings_amount") @db.Decimal(10, 2)
  currency        String    @default("USD")
  status          String    @default("RECOMMENDED")
  executedAt      DateTime? @map("executed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
