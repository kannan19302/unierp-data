model FinancialNlpQueryLog {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  queryText       String   @map("query_text") @db.Text
  parsedIntent    String?  @map("parsed_intent")
  generatedSql    String?  @map("generated_sql") @db.Text
  resultSummary   String?  @map("result_summary") @db.Text
  executionTimeMs Int?     @map("execution_time_ms")
  wasSuccessful   Boolean  @default(true) @map("was_successful")
  errorMessage    String?  @map("error_message") @db.Text
  userId          String?  @map("user_id")
  queriedAt       DateTime @default(now()) @map("queried_at")

  @@index([tenantId, parsedIntent])
  @@index([tenantId, queriedAt])
  @@map("financial_nlp_query_logs")
}

model AccountScore {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  customerId   String   @map("customer_id")
  score        Int      @default(0)
  factors      Json     @default("[]") // [{name: "revenue", weight: 0.3, value: 85}, ...]
  scorecard    Json     @default("{}")
  calculatedAt DateTime @default(now()) @map("calculated_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@map("account_scores")
}
