  status              String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SETTLED, CANCELLED
  reviewedBy          String?   @map("reviewed_by")
  reviewedAt          DateTime? @map("reviewed_at")
  approvedBy          String?   @map("approved_by")
  approvedAt          DateTime? @map("approved_at")
  journalId           String?   @map("journal_id")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  group       NettingGroup            @relation(fields: [groupId], references: [id])
  details     NettingRunDetail[]
  settlements SettlementInstruction[]

  @@index([tenantId])
  @@index([tenantId, groupId])
  @@map("netting_runs")
}

model NettingRunDetail {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  nettingRunId   String   @map("netting_run_id")
  fromOrgId      String   @map("from_org_id")
  toOrgId        String   @map("to_org_id")
  transactionId  String?  @map("transaction_id")
  originalAmount Decimal  @map("original_amount") @db.Decimal(18, 4)
  nettedAmount   Decimal  @map("netted_amount") @db.Decimal(18, 4)
  currency       String   @default("USD")
  baseAmount     Decimal  @map("base_amount") @db.Decimal(18, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  run NettingRun @relation(fields: [nettingRunId], references: [id], onDelete: Cascade)

  @@index([nettingRunId])
  @@map("netting_run_details")
}

model SettlementInstruction {
  id                     String    @id @default(cuid())
  tenantId               String    @map("tenant_id")
  nettingRunId           String    @map("netting_run_id")
  fromOrgId              String    @map("from_org_id")
  toOrgId                String    @map("to_org_id")
  settlementAmount       Decimal   @map("settlement_amount") @db.Decimal(18, 4)
  currency               String    @default("USD")
  settlementMethod       String    @map("settlement_method") // BANK_TRANSFER, INTERNAL_JE, CLEARING_ACCOUNT
  expectedSettlementDate DateTime? @map("expected_settlement_date")
  actualSettlementDate   DateTime? @map("actual_settlement_date")
  status                 String    @default("PENDING") // PENDING, EXECUTED, CONFIRMED, FAILED
  reference              String?
  bankAccountId          String?   @map("bank_account_id")
  confirmationRef        String?   @map("confirmation_ref")
  confirmedAt            DateTime? @map("confirmed_at")
  journalId              String?   @map("journal_id")
  errorMessage           String?   @map("error_message")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  run NettingRun @relation(fields: [nettingRunId], references: [id])

  @@index([tenantId])
  @@index([nettingRunId])
  @@index([tenantId, status])
  @@map("settlement_instructions")
}

model CustomerPortalMessage {
