model CampaignWorkflow {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  orgId       String   @map("org_id")
  campaignId  String?  @map("campaign_id")
  name        String
  description String?
  triggerType String   @map("trigger_type") // LEAD_CREATED, CONTACT_ADDED, FORM_SUBMITTED, SCHEDULED
  status      String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  steps CampaignWorkflowStep[]
  stats CampaignWorkflowStat[]

  @@index([tenantId])
  @@map("campaign_workflows")
}

model CampaignWorkflowStep {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  workflowId      String   @map("workflow_id")
  stepOrder       Int      @map("step_order")
  actionType      String   @map("action_type") // SEND_EMAIL, SEND_SMS, UPDATE_FIELD, ADD_TAG, WAIT, CONDITION, WEBHOOK
  config          Json     @default("{}") // templateId, delayDays, fieldName, etc.
  conditionConfig Json?    @map("condition_config")
  delayDays       Int      @default(0) @map("delay_days")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workflow CampaignWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workflowId])
  @@map("campaign_workflow_steps")
}

model CampaignWorkflowStat {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  workflowId   String    @map("workflow_id")
  totalEntered Int       @default(0) @map("total_entered")
  totalExited  Int       @default(0) @map("total_exited")
  converted    Int       @default(0)
  revenue      Decimal   @default(0) @db.Decimal(15, 2)
  startedAt    DateTime  @map("started_at")
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  workflow CampaignWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("campaign_workflow_stats")
}

model ABTestCampaign {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  orgId               String    @map("org_id")
  name                String
  description         String?
  variantA            Json      @map("variant_a") // {subject, body, templateId}
  variantB            Json      @map("variant_b")
  winner              String? // A, B, TIE
  sampleSize          Int       @default(1000) @map("sample_size")
  confidenceThreshold Decimal   @default(95) @map("confidence_threshold") @db.Decimal(5, 2)
  status              String    @default("DRAFT") // DRAFT, RUNNING, COMPLETED
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  results    ABTestResult[]
  campaignId String?        @map("campaign_id")

  @@index([tenantId])
  @@map("ab_test_campaigns")
}

model ABTestResult {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  testId      String   @map("test_id")
  variant     String // A, B
  sentCount   Int      @default(0) @map("sent_count")
  openCount   Int      @default(0) @map("open_count")
  clickCount  Int      @default(0) @map("click_count")
  bounceCount Int      @default(0) @map("bounce_count")
  replyCount  Int      @default(0) @map("reply_count")
  revenue     Decimal  @default(0) @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  test ABTestCampaign @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([testId])
  @@map("ab_test_results")
}

model CampaignROI {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  campaignId       String   @map("campaign_id")
  totalSpend       Decimal  @default(0) @map("total_spend") @db.Decimal(15, 2)
  totalRevenue     Decimal  @default(0) @map("total_revenue") @db.Decimal(15, 2)
  leadsGenerated   Int      @default(0) @map("leads_generated")
  opportunitiesWon Int      @default(0) @map("opportunities_won")
  roi              Decimal  @default(0) @db.Decimal(5, 2)
  cac              Decimal  @default(0) @db.Decimal(15, 2)
  periodStart      DateTime @map("period_start")
  periodEnd        DateTime @map("period_end")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, campaignId, periodStart, periodEnd])
  @@index([tenantId])
  @@map("campaign_rois")
}

model RenewalRiskPrediction {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  customerId        String    @map("customer_id")
  contractId        String?   @map("contract_id")
  riskScore         Decimal   @map("risk_score") @db.Decimal(5, 2) // 0-100
  riskLevel         String    @default("LOW") @map("risk_level") // LOW, MEDIUM, HIGH, CRITICAL
  predictedDate     DateTime? @map("predicted_date")
  confidenceScore   Decimal   @default(0) @map("confidence_score") @db.Decimal(5, 2)
  topFactors        Json?     @map("top_factors")
  recommendedAction String?   @map("recommended_action")
  modelVersion      String    @default("1.0") @map("model_version")
  predictedAt       DateTime  @default(now()) @map("predicted_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("renewal_risk_predictions")
}

model ChurnAnalysis {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  customerId  String    @map("customer_id")
  churnScore  Decimal   @map("churn_score") @db.Decimal(5, 2)
  churnReason String?   @map("churn_reason")
  churnDate   DateTime? @map("churn_date")
  segment     String? // HIGH_VALUE, LOW_VALUE, NEW, AT_RISK
  signals     Json?     @default("[]") // leading indicators
  prevented   Boolean   @default(false)
  preventedBy String?   @map("prevented_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("churn_analyses")
}

model ExpansionRevenue {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  customerId   String   @map("customer_id")
  type         String   @default("UPSELL") // UPSELL, CROSS_SELL, UPGRADE
