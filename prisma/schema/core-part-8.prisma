  subject      String
  body         String    @db.Text
  direction    String    @default("OUTBOUND") // INBOUND, OUTBOUND
  status       String    @default("SENT") // SENT, DELIVERED, READ
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  portalUser CustomerPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([portalUserId])
  @@map("customer_portal_messages")
}

model PortalDocumentAccess {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  portalUserId String    @map("portal_user_id")
  documentId   String    @map("document_id")
  grantType    String    @default("MANUAL") // MANUAL, AUTO
  grantedAt    DateTime  @default(now()) @map("granted_at")
  expiresAt    DateTime? @map("expires_at")
