model PortalActivityLog {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  portalUserId String   @map("portal_user_id")
  action       String // LOGIN, VIEW_INVOICE, VIEW_ORDER, DOWNLOAD_DOC, CREATE_TICKET
  details      Json?    @default("{}")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  portalUser CustomerPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

