// ─────────────────────────────────────────────────────────────
// Compliance controls and evidence — Track M (Provider Admin
// OS), M38. Platform-owned, no tenantId/RLS, same precedent as
// every other Track M model.
// ─────────────────────────────────────────────────────────────

/// A control in the catalogue: mapped to one or more frameworks
/// (SOC2/ISO27001/GDPR …), with a declarative evidence query that
/// is evaluated against real audit records on the M14 spine —
/// never assembled by hand. PASS/FAIL is a property of the
/// current evidence, not a stored opinion.
model ComplianceControl {
  id          String   @id @default(cuid())
  /// Stable machine code, e.g. "AUDIT-COMPLETE". Referenced by
  /// evidence exports and the console.
  code        String   @unique
  /// Comma-separated framework references, e.g. "SOC2:CC3.4".
  frameworks  String
  title       String
  description String
  /// Declarative evidence query: { model, minRecords, where? }.
  evidenceQuery Json   @map("evidence_query")
  /// AUDIT (evidence is derived from the spine) | MANUAL.
  kind        String   @default("AUDIT")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("compliance_controls")
}

/// One evaluation of one control against the audit spine at a
/// point in time — the "continuous control monitoring" trail.
/// A control is FAILING when its most recent evaluation is FAIL:
/// it is failing in the console before it is failing in an audit.
model ComplianceControlEvaluation {
  id         String   @id @default(cuid())
  controlId  String   @map("control_id")
  status     String // PASS | FAIL
  /// Records observed that satisfied the control's query.
  observed   Int
  /// Human-readable finding for a FAIL.
  finding    String?
  evaluatedAt DateTime @default(now()) @map("evaluated_at")

  @@index([controlId])
  @@index([evaluatedAt])
  @@map("compliance_control_evaluations")
}

/// An exported evidence artefact: the answer to an auditor's
/// question, generated by re-running the control's query against
/// the real audit spine and packaging the matching records. No
/// manual assembly step — the artefact rows ARE the audit rows.
model ComplianceEvidence {
  id          String   @id @default(cuid())
  controlCode String   @map("control_code")
  /// The auditor's question as asked.
  auditorQuestion String @map("auditor_question")
  /// The matching audit records (control_plane_audit_logs rows)
  /// plus generation metadata. Generated, not assembled.
  artefact    Json
  /// SHA-256 over the serialised audit rows, so an auditor can
  /// verify the artefact matches the spine it was taken from.
  contentHash String   @map("content_hash")
  generatedBy String   @map("generated_by")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([controlCode])
  @@index([generatedAt])
  @@map("compliance_evidence")
}