model BookTransaction {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  studentId    String    @map("student_id")
  bookId       String    @map("book_id")
  type         String    @default("CHECKOUT")
  dueDate      DateTime? @map("due_date")
  returnedDate DateTime? @map("returned_date")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  student EducationStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  book    EducationBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  fines   EducationLibraryFine[]

  @@index([tenantId])
  @@index([studentId])
  @@index([bookId])
  @@map("book_transactions")
}

model Grade {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  studentId  String   @map("student_id")
  courseId   String   @map("course_id")
  assessment String
  score      Decimal
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  student EducationStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  EducationCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, courseId, assessment])
  @@index([tenantId])
  @@index([studentId])
  @@index([courseId])
  @@map("education_grades")
}

model EcommerceStore {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  name              String
  slug              String
  description       String?
  logo              String?
  banner            String?
  currency          String   @default("USD")
  language          String   @default("en")
  isActive          Boolean  @default(true) @map("is_active")
  isPublished       Boolean  @default(false) @map("is_published")
  taxCalculation    String   @default("EXCLUSIVE") @map("tax_calculation") // INCLUSIVE, EXCLUSIVE
  defaultWeightUnit String   @default("kg") @map("default_weight_unit")
  maxCartItems      Int      @default(100) @map("max_cart_items")
  minOrderAmount    Decimal? @map("min_order_amount")
  maxOrderAmount    Decimal? @map("max_order_amount")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  categories     EcommerceCategory[]
  listings       EcommerceProductListing[]
  orders         EcommerceOrder[]
  coupons        EcommerceCoupon[]
  shippingZones  EcommerceShippingZone[]
  taxClasses     EcommerceTaxClass[]
  settings       EcommerceStoreSetting[]
  themes         EcommerceStoreTheme[]
  abandonedCarts EcommerceAbandonedCart[]
  wishlists      EcommerceWishlist[]
  carts          EcommerceCart[]

  @@index([tenantId])
  @@index([slug])
  @@map("ecommerce_stores")
}

model EcommerceCategory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  storeId     String   @map("store_id")
  parentId    String?  @map("parent_id")
  name        String
  slug        String
  description String?
  image       String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store    EcommerceStore            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   EcommerceCategory?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children EcommerceCategory[]       @relation("CategoryHierarchy")
  listings EcommerceProductListing[]

  @@index([tenantId])
  @@index([storeId])
  @@index([slug])
  @@index([parentId])
  @@map("ecommerce_categories")
}

model EcommerceProductListing {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  storeId          String   @map("store_id")
  productId        String   @map("product_id")
  categoryId       String?  @map("category_id")
  title            String
  slug             String
  description      String?  @db.Text
  shortDescription String?  @map("short_description")
  media            Json     @default("[]") // array of {url, type, sortOrder}
  tags             String[] @default([])
  isActive         Boolean  @default(true) @map("is_active")
  isFeatured       Boolean  @default(false) @map("is_featured")
  sortOrder        Int      @default(0) @map("sort_order")
  metaTitle        String?  @map("meta_title")
  metaDescription  String?  @map("meta_description")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  store    EcommerceStore            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category EcommerceCategory?        @relation(fields: [categoryId], references: [id])
  variants EcommerceProductVariant[]
  reviews  EcommerceReview[]

  @@index([tenantId])
  @@index([storeId])
  @@index([productId])
  @@index([categoryId])
  @@index([slug])
  @@map("ecommerce_product_listings")
}
