  complianceRisk    Decimal?  @map("compliance_risk")
  qualityRisk       Decimal?  @map("quality_risk")
  concentrationRisk Decimal?  @map("concentration_risk")
  lastAssessment    DateTime? @map("last_assessment")
  nextAssessment    DateTime? @map("next_assessment")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  factors   SupplierRiskFactor[]
  alerts    SupplierRiskAlert[]
  diversity SupplierDiversity[]

  @@index([tenantId])
  @@index([vendorId])
  @@index([tenantId, riskCategory])
  @@map("supplier_risk_profiles")
}

model SupplierRiskFactor {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  profileId   String    @map("profile_id")
  factorType  String
  factorName  String    @map("factor_name")
  score       Decimal
  weight      Decimal?  @default(1.0)
  description String?
  source      String?
  lastUpdated DateTime? @map("last_updated")
  trend       String?
  notes       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  profile SupplierRiskProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([profileId])
  @@index([factorType])
  @@map("supplier_risk_factors")
}

model SupplierRiskAlert {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  profileId      String    @map("profile_id")
  alertType      String
  severity       String    @default("MEDIUM")
  title          String
  description    String?
  status         String    @default("OPEN")
  source         String?
  sourceUrl      String?   @map("source_url")
  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  resolvedBy     String?   @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  resolution     String?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  profile SupplierRiskProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([profileId])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@map("supplier_risk_alerts")
}

model SupplierDiversity {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  profileId           String    @map("profile_id")
  diversityType       String    @map("diversity_type")
  certificationBody   String?   @map("certification_body")
  certificationNumber String?   @map("certification_number")
  certificationDate   DateTime? @map("certification_date")
  expirationDate      DateTime? @map("expiration_date")
  status              String    @default("VERIFIED")
  spendAmount         Decimal?  @map("spend_amount")
  spendCurrency       String?   @default("USD") @map("spend_currency")
  fiscalYear          Int?      @map("fiscal_year")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  profile SupplierRiskProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([profileId])
  @@index([diversityType])
  @@map("supplier_diversity_records")
}

model AlternativeSourcing {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  productId          String?  @map("product_id")
  productSku         String?  @map("product_sku")
  productName        String?  @map("product_name")
  currentVendorId    String?  @map("current_vendor_id")
  currentVendorName  String?  @map("current_vendor_name")
  altVendorId        String   @map("alt_vendor_id")
  altVendorName      String   @map("alt_vendor_name")
  recommendationType String   @map("recommendation_type")
  currentPrice       Decimal? @map("current_price")
  altPrice           Decimal? @map("alt_price")
  potentialSavings   Decimal? @map("potential_savings")
  leadTimeDays       Int?     @map("lead_time_days")
  qualityScore       Decimal? @map("quality_score")
  riskReductionScore Decimal? @map("risk_reduction_score")
  status             String   @default("RECOMMENDED")
  notes              String?
  isActive           Boolean  @default(true) @map("is_active")
  createdBy          String?  @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
