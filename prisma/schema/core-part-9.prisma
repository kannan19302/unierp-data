model ControlTowerEvent {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  eventNumber  String    @map("event_number")
  eventType    String
  severity     String    @default("MEDIUM")
  title        String
  description  String?
  category     String?
  sourceModule String?   @map("source_module")
  sourceId     String?   @map("source_id")
  sourceType   String?   @map("source_type")
  status       String    @default("OPEN")
  assignedTo   String?   @map("assigned_to")
  impactScore  Decimal?  @map("impact_score")
  resolution   String?
  resolvedBy   String?   @map("resolved_by")
  resolvedAt   DateTime? @map("resolved_at")
  autoResolved Boolean   @default(false) @map("auto_resolved")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  actions ControlTowerAction[]

  @@index([tenantId])
  @@index([eventNumber])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([eventType])
  @@index([tenantId, createdAt])
  @@map("control_tower_events")
}

model ControlTowerAction {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  eventId     String    @map("event_id")
  actionType  String
  description String?
  status      String    @default("PENDING")
  executedBy  String?   @map("executed_by")
  executedAt  DateTime? @map("executed_at")
  result      String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  event ControlTowerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventId])
  @@map("control_tower_actions")
}

model ControlTowerKpi {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  kpiCode         String   @map("kpi_code")
  kpiName         String   @map("kpi_name")
  category        String
  subcategory     String?  @map("subcategory")
  unit            String
  currentValue    Decimal? @map("current_value")
  targetValue     Decimal? @map("target_value")
  thresholdGreen  Decimal? @map("threshold_green")
  thresholdYellow Decimal? @map("threshold_yellow")
  thresholdRed    Decimal? @map("threshold_red")
  trend           String?
  period          String
  sourceQuery     String?  @map("source_query")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([kpiCode])
  @@index([tenantId, category])
  @@index([tenantId, period])
  @@map("control_tower_kpis")
}

model ControlTowerAlertConfig {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  alertName            String   @map("alert_name")
  description          String?
  eventType            String?  @map("event_type")
  kpiCode              String?  @map("kpi_code")
  condition            Json
