model NpsSurvey {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  orgId             String    @map("org_id")
  name              String
  description       String?
  question          String    @default("How likely are you to recommend us?")
  minRating         Int       @default(0) @map("min_rating")
  maxRating         Int       @default(10) @map("max_rating")
  targetSegment     String?   @map("target_segment") // ALL, SPECIFIC_CUSTOMERS, SPECIFIC_CONTACTS
  targetIds         Json?     @default("[]") @map("target_ids")
  status            String    @default("DRAFT") // DRAFT, ACTIVE, COMPLETED
  sendAutomatically Boolean   @default(false) @map("send_automatically")
  triggerEvent      String?   @map("trigger_event") // AFTER_RENEWAL, AFTER_SUPPORT_TICKET, AFTER_PURCHASE
  delayDays         Int?      @default(7) @map("delay_days")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  responses NpsResponse[]
  analytics NpsAnalytic[]

  @@index([tenantId])
  @@map("nps_surveys")
}

model NpsResponse {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  surveyId    String    @map("survey_id")
  customerId  String?   @map("customer_id")
  contactId   String?   @map("contact_id")
  rating      Int
  category    String    @default("PASSIVE") // DETRACTOR, PASSIVE, PROMOTER
  comment     String?   @db.Text
  sentAt      DateTime? @map("sent_at")
  respondedAt DateTime? @map("responded_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  survey NpsSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([surveyId])
  @@map("nps_responses")
}

model NpsAnalytic {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  surveyId       String   @map("survey_id")
  totalSent      Int      @default(0) @map("total_sent")
  totalResponses Int      @default(0) @map("total_responses")
  detractors     Int      @default(0)
  passives       Int      @default(0)
  promoters      Int      @default(0)
  npsScore       Decimal  @default(0) @map("nps_score") @db.Decimal(5, 2)
  responseRate   Decimal  @default(0) @map("response_rate") @db.Decimal(5, 2)
  computedAt     DateTime @default(now()) @map("computed_at")

  survey NpsSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, surveyId])
  @@index([tenantId])
  @@map("nps_analytics")
}

