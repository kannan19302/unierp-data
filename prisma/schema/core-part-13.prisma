  keywords   Json     @default("[]")
  module     String
  metadata   Json     @default("{}")
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, module])
  @@index([tenantId, entityType])
  @@index([tenantId, status])
  @@map("search_indexes")
}

model SearchIndexRule {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  entityType  String   @map("entity_type")
  module      String
  fields      Json     @default("[]")
  weight      Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, entityType])
  @@index([tenantId, module, isActive])
  @@map("search_index_rules")
}

model SearchQueryLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  query       String   @db.Text
  filters     Json     @default("{}")
  resultCount Int      @default(0) @map("result_count")
  executionMs Int      @default(0) @map("execution_ms")
  entityTypes String[] @map("entity_types")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("search_query_logs")
}

model SearchAnalytics {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  date         DateTime @map("date")
  totalQueries Int      @default(0) @map("total_queries")
  uniqueUsers  Int      @default(0) @map("unique_users")
  avgResponseMs Float   @default(0) @map("avg_response_ms")
  topQueries   Json     @default("[]")
  topEntities  Json     @default("[]")
  zeroResultQueries Json @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("search_analytics")
}

model SavedViewLayout {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  userId       String   @map("user_id")
  viewId       String   @map("view_id")
  layoutType   String   @default("table") // table, grid, kanban, calendar, gantt
  columns      Json     @default("[]")
  groupBy      String?
  sortBy       Json     @default("[]")
  pageSize     Int      @default(25) @map("page_size")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  view SavedView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, viewId])
  @@index([tenantId, userId])
  @@map("saved_view_layouts")
}

model SavedViewFilter {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  viewId     String   @map("view_id")
  field      String
  operator   String   @default("eq") // eq, neq, contains, gt, gte, lt, lte, in, between, isNull, isNotNull
  value      Json
  logic      String   @default("AND") // AND, OR
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  view SavedView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@index([tenantId, viewId])
  @@map("saved_view_filters")
}

model SavedViewColumnConfig {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  viewId     String   @map("view_id")
  field      String
  label      String?
  width      Int?
  sortable   Boolean  @default(true)
  visible    Boolean  @default(true)
  position   Int      @default(0)
  format     String?  // currency, date, number, percentage, etc.
  alignment  String   @default("left") // left, center, right
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  view SavedView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@unique([tenantId, viewId, field, userId])
  @@index([tenantId, viewId])
  @@map("saved_view_column_configs")
}

model SavedViewSharing {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  viewId    String   @map("view_id")
  sharedWithUserId String @map("shared_with_user_id")
  sharedByUserId   String @map("shared_by_user_id")
  permission String  @default("view") // view, edit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  view SavedView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@unique([tenantId, viewId, sharedWithUserId])
  @@index([tenantId, sharedWithUserId])
  @@map("saved_view_sharings")
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  subject     String
  body        String   @db.Text
  channel     String   @default("EMAIL") // EMAIL, SMS, PUSH, IN_APP
  variables   Json     @default("[]")
  eventType   String?
  isActive    Boolean  @default(true) @map("is_active")
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId, channel, isActive])
  @@map("notification_templates")
}

model NotificationBatch {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  channel     String    @default("EMAIL")
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, PARTIAL
  totalItems  Int       @default(0) @map("total_items")
  sentItems   Int       @default(0) @map("sent_items")
  failedItems Int       @default(0) @map("failed_items")
  templateId  String?   @map("template_id")
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  items NotificationBatchItem[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@map("notification_batches")
}

model NotificationBatchItem {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  batchId    String    @map("batch_id")
  userId     String    @map("user_id")
  recipient  String
  subject    String
  body       String    @db.Text
  status     String    @default("PENDING") // PENDING, SENT, FAILED, BOUNCED
  errorMsg   String?   @map("error_msg")
  sentAt     DateTime? @map("sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  batch NotificationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId])
  @@index([tenantId, status])
  @@map("notification_batch_items")
}

model NotificationDigest {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  userId        String    @map("user_id")
  frequency     String    @default("DAILY") // DAILY, WEEKLY, MONTHLY, INSTANT
  channel       String    @default("EMAIL")
  lastSentAt    DateTime? @map("last_sent_at")
  nextScheduledAt DateTime? @map("next_scheduled_at")
  isEnabled     Boolean   @default(true) @map("is_enabled")
  preferences   Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, userId, frequency])
  @@index([tenantId, userId])
  @@map("notification_digests")
}

model NotificationDeliveryLog {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  notificationId  String?   @map("notification_id")
  templateId      String?   @map("template_id")
  userId          String    @map("user_id")
  channel         String
  status          String    @default("QUEUED") // QUEUED, SENT, DELIVERED, BOUNCED, FAILED, OPENED, CLICKED
  errorMsg        String?   @map("error_msg")
  metadata        Json      @default("{}")
  sentAt          DateTime? @map("sent_at")
  deliveredAt     DateTime? @map("delivered_at")
  openedAt        DateTime? @map("opened_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId, status])
  @@index([tenantId, channel, createdAt])
  @@map("notification_delivery_logs")
}

model Deployment {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  name          String
  description   String?
  application   String
  version       String
  environmentId String   @map("environment_id")
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, SUCCESS, FAILED, ROLLED_BACK, CANCELLED
  strategy      String   @default("ROLLING") // ROLLING, BLUE_GREEN, CANARY, RECREATE
  branch        String?
  commitSha     String?  @map("commit_sha")
  commitMessage String?  @map("commit_message")
  deployedBy    String   @map("deployed_by")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  rollbackFrom  String?  @map("rollback_from")
  rollbackTo    String?  @map("rollback_to")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  environment       DeploymentStage @relation("EnvironmentDeployment", fields: [environmentId], references: [id])
  stages            DeploymentStage[] @relation("DeploymentStages")
  buildLogs         BuildLog[]
  artifacts         ReleaseArtifact[]
  depEnvironmentId  String?            @map("dep_environment_id")
  depEnvironment    Environment?       @relation(fields: [depEnvironmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, environmentId])
  @@index([tenantId, status])
  @@map("deployments")
}
