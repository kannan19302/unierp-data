model LeadSource {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  leads Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("lead_sources")
}

model Lead {
  id                     String    @id @default(cuid())
  tenantId               String    @map("tenant_id")
  orgId                  String    @map("org_id")
  salutation             String?
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  company                String?
  title                  String?
  email                  String?
  phone                  String?
  mobile                 String?
  website                String?
  sourceId               String?   @map("source_id")
  status                 String    @default("NEW") // NEW, CONTACTED, QUALIFIED, DISQUALIFIED, CONVERTED
  industry               String?
  employeeCount          Int?      @map("employee_count")
  annualRevenue          Decimal?  @map("annual_revenue") @db.Decimal(15, 2)
  country                String?
  region                 String?
  score                  Int       @default(0)
  notes                  String?
  assignedToId           String?   @map("assigned_to_id")
  convertedCustomerId    String?   @map("converted_customer_id")
  convertedOpportunityId String?   @map("converted_opportunity_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  campaignId String? @map("campaign_id")

  source        LeadSource?   @relation(fields: [sourceId], references: [id])
  campaign      Campaign?     @relation(fields: [campaignId], references: [id])
  activities    Activity[]
  opportunities Opportunity[] @relation("LeadOpportunity")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([campaignId])
  @@index([assignedToId])
  @@map("leads")
}

model Opportunity {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  orgId             String    @map("org_id")
  name              String
  customerId        String?   @map("customer_id")
  leadId            String?   @map("lead_id")
  pipelineId        String?   @map("pipeline_id")
  stage             String    @default("PROSPECTING") // Prospecting, Qualification, Proposal, Negotiation, Closed Won, Closed Lost
  amount            Decimal?  @db.Decimal(15, 2)
  probability       Int       @default(0) // 0-100
  expectedCloseDate DateTime? @map("expected_close_date")
  actualCloseDate   DateTime? @map("actual_close_date")
  competitor        String?
  lossReason        String?   @map("loss_reason")
  notes             String?
  assignedToId      String?   @map("assigned_to_id")
  competitorId      String?   @map("competitor_id")
  winLossReasonId   String?   @map("win_loss_reason_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  currency       String    @default("USD")
  weightedAmount Decimal?  @map("weighted_amount") @db.Decimal(15, 2)
  stageEnteredAt DateTime? @map("stage_entered_at")

  customer      Customer?             @relation(fields: [customerId], references: [id])
  lead          Lead?                 @relation("LeadOpportunity", fields: [leadId], references: [id])
  pipeline      SalesPipeline?        @relation(fields: [pipelineId], references: [id])
  activities    Activity[]
  lineItems     OpportunityLineItem[]
  tags          DealTag[]
  teamMembers   DealTeamMember[]
  contactRoles  ContactRole[]
  riskAlerts    PipelineRiskAlert[]
  dealRoom      DealRoom?
  competitorRel Competitor?           @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  winLossReason WinLossReason?        @relation(fields: [winLossReasonId], references: [id], onDelete: SetNull)

  dealDeskRequests DealDeskRequest[]
  dealAlerts       DealAlert[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, pipelineId])
  @@index([customerId])
  @@map("opportunities")
}

model CrmAiDraft {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  orgId       String    @map("org_id")
  draftType   String    @map("draft_type") // FOLLOWUP_EMAIL, QUOTE_COVER_NOTE, LEAD_OUTREACH_EMAIL
  contextType String    @map("context_type") // OPPORTUNITY, QUOTATION, LEAD
  contextId   String    @map("context_id")
  tone        String    @default("PROFESSIONAL") // PROFESSIONAL, FRIENDLY, URGENT, CONCISE
  subject     String?
  body        String
  status      String    @default("DRAFT") // DRAFT, USED, DISCARDED
  generatedBy String?   @map("generated_by")
  usedAt      DateTime? @map("used_at")
  discardedAt DateTime? @map("discarded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, contextType, contextId])
  @@index([tenantId, status])
  @@map("crm_ai_drafts")
}

model OpportunityLineItem {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  opportunityId String   @map("opportunity_id")
  productId     String?  @map("product_id")
  description   String
  quantity      Decimal  @db.Decimal(15, 3)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(5, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(15, 2)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([opportunityId])
  @@map("opportunity_line_items")
}

model CrmWorkflowRule {
