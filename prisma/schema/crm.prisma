  name        String
  description String?
  module      String    @default("crm") // crm, sales, finance, etc.
  type        String    @default("TABLE") // TABLE, CHART, PIVOT, SUMMARY
  isSystem    Boolean   @default(false) @map("is_system")
  config      Json      @default("{}") // full report configuration
  filters     Json      @default("{}")
  columns     Json      @default("[]")
  chartConfig Json?     @map("chart_config")
  isFavorite  Boolean   @default(false) @map("is_favorite")
  isShared    Boolean   @default(false) @map("is_shared")
  usageCount  Int       @default(0) @map("usage_count")
  lastUsedAt  DateTime? @map("last_used_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category  ReportCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  schedules CrmReportSchedule[]
  shares    CrmReportShare[]

  @@index([tenantId])
  @@index([tenantId, module])
  @@index([categoryId])
  @@map("crm_saved_reports")
}

model CrmReportSchedule {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  reportId   String    @map("report_id")
  name       String
  frequency  String    @default("WEEKLY") // DAILY, WEEKLY, MONTHLY, QUARTERLY, CUSTOM
  cronExpr   String?   @map("cron_expr")
  recipients Json      @default("[]") // email addresses
  format     String    @default("PDF") // PDF, CSV, XLSX, HTML
  filters    Json      @default("{}")
  isActive   Boolean   @default(true) @map("is_active")
  lastRunAt  DateTime? @map("last_run_at")
  nextRunAt  DateTime? @map("next_run_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  report CrmSavedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reportId])
  @@map("crm_report_schedules")
}

model CrmReportShare {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  reportId  String   @map("report_id")
  userId    String   @map("user_id")
  canEdit   Boolean  @default(false) @map("can_edit")
  createdAt DateTime @default(now()) @map("created_at")

  report CrmSavedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reportId, userId])
  @@index([tenantId])
  @@map("crm_report_shares")
}

model CrmDashboardTemplate {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  description String?
  category    String    @default("GENERAL") // GENERAL, SALES, MARKETING, SERVICE, EXECUTIVE
  layout      Json      @default("[]")
  widgets     Json      @default("[]")
  isDefault   Boolean   @default(false) @map("is_default")
  isSystem    Boolean   @default(false) @map("is_system")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, category])
  @@map("crm_dashboard_templates")
}

model CrmDashboardShare {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  dashboardId String   @map("dashboard_id")
  userId      String   @map("user_id")
  canEdit     Boolean  @default(false) @map("can_edit")
  createdAt   DateTime @default(now()) @map("created_at")

  dashboard CrmDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dashboardId, userId])
  @@index([tenantId])
  @@map("crm_dashboard_shares")
}
