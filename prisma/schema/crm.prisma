model CrmCustomField {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  orgId        String    @map("org_id")
  entity       String
  fieldName    String    @map("field_name")
  label        String
  fieldType    String    @map("field_type")
  description  String?
  isRequired   Boolean   @default(false) @map("is_required")
  defaultValue String?   @map("default_value")
  options      Json      @default("[]")
  validation   Json      @default("{}")
  lookupEntity String?   @map("lookup_entity")
  formulaExpr  String?   @map("formula_expr")
  sortOrder    Int       @default(0) @map("sort_order")
  section      String    @default("Custom Fields")
  isActive     Boolean   @default(true) @map("is_active")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  values CrmCustomFieldValue[]

  @@unique([tenantId, entity, fieldName])
  @@index([tenantId])
  @@index([tenantId, entity])
  @@map("crm_custom_fields")
}

model CrmCustomFieldValue {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
