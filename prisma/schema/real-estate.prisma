  priority       String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT, EMERGENCY
  status         String    @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED, ON_HOLD
  vendorId       String?   @map("vendor_id")
  assignedTo     String?   @map("assigned_to")
  estimatedCost  Decimal?  @map("estimated_cost")
  actualCost     Decimal   @default(0) @map("actual_cost")
  scheduledDate  DateTime? @map("scheduled_date")
  completedDate  DateTime? @map("completed_date")
