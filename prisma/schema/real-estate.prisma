  hasSecurity Boolean  @default(false) @map("has_security")
  status      String   @default("ACTIVE")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  properties RealEstateProperty[]

  @@index([tenantId])
  @@map("real_estate_buildings")
}

model RealEstatePropertyUnit {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  propertyId     String   @map("property_id")
  unitNumber     String   @map("unit_number")
  floor          Int?
  bedrooms       Int      @default(0)
  bathrooms      Int      @default(0)
  sqft           Int      @default(0)
  rentAmount     Decimal  @default(0) @map("rent_amount")
  depositAmount  Decimal  @default(0) @map("deposit_amount")
  marketValue    Decimal? @map("market_value")
  status         String   @default("VACANT") // VACANT, OCCUPIED, RESERVED, UNDER_MAINTENANCE
  features       Json     @default("[]")
  images         Json     @default("[]")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  property RealEstateProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases   RealEstateLease[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([tenantId, status])
  @@map("real_estate_units")
}

model RealEstateLease {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  propertyId       String    @map("property_id")
  unitId           String?   @map("unit_id")
  tenantName       String    @map("tenant_name")
  tenantEmail      String?   @map("tenant_email")
  tenantPhone      String?   @map("tenant_phone")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  rentAmount       Decimal   @map("rent_amount")
  securityDeposit  Decimal   @default(0) @map("security_deposit")
  depositHeld      Boolean   @default(true) @map("deposit_held")
  billingFrequency String    @default("MONTHLY") @map("billing_frequency") // MONTHLY, QUARTERLY, YEARLY
  paymentDueDay    Int       @default(1) @map("payment_due_day")
  lateFeePercent   Decimal   @default(0) @map("late_fee_percent")
  lateFeeFixed     Decimal   @default(0) @map("late_fee_fixed")
  terms            String?   @default("")
  renewalTerms     String?   @map("renewal_terms")
  nextRenewalDate  DateTime? @map("next_renewal_date")
  autoRenewal      Boolean   @default(false) @map("auto_renewal")
  status           String    @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED, RENEWED, PENDING
  documents        Json      @default("[]")
  notes            String?
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  property RealEstateProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     RealEstatePropertyUnit? @relation(fields: [unitId], references: [id])
  payments RealEstateLeasePayment[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@map("real_estate_leases")
}

model RealEstateLeasePayment {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  leaseId     String   @map("lease_id")
  amount      Decimal
  paidAmount  Decimal? @map("paid_amount")
  dueDate     DateTime @map("due_date")
  paidDate    DateTime? @map("paid_date")
  method      String   @default("BANK_TRANSFER") // CASH, CHECK, BANK_TRANSFER, CREDIT_CARD, ONLINE
  reference   String?  // check number, transaction id, etc.
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  lateFee     Decimal  @default(0) @map("late_fee")
  discount    Decimal  @default(0)
  status      String   @default("PENDING") // PENDING, PAID, PARTIAL, OVERDUE, CANCELLED, REFUNDED
  notes       String?
  receiptUrl  String?  @map("receipt_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lease RealEstateLease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leaseId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("real_estate_lease_payments")
}

model RealEstateTenant {
