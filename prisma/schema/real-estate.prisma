model LeaseSchedule {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  financeLeaseId     String   @map("finance_lease_id")
  periodStart        DateTime @map("period_start")
  periodEnd          DateTime @map("period_end")
  paymentAmount      Decimal  @map("payment_amount") @db.Decimal(18, 4)
  interestExpense    Decimal? @map("interest_expense") @db.Decimal(18, 4)
  principalRepayment Decimal? @map("principal_repayment") @db.Decimal(18, 4)
  rouAmortization    Decimal? @map("rou_amortization") @db.Decimal(18, 4)
  journalPosted      Boolean  @default(false) @map("journal_posted")
  journalEntryId     String?  @map("journal_entry_id")
  createdAt          DateTime @default(now()) @map("created_at")

  financeLease FinanceLease @relation(fields: [financeLeaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([financeLeaseId])
  @@map("lease_schedules")
}

model UnitOfMeasure {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  abbreviation String
  type         String   @default("UNIT") // UNIT, WEIGHT, VOLUME, LENGTH, AREA, TIME
  isBase       Boolean  @default(false) @map("is_base")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  fromConversions UoMConversion[]  @relation("FromUoM")
  toConversions   UoMConversion[]  @relation("ToUoM")
  stockEntryItems StockEntryItem[]

  @@unique([tenantId, abbreviation])
  @@index([tenantId])
  @@map("units_of_measure")
}

model ProposalDocument {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  orgId       String    @map("org_id")
  quotationId String    @map("quotation_id")
  title       String
  templateId  String?   @map("template_id")
  content     Json      @default("{}")
  generatedAt DateTime? @map("generated_at")
  generatedBy String?   @map("generated_by")
  fileUrl     String?   @map("file_url")
  status      String    @default("DRAFT") // DRAFT, GENERATED, SENT, ACCEPTED, REJECTED
  sentAt      DateTime? @map("sent_at")
  viewedAt    DateTime? @map("viewed_at")
  acceptedAt  DateTime? @map("accepted_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([quotationId])
  @@map("proposal_documents")
}

model RealEstateProperty {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  type        String   @default("RESIDENTIAL") // RESIDENTIAL, COMMERCIAL, INDUSTRIAL, LAND, MIXED_USE
  portfolioId String?  @map("portfolio_id")
  buildingId  String?  @map("building_id")
  address     String?
  city        String?
  state       String?
  zipCode     String?  @map("zip_code")
  country     String?  @default("US")
  latitude    Float?
  longitude   Float?
  specs       Json     @default("{}") // bedrooms, bathrooms, sqft, yearBuilt, lotSize, floors
  amenities   Json     @default("[]")
  images      Json     @default("[]") // array of image URLs
  floorPlan   String?  @map("floor_plan")
  status      String   @default("AVAILABLE") // AVAILABLE, LEASED, UNDER_MAINTENANCE, SOLD, OFF_MARKET
  featured    Boolean  @default(false)
  parentId    String?  @map("parent_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  children        RealEstateProperty[]             @relation("PropertyHierarchy")
  parent          RealEstateProperty?              @relation("PropertyHierarchy", fields: [parentId], references: [id])
  portfolio       RealEstatePropertyPortfolio?     @relation(fields: [portfolioId], references: [id])
  building        RealEstatePropertyBuilding?      @relation(fields: [buildingId], references: [id])
  leases          RealEstateLease[]
  maintenance     RealEstateMaintenanceWorkOrder[]
  tenants         RealEstateTenant[]
  valuations      RealEstatePropertyValuation[]
  units           RealEstatePropertyUnit[]
  commissionPlans RealEstateCommissionPlan[]

  @@index([tenantId])
  @@index([parentId])
  @@index([portfolioId])
  @@index([buildingId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, city, state])
  @@map("real_estate_properties")
}

model RealEstatePropertyPortfolio {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  type        String   @default("RESIDENTIAL") // RESIDENTIAL, COMMERCIAL, MIXED
  targetRoi   Decimal? @map("target_roi")
  totalValue  Decimal? @map("total_value") @default(0)
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  properties RealEstateProperty[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@map("real_estate_portfolios")
}

model RealEstatePropertyBuilding {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  totalFloors Int      @default(1) @map("total_floors")
  totalUnits  Int      @default(0) @map("total_units")
  amenities   Json     @default("[]")
  yearBuilt   Int?
