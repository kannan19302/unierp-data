  hoaFees         Decimal   @default(0) @map("hoa_fees")
  otherExpenses   Decimal   @default(0) @map("other_expenses")
  totalExpenses   Decimal   @default(0) @map("total_expenses")
  netOperatingIncome Decimal @default(0) @map("net_operating_income")
  debtService     Decimal   @default(0) @map("debt_service") // mortgage payments
  cashFlowBeforeTax Decimal @default(0) @map("cash_flow_before_tax")
  capitalExpenditures Decimal @default(0) @map("capital_expenditures")
  netCashFlow     Decimal   @default(0) @map("net_cash_flow")
  capRate         Decimal?  @map("cap_rate") // calculated NOI / property value
  cashOnCashReturn Decimal? @map("cash_on_cash_return") // percentage
  occupancyRate   Decimal?  @map("occupancy_rate") // percentage
  status          String    @default("DRAFT") // DRAFT, FINAL, ARCHIVED
  currency        String    @default("USD")
  notes           String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([propertyId])
  @@index([tenantId, periodStart, periodEnd])
  @@map("real_estate_property_financials")
}

model RealEstateExpenseCategory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  description String?
  type        String   @default("OPERATING") // OPERATING, CAPITAL, ADMINISTRATIVE, OTHER
  isTaxDeductible Boolean @default(true) @map("is_tax_deductible")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("real_estate_expense_categories")
}

model RealEstatePropertyInspection {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  propertyId  String   @map("property_id")
  inspectorId String   @map("inspector_id")
  type        String   @default("MOVE_IN") // MOVE_IN, MOVE_OUT, ROUTINE
  checklist   Json     @default("[]")
  passed      Boolean  @default(true)
  notes       String?  @db.Text
  inspectedAt DateTime @default(now()) @map("inspected_at")

  @@index([tenantId])
  @@index([tenantId, propertyId])
  @@map("real_estate_property_inspections")
}

model RealEstateRentCollectionLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  leaseId     String   @map("lease_id")
  tenantUser  String   @map("tenant_user")
  amountPaid  Decimal  @db.Decimal(15, 2) @map("amount_paid")
  paymentMethod String @map("payment_method")
  transactionRef String? @map("transaction_ref")
  paidAt      DateTime @default(now()) @map("paid_at")
  lateFee     Decimal  @default(0) @db.Decimal(15, 2) @map("late_fee")

  @@index([tenantId])
  @@index([tenantId, leaseId])
  @@map("real_estate_rent_collection_logs")
}

model RealEstateListingSyndicate {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  propertyId  String   @map("property_id")
  platform    String   // ZILLOW, REDFIN, REALTOR, MLS
  externalId  String?  @map("external_id")
  status      String   @default("ACTIVE") // ACTIVE, PAUSED, REMOVED
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, propertyId])
  @@map("real_estate_listing_syndicates")
}
