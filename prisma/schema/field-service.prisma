  certifications    Json     @default("[]") // array of certification objects
  maxTravelRadius   Int      @default(50) @map("max_travel_radius") // in miles/km
  preferredRadius   Int      @default(25) @map("preferred_radius")
  currentStatus     String   @default("AVAILABLE") // AVAILABLE, BUSY, ON_BREAK, OFFLINE, ON_LEAVE
  shiftStart        String?  @map("shift_start") // HH:mm format
  shiftEnd          String?  @map("shift_end")
  workDays          Json     @default("[1,2,3,4,5]") // 0=Sun, 1=Mon, etc.
  hourlyRate        Decimal  @default(0) @map("hourly_rate")
  overtimeRate      Decimal  @default(0) @map("overtime_rate")
  rating            Decimal  @default(5.0)
  completedJobs     Int      @default(0) @map("completed_jobs")
