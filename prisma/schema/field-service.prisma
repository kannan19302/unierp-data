}

model FieldServiceSla {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  name            String
  description     String?
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  responseTimeMin Int      @map("response_time_min") // in minutes
  resolutionTimeMin Int    @map("resolution_time_min") // in minutes
  escalationRules Json     @default("[]") // array of escalation step objects
  penaltyClause   String?
  maxEscalations  Int      @default(3) @map("max_escalations")
  businessHoursOnly Boolean @default(true) @map("business_hours_only")
  isDefault       Boolean  @default(false) @map("is_default")
  status          String   @default("ACTIVE")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tickets   FieldServiceTicket[]
  contracts FieldServiceContract[]

  @@index([tenantId])
  @@index([tenantId, priority])
  @@map("field_service_slas")
}

model FieldServiceTicket {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  title         String
  customerId    String?   @map("customer_id")
  customerName  String    @map("customer_name")
  customerEmail String?   @map("customer_email")
  customerPhone String?   @map("customer_phone")
  contactPerson String?   @map("contact_person")
  priority      String    @default("MEDIUM")
  status        String    @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED, CANCELLED, ON_HOLD
  category      String    @default("GENERAL") // GENERAL, INSTALLATION, REPAIR, MAINTENANCE, INSPECTION, EMERGENCY
  source        String    @default("MANUAL") // MANUAL, PHONE, EMAIL, PORTAL, MOBILE, API
  slaId         String?   @map("sla_id")
  slaDeadline   DateTime? @map("sla_deadline")
  slaBreached   Boolean   @default(false) @map("sla_breached")
  escalationLevel Int     @default(0) @map("escalation_level")
  description   String?
  location      String?
  latitude      Float?
  longitude     Float?
  scheduledDate DateTime? @map("scheduled_date")
  completedDate DateTime? @map("completed_date")
  resolution    String?
  partsCost     Decimal   @default(0) @map("parts_cost")
  laborCost     Decimal   @default(0) @map("labor_cost")
  totalCost     Decimal   @default(0) @map("total_cost")
  billable      Boolean   @default(true)
  invoiced      Boolean   @default(false)
  invoiceRef    String?   @map("invoice_ref")
  tags          Json      @default("[]")
  attachments   Json      @default("[]")
  notes         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sla         FieldServiceSla?              @relation(fields: [slaId], references: [id])
  dispatches  FieldServiceDispatch[]
  appointments FieldServiceAppointment[]
  timesheets  FieldServiceTimesheet[]
  partsUsage  FieldServicePartsUsage[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, category])
  @@index([tenantId, slaDeadline])
  @@index([tenantId, createdAt])
  @@map("field_service_tickets")
}

model FieldServiceTechnician {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  employeeId        String   @map("employee_id")
  name              String
  email             String?
  phone             String?
  avatarUrl         String?  @map("avatar_url")
