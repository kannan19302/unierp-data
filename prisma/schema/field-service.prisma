model WorkOrder {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  bomId           String    @map("bom_id")
  workOrderNumber String    @map("work_order_number")
  status          String    @default("DRAFT") // DRAFT, PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  quantity        Decimal   @db.Decimal(15, 3)
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  oeeScore        Decimal?  @map("oee_score") @db.Decimal(5, 2)
  scrapQuantity   Decimal?  @map("scrap_quantity") @db.Decimal(15, 3)
  lotNumber       String?   @map("lot_number")
  workstationId   String?   @map("workstation_id")
  standardCost    Decimal?  @map("standard_cost") @db.Decimal(15, 3)
  actualCost      Decimal?  @map("actual_cost") @db.Decimal(15, 3)
  costVariance    Decimal?  @map("cost_variance") @db.Decimal(15, 3)
  overheadCost    Decimal?  @map("overhead_cost") @db.Decimal(15, 3)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  bom                   BOM                             @relation(fields: [bomId], references: [id])
  workstation           Workstation?                    @relation(fields: [workstationId], references: [id])
  ncrRecords            NonConformanceReport[]
  operations            WorkOrderOperation[]
  componentConsumptions WorkOrderComponentConsumption[]

  @@unique([tenantId, workOrderNumber])
  @@index([tenantId])
  @@map("work_orders")
}

model WorkOrderOperation {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  workOrderId     String    @map("work_order_id")
  sequence        Int
  name            String
  workstationCode String    @map("workstation_code")
  durationMinutes Int       @map("duration_minutes")
  status          String    @default("PENDING") // PENDING, RUNNING, COMPLETED
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  operatorId      String?   @map("operator_id")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workOrderId])
  @@map("work_order_operations")
}

model WorkOrderComponentConsumption {
  id               String  @id @default(cuid())
  tenantId         String  @map("tenant_id")
  workOrderId      String  @map("work_order_id")
  productId        String  @map("product_id")
  lotNumber        String  @map("lot_number") // Lot of raw component consumed
  quantityConsumed Decimal @map("quantity_consumed") @db.Decimal(15, 3)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([workOrderId])
  @@map("work_order_component_consumptions")
}

model FieldSalesRoute {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  orgId             String    @map("org_id")
  name              String
  description       String?
  assignedToId      String    @map("assigned_to_id")
  date              DateTime  @map("date")
  startLocation     Json?     @map("start_location") // {lat, lng, address}
  endLocation       Json?     @map("end_location")
  totalDistance     Decimal?  @map("total_distance") @db.Decimal(10, 2)
  distanceUnit      String    @default("KM") @map("distance_unit")
  estimatedDuration Int?      @map("estimated_duration") // minutes
  status            String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  optimized         Boolean   @default(false)
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  stops    FieldSalesRouteStop[]
  checkins FieldSalesCheckin[]

  @@index([tenantId])
  @@index([assignedToId])
  @@map("field_sales_routes")
}

model FieldSalesRouteStop {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  routeId         String    @map("route_id")
  customerId      String?   @map("customer_id")
  contactId       String?   @map("contact_id")
  name            String
  address         Json?
  location        Json?     @default("{}") // {lat, lng}
  visitOrder      Int       @map("visit_order")
  plannedDuration Int       @default(30) @map("planned_duration") // minutes
  actualDuration  Int?      @map("actual_duration")
  status          String    @default("PENDING") // PENDING, VISITED, SKIPPED, CANCELLED
  notes           String?
  visitedAt       DateTime? @map("visited_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  route FieldSalesRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([routeId])
  @@map("field_sales_route_stops")
}

model FieldSalesCheckin {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  routeId     String?   @map("route_id")
  stopId      String?   @map("stop_id")
  userId      String    @map("user_id")
  customerId  String?   @map("customer_id")
  type        String    @default("VISIT") // VISIT, MEETING, APPOINTMENT
  location    Json      @default("{}") // {lat, lng, accuracy}
  address     String?
  notes       String?   @db.Text
  checkinAt   DateTime  @map("checkin_at")
  checkoutAt  DateTime? @map("checkout_at")
  durationMin Int?      @map("duration_min")
  createdAt   DateTime  @default(now()) @map("created_at")

  customer Customer?        @relation(fields: [customerId], references: [id])
  route    FieldSalesRoute? @relation(fields: [routeId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("field_sales_checkins")
}

model FieldSalesExpense {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  orgId       String    @map("org_id")
  userId      String    @map("user_id")
  routeId     String?   @map("route_id")
