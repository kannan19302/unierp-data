  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([technicianId])
  @@index([ticketId])
  @@index([tenantId, scheduledDate])
  @@index([tenantId, status])
  @@map("field_service_schedules")
}

model FieldServiceCalendarEvent {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  technicianId  String    @map("technician_id")
  scheduleId    String?   @map("schedule_id")
  ticketId      String?   @map("ticket_id")
  title         String
  description   String?
  eventType     String    @default("APPOINTMENT") // APPOINTMENT, BREAK, TRAVEL, MEETING, PERSONAL, OTHER
  startTime     DateTime  @map("start_time")
  endTime       DateTime  @map("end_time")
  allDay        Boolean   @default(false) @map("all_day")
  color         String?   // hex color for calendar display
  location      String?
  status        String    @default("ACTIVE") // ACTIVE, CANCELLED, COMPLETED
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([technicianId])
  @@index([tenantId, startTime, endTime])
  @@map("field_service_calendar_events")
}

model FieldServicePartRequest {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  ticketId        String?   @map("ticket_id")
  technicianId    String    @map("technician_id")
  itemId          String    @map("item_id")
  itemName        String    @map("item_name")
  partNumber      String?   @map("part_number")
  quantityRequested Int     @default(1) @map("quantity_requested")
  quantityApproved Int?     @map("quantity_approved")
  quantityFulfilled Int?    @map("quantity_fulfilled")
  source          String    @default("WAREHOUSE") // WAREHOUSE, VAN, VENDOR, CUSTOMER
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String    @default("PENDING") // PENDING, APPROVED, PARTIALLY_FULFILLED, FULFILLED, CANCELLED, REJECTED
  unitPrice       Decimal   @default(0) @map("unit_price")
  totalPrice      Decimal   @default(0) @map("total_price")
  requestedBy     String?   @map("requested_by")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  fulfilledAt     DateTime? @map("fulfilled_at")
  notes           String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([technicianId])
  @@index([ticketId])
  @@index([tenantId, status])
  @@map("field_service_part_requests")
}

model FieldServiceVanStock {
