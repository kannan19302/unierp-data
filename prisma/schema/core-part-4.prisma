model TenantWebhookEndpoint {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  name                String
  url                 String
  secret              String
  events              Json      @default("[]") // subscribed events array
  isActive            Boolean   @default(true) @map("is_active")
  lastSuccessAt       DateTime? @map("last_success_at")
  lastFailureAt       DateTime? @map("last_failure_at")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries TenantWebhookDelivery[]

  @@index([tenantId])
  @@map("tenant_webhook_endpoints")
}

model TenantWebhookDelivery {
  id           String    @id @default(cuid())
  endpointId   String    @map("endpoint_id")
  tenantId     String    @map("tenant_id")
  event        String
  payload      Json
  status       String    @default("PENDING") // PENDING, DELIVERED, FAILED, RETRYING
  httpStatus   Int?      @map("http_status")
  responseBody String?   @map("response_body")
  durationMs   Int?      @map("duration_ms")
  attempt      Int       @default(1)
  maxAttempts  Int       @default(3) @map("max_attempts")
  nextRetryAt  DateTime? @map("next_retry_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint TenantWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@map("tenant_webhook_deliveries")
}

model TenantAnnouncement {
  id            String    @id @default(cuid())
  tenantId      String?   @map("tenant_id") // null = global announcement
  title         String
  body          String
  level         String    @default("INFO") // INFO, WARNING, MAINTENANCE, CRITICAL
  isDismissible Boolean   @default(true) @map("is_dismissible")
  startsAt      DateTime  @default(now()) @map("starts_at")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt, expiresAt])
  @@map("tenant_announcements")
}

model ExpenseReport {
  id                     String    @id @default(cuid())
  tenantId               String    @map("tenant_id")
  orgId                  String    @map("org_id")
  employeeId             String    @map("employee_id")
  reportNumber           String    @map("report_number")
  title                  String
  description            String?
  totalAmount            Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  expenseDate            DateTime  @default(now()) @map("expense_date")
  currency               String    @default("USD")
  categoryId             String?   @map("category_id")
  receiptUrl             String?   @map("receipt_url")
  notes                  String?
  status                 String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, PENDING_SECOND_APPROVAL, REIMBURSED, REJECTED, PAID
  hasPolicyViolation     Boolean   @default(false) @map("has_policy_violation")
  requiresSecondApproval Boolean   @default(false) @map("requires_second_approval")
  approvedBy             String?   @map("approved_by")
  approvedAt             DateTime? @map("approved_at")
  secondApprovedBy       String?   @map("second_approved_by")
  secondApprovedAt       DateTime? @map("second_approved_at")
  paidAt                 DateTime? @map("paid_at")
  glJournalId            String?   @map("gl_journal_id")
  createdBy              String?   @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  items ExpenseReportItem[]

  @@unique([tenantId, orgId, reportNumber])
  @@index([tenantId])
  @@map("expense_reports")
}

model ExpenseReportItem {
  id                         String   @id @default(cuid())
  tenantId                   String   @map("tenant_id")
  expenseReportId            String   @map("expense_report_id")
  category                   String // TRAVEL, MEALS, OFFICE, UTILITIES, MILEAGE, PER_DIEM, OTHER
  description                String
  merchant                   String?
  amount                     Decimal  @db.Decimal(15, 2)
  taxAmount                  Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  receiptUrl                 String?  @map("receipt_url")
  expenseDate                DateTime @map("expense_date")
  billable                   Boolean  @default(false)
  isMileage                  Boolean  @default(false) @map("is_mileage")
  mileageDistance            Decimal? @map("mileage_distance") @db.Decimal(10, 2)
  mileageRateApplied         Decimal? @map("mileage_rate_applied") @db.Decimal(10, 4)
  isPerDiem                  Boolean  @default(false) @map("is_per_diem")
  perDiemDays                Decimal? @map("per_diem_days") @db.Decimal(6, 2)
  perDiemRateApplied         Decimal? @map("per_diem_rate_applied") @db.Decimal(10, 2)
  ocrRaw                     Json?    @map("ocr_raw")
  ocrConfidence              Float?   @map("ocr_confidence")
  policyViolation            Boolean  @default(false) @map("policy_violation")
  policyViolationReason      String?  @map("policy_violation_reason")
  corporateCardTransactionId String?  @unique @map("corporate_card_transaction_id")

  expenseReport   ExpenseReport             @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)
  cardTransaction CorporateCardTransaction? @relation(fields: [corporateCardTransactionId], references: [id])

  @@index([tenantId])
  @@map("expense_report_items")
}

model ExpenseCategoryPolicy {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  category             String
  description          String?
  maxAmountPerItem     Decimal? @map("max_amount_per_item") @db.Decimal(15, 2)
  receiptRequiredAbove Decimal  @default(0) @map("receipt_required_above") @db.Decimal(15, 2)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, category])
  @@index([tenantId])
  @@map("expense_category_policies")
}

model MileageRate {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  ratePerMile   Decimal   @map("rate_per_mile") @db.Decimal(10, 4)
  effectiveDate DateTime  @map("effective_date")
  endDate       DateTime? @map("end_date")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("mileage_rates")
}

model PerDiemRate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  location  String
  dailyRate Decimal  @map("daily_rate") @db.Decimal(10, 2)
  currency  String   @default("USD")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, location])
  @@index([tenantId])
  @@map("per_diem_rates")
}

model CorporateCard {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  employeeId String   @map("employee_id")
  provider   String // VISA, MASTERCARD, AMEX, OTHER
  last4      String   @map("last4")
  nickname   String?
  isActive   Boolean  @default(true) @map("is_active")
  isFrozen   Boolean  @default(false) @map("is_frozen")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  transactions   CorporateCardTransaction[]
  spendLimits    CardSpendLimit[]
  categoryLimits CardCategoryLimit[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("corporate_cards")
}

model CardSpendLimit {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  cardId       String   @map("card_id")
  scopeType    String   @map("scope_type") // CARD, EMPLOYEE, DEPARTMENT
  scopeId      String?  @map("scope_id")
  period       String // WEEKLY, MONTHLY
  amountCap    Decimal  @map("amount_cap") @db.Decimal(15, 2)
  currentSpend Decimal  @default(0) @map("current_spend") @db.Decimal(15, 2)
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")
  isActive     Boolean  @default(true) @map("is_active")
  breachCount  Int      @default(0) @map("breach_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  card CorporateCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, cardId])
  @@index([tenantId, periodEnd])
  @@map("card_spend_limits")
}

model CardCategoryLimit {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  cardId       String   @map("card_id")
  mccCategory  String   @map("mcc_category")
  amountCap    Decimal  @map("amount_cap") @db.Decimal(15, 2)
  currentSpend Decimal  @default(0) @map("current_spend") @db.Decimal(15, 2)
  period       String // WEEKLY, MONTHLY
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")
  isActive     Boolean  @default(true) @map("is_active")
  breachCount  Int      @default(0) @map("breach_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  card CorporateCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, cardId])
  @@index([tenantId, periodEnd])
  @@map("card_category_limits")
}

model CardLimitAuditLog {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  limitId         String   @map("limit_id")
  limitType       String   @map("limit_type") // SPEND, CATEGORY
  changedByUserId String?  @map("changed_by_user_id")
  oldValue        Json?    @map("old_value")
  newValue        Json?    @map("new_value")
  action          String // CREATE, UPDATE, DELETE, BREACH, RESET
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, limitId])
  @@map("card_limit_audit_logs")
}

model CardLimitIncreaseRequest {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  limitId           String    @map("limit_id")
  requestedByUserId String    @map("requested_by_user_id")
  currentCap        Decimal   @map("current_cap") @db.Decimal(15, 2)
  requestedCap      Decimal   @map("requested_cap") @db.Decimal(15, 2)
  reason            String?
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedByUserId  String?   @map("approved_by_user_id")
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, limitId])
  @@map("card_limit_increase_requests")
}

model CorporateCardTransaction {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  cardId          String   @map("card_id")
  transactionDate DateTime @map("transaction_date")
  merchant        String
  amount          Decimal  @db.Decimal(15, 2)
  status          String   @default("UNMATCHED") // UNMATCHED, MATCHED, IGNORED
  createdAt       DateTime @default(now()) @map("created_at")

  card        CorporateCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  expenseItem ExpenseReportItem?

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("corporate_card_transactions")
}

model RevenueSchedule {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  orgId            String   @map("org_id")
  invoiceId        String?  @map("invoice_id")
  description      String
  totalAmount      Decimal  @map("total_amount") @db.Decimal(15, 2)
  deferredAmount   Decimal  @default(0) @map("deferred_amount") @db.Decimal(15, 2)
  recognizedAmount Decimal  @default(0) @map("recognized_amount") @db.Decimal(15, 2)
  startDate        DateTime @map("start_date")
  endDate          DateTime @map("end_date")
  recognitionType  String   @map("recognition_type") // STRAIGHT_LINE, MILESTONE
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("revenue_schedules")
}

model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  orgId              String    @map("org_id")
  name               String
  description        String?
  customerId         String?   @map("customer_id")
  productId          String?   @map("product_id")
  currency           String    @default("USD")
  unitAmount         Decimal   @map("unit_amount") @db.Decimal(15, 2)
  quantity           Int       @default(1)
  billingPeriod      String    @default("MONTHLY") @map("billing_period") // MONTHLY, QUARTERLY, SEMI_ANNUAL, ANNUAL
  billingCycles      Int?      @map("billing_cycles") // null = infinite
  status             String    @default("ACTIVE") // ACTIVE, PAUSED, CANCELED, EXPIRED, TRIALING
  startDate          DateTime  @map("start_date")
  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  trialEndDate       DateTime? @map("trial_end_date")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")
  pausedAt           DateTime? @map("paused_at")
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  lines             SubscriptionLine[]
  invoices          SubscriptionInvoice[]
  usage             SubscriptionUsage[]
  couponRedemptions SubscriptionCouponRedemption[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  subscriptionId String   @map("subscription_id")
  productId      String?  @map("product_id")
  description    String
  unitAmount     Decimal  @map("unit_amount") @db.Decimal(15, 2)
  quantity       Int      @default(1)
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@map("subscription_lines")
}

model SubscriptionInvoice {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  subscriptionId String    @map("subscription_id")
  invoiceId      String    @map("invoice_id")
  periodStart    DateTime  @map("period_start")
  periodEnd      DateTime  @map("period_end")
  sequenceNumber Int       @map("sequence_number")
  status         String    @default("PENDING") // PENDING, PAID, FAILED
  amount         Decimal   @db.Decimal(15, 2)
  createdAt      DateTime  @default(now()) @map("created_at")
  paidAt         DateTime? @map("paid_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([tenantId, status])
  @@map("subscription_invoices")
}

model SubscriptionUsage {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  subscriptionId String   @map("subscription_id")
  usageDate      DateTime @map("usage_date")
  metricName     String   @map("metric_name") // e.g. "api_calls", "storage_gb", "seats"
  quantity       Int
  unitAmount     Decimal  @map("unit_amount") @db.Decimal(15, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(15, 2)
  invoiceId      String?  @map("invoice_id")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([tenantId, subscriptionId, metricName])
  @@map("subscription_usage")
}

model ConsolidationRun {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  runDate          DateTime @default(now()) @map("run_date")
  periodStart      DateTime @map("period_start")
  periodEnd        DateTime @map("period_end")
  period           String?
  targetCurrency   String?  @default("USD") @map("target_currency")
  ctaAmount        Decimal? @default(0) @map("cta_amount") @db.Decimal(15, 2)
  status           String   @default("DRAFT") // DRAFT, COMPLETED
  totalAssets      Decimal  @default(0) @map("total_assets") @db.Decimal(15, 2)
  totalLiabilities Decimal  @default(0) @map("total_liabilities") @db.Decimal(15, 2)
  totalEquity      Decimal  @default(0) @map("total_equity") @db.Decimal(15, 2)
  totalRevenue     Decimal  @default(0) @map("total_revenue") @db.Decimal(15, 2)
  totalExpenses    Decimal  @default(0) @map("total_expenses") @db.Decimal(15, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  eliminations ConsolidationElimination[]

  @@index([tenantId])
  @@map("consolidation_runs")
}

model ConsolidationElimination {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  consolidationId String   @map("consolidation_id")
  fromOrgId       String   @map("from_org_id")
  toOrgId         String   @map("to_org_id")
  amount          Decimal  @db.Decimal(15, 2)
  accountType     String   @map("account_type") // REVENUE, EXPENSE, ASSET, LIABILITY
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")

  consolidation ConsolidationRun @relation(fields: [consolidationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("consolidation_eliminations")
}

model RecurringJournal {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  orgId         String    @map("org_id")
  entryTemplate Json      @map("entry_template")
  frequency     String // DAILY, WEEKLY, MONTHLY
  nextRunDate   DateTime  @map("next_run_date")
  lastRunDate   DateTime? @map("last_run_date")
  status        String    @default("ACTIVE") // ACTIVE, PAUSED
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("recurring_journals")
}

model FixedAsset {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  orgId              String   @map("org_id")
  assetCode          String   @map("asset_code")
  name               String
  description        String?
  categoryId         String?  @map("category_id")
  purchaseDate       DateTime @map("purchase_date")
  purchaseValue      Decimal  @map("purchase_value") @db.Decimal(15, 2)
  salvageValue       Decimal  @map("salvage_value") @db.Decimal(15, 2)
  usefulLifeYears    Int      @map("useful_life_years")
  depreciationMethod String   @map("depreciation_method") // SLM, WDV
  depreciationRate   Decimal? @map("depreciation_rate") @db.Decimal(5, 2)
  currentValue       Decimal  @map("current_value") @db.Decimal(15, 2)
  accountId          String   @map("account_id")
  accumDepAccountId  String   @map("accum_dep_account_id")
  locationId         String?  @map("location_id")
  custodianId        String?  @map("custodian_id")
  status             String   @default("ACTIVE") // ACTIVE, DISPOSED, UNDER_MAINTENANCE
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String   @default("system") @map("created_by")
  updatedBy          String   @default("system") @map("updated_by")

  category        FixedAssetCategory?   @relation(fields: [categoryId], references: [id])
  location        Warehouse?            @relation(fields: [locationId], references: [id])
  custodian       Employee?             @relation(fields: [custodianId], references: [id])
  depreciations   AssetDepreciation[]
  transfers       AssetTransferLog[]
  maintenanceLogs AssetMaintenanceLog[]
  disposals       FixedAssetDisposal[]
  auditLogs       FixedAssetAuditLog[]
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, assetCode])
  @@index([tenantId])
  @@index([categoryId])
  @@index([locationId])
  @@index([custodianId])
  @@map("fixed_assets")
}

model AssetDepreciation {
  id                      String   @id @default(cuid())
  tenantId                String   @map("tenant_id")
  assetId                 String   @map("asset_id")
  date                    DateTime
  amount                  Decimal  @db.Decimal(15, 2)
  periodName              String?  @map("period_name")
  accumulatedDepreciation Decimal  @default(0) @map("accumulated_depreciation") @db.Decimal(15, 2)
  bookValue               Decimal  @default(0) @map("book_value") @db.Decimal(15, 2)
  status                  String   @default("POSTED") // PENDING, POSTED
  journalId               String?  @map("journal_id")
  createdAt               DateTime @default(now()) @map("created_at")

  asset   FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journal Journal?   @relation(fields: [journalId], references: [id])
  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, assetId])
  @@map("asset_depreciations")
}

model BankAccount {
  id                   String                @id @default(cuid())
  tenantId             String                @map("tenant_id")
  orgId                String                @map("org_id")
  accountId            String                @map("account_id")
  bankName             String                @map("bank_name")
  accountNumber        String                @map("account_number")
  currency             String                @default("USD")
  status               String                @default("ACTIVE")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  account              Account               @relation(fields: [accountId], references: [id])
  paymentRuns          PaymentRun[]
  treasuryTransactions TreasuryTransaction[]
  connections          BankConnection[]
  paymentBatches       PaymentBatch[]

  @@index([tenantId])
  @@index([accountId])
  @@map("bank_accounts")
}

model CreditNote {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  orgId      String    @map("org_id")
  customerId String    @map("customer_id")
  invoiceId  String?   @map("invoice_id")
  noteNumber String    @map("note_number")
  amount     Decimal   @db.Decimal(15, 2)
  lineItems  Json?     @map("line_items")
  reason     String?
  status     String    @default("DRAFT")
  issueDate  DateTime  @default(now()) @map("issue_date")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  organization Organization @relation(fields: [orgId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, orgId, noteNumber])
  @@index([tenantId])
  @@map("credit_notes")
}

model DebitNote {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  orgId           String    @map("org_id")
  vendorId        String    @map("vendor_id")
  purchaseOrderId String?   @map("purchase_order_id")
  billId          String?   @map("bill_id")
  noteNumber      String    @map("note_number")
  amount          Decimal   @db.Decimal(15, 2)
