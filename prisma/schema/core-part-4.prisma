  capabilities Json     @default("[]") // [{type:'camera'|'gps'|'notifications'|'barcode', enabled}]
  settings     Json     @default("{}") // offlineMode, syncInterval, pushEnabled
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("mobile_apps")
}

