  description  String?
  status       String   @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  isDefault    Boolean  @default(false) @map("is_default")
  tokens       Json     @default("{}") // flat token map {colorPrimary: '#3b82f6', ...}
  cssVariables Json     @default("{}") // {--color-primary: ..., --radius-sm: ...}
  typography   Json     @default("{}") // {fontFamily, headingFont, baseSize, scale}
  spacing      Json     @default("{}") // {baseUnit: 4, scale: 1.5}
  borderRadius Json     @default("{}") // {sm: 4, md: 8, lg: 12, xl: 16}
  shadows      Json     @default("{}") // {sm: '0 1px 2px', md: '0 4px 6px'}
  colors       Json     @default("{}") // {primary, secondary, success, warning, danger, info}
  settings     Json     @default("{}") // darkMode, highContrast, reducedMotion
  version      Int      @default(1)
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("theme_configs")
}

model DesignToken {
