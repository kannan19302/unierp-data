  name        String // CONTROL, VARIANT_A, VARIANT_B, etc.
  type        String   @default("CONTROL") // CONTROL, VARIANT
  changes     Json     @default("{}") // {css, html, js, settings}
  weight      Int      @default(50) // traffic weight percentage
  views       Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, testId, name])
  @@index([tenantId, testId])
  @@map("ab_test_variants")
}

