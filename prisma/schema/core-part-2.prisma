  includePaidInvoices Boolean   @default(false) @map("include_paid_invoices")
  notes               String?
  generatedAt         DateTime  @default(now()) @map("generated_at")
  sentAt              DateTime? @map("sent_at")
  createdAt           DateTime  @default(now()) @map("created_at")
