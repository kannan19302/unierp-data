  name      String
  parentId  String?  @map("parent_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent         CostCenter?    @relation("CostCenterHierarchy", fields: [parentId], references: [id])
  children       CostCenter[]   @relation("CostCenterHierarchy")
  journalEntries JournalEntry[]
  budgets        Budget[]

  @@unique([tenantId, orgId, code])
  @@index([tenantId])
  @@map("cost_centers")
}

model Journal {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  orgId           String   @map("org_id")
  entryNumber     String   @map("entry_number")
  date            DateTime @default(now())
  status          String   @default("DRAFT") // DRAFT, POSTED
  notes           String?
  createdBy       String?  @map("created_by")
  bookId          String?  @map("book_id")
  sourceJournalId String?  @map("source_journal_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  entries         JournalEntry[]
  book            AccountingBook?     @relation(fields: [bookId], references: [id])
  depreciations   AssetDepreciation[]
  allocationRuns  AllocationRun[]
  eliminationRuns EliminationRun[]
  sourceJournal   Journal?            @relation("JournalHistory", fields: [sourceJournalId], references: [id])
  mappedJournals  Journal[]           @relation("JournalHistory")

  @@unique([tenantId, orgId, entryNumber])
  @@index([tenantId])
  @@map("journals")
}

model JournalEntry {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  journalId    String   @map("journal_id")
  accountId    String   @map("account_id")
  departmentId String?  @map("department_id")
  costCenterId String?  @map("cost_center_id")
  projectId    String?  @map("project_id")
  debit        Decimal  @default(0) @db.Decimal(15, 2)
  credit       Decimal  @default(0) @db.Decimal(15, 2)
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  journal    Journal     @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account    Account     @relation(fields: [accountId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])

  @@index([tenantId])
  @@index([journalId])
  @@index([accountId])
  @@map("journal_entries")
}

model Budget {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  orgId              String   @map("org_id")
  accountId          String   @map("account_id")
  costCenterId       String?  @map("cost_center_id")
  projectId          String?  @map("project_id")
  forecastScenarioId String?  @map("forecast_scenario_id")
  amount             Decimal  @db.Decimal(15, 2)
  startDate          DateTime @map("start_date")
