  closingBalance      Decimal   @map("closing_balance") @db.Decimal(15, 2)
  totalCharged        Decimal   @map("total_charged") @db.Decimal(15, 2)
  totalPaid           Decimal   @map("total_paid") @db.Decimal(15, 2)
