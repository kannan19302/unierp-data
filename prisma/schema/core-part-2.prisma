model Whiteboard {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  title         String
  width         Int      @default(1920)
  height        Int      @default(1080)
  background    String   @default("#FFFFFF")
  ownerId       String   @map("owner_id")
  collaborators Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  elements WhiteboardElement[]

  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@map("whiteboards")
}

model WhiteboardElement {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  whiteboardId String   @map("whiteboard_id")
  type         String   @default("RECTANGLE") // RECTANGLE, CIRCLE, TEXT, IMAGE, LINE, ARROW, FREEHAND, STICKY_NOTE
  properties   Json     @default("{}") // {x, y, width, height, color, content, rotation, etc.}
  sortOrder    Int      @default(0) @map("sort_order")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  whiteboard Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  @@index([tenantId, whiteboardId])
  @@map("whiteboard_elements")
}

model CommSurvey {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  title         String
  description   String?   @db.Text
  status        String    @default("DRAFT") // DRAFT, PUBLISHED, CLOSED, ARCHIVED
  surveyType    String    @default("FEEDBACK") // FEEDBACK, NPS, CSAT, CUSTOM
  settings      Json      @default("{}") // {anonymous, allowMultiple, requireLogin, expiryDate}
  templateId    String?   @map("template_id")
  responseCount Int       @default(0) @map("response_count")
  createdBy     String    @map("created_by")
  publishedAt   DateTime? @map("published_at")
  closedAt      DateTime? @map("closed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  questions CommSurveyQuestion[]
  responses CommSurveyResponse[]
  template  CommSurveyTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("comm_surveys")
}

model CommSurveyQuestion {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  surveyId    String   @map("survey_id")
  type        String   @default("TEXT") // TEXT, TEXTAREA, RADIO, CHECKBOX, SELECT, RATING, NPS, DATE, FILE
  title       String   @db.Text
  description String?  @db.Text
  required    Boolean  @default(false)
  options     Json     @default("[]") // [{label, value}]
  validation  Json     @default("{}") // {min, max, regex}
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  survey  CommSurvey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers CommSurveyAnswer[]

  @@index([tenantId, surveyId])
  @@map("comm_survey_questions")
}

model CommSurveyResponse {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  surveyId        String   @map("survey_id")
  respondentId    String?  @map("respondent_id")
  respondentEmail String?  @map("respondent_email")
  metadata        Json     @default("{}") // {ip, userAgent, duration}
  completedAt     DateTime @default(now()) @map("completed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  survey  CommSurvey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers CommSurveyAnswer[]

  @@index([tenantId, surveyId])
  @@map("comm_survey_responses")
}

model CommSurveyAnswer {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  responseId String   @map("response_id")
  questionId String   @map("question_id")
  value      Json // String, Number, Array, or Object depending on question type
  createdAt  DateTime @default(now()) @map("created_at")

  response CommSurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question CommSurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, responseId, questionId])
  @@index([tenantId, responseId])
  @@map("comm_survey_answers")
}

model CommSurveyTemplate {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?  @db.Text
  category    String   @default("GENERAL") // GENERAL, NPS, CSAT, EMPLOYEE, CUSTOMER, TRAINING
  questions   Json     @default("[]") // Pre-defined questions structure
  settings    Json     @default("{}")
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  surveys CommSurvey[]

  @@index([tenantId])
  @@map("comm_survey_templates")
}

model POSTerminal {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  orgId              String   @map("org_id")
  name               String
  code               String
  warehouseId        String?  @map("warehouse_id")
  status             String   @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  receiptTemplate    String?  @map("receipt_template") @db.Text
  layoutFormat       String?  @map("layout_format") // THERMAL_80MM, THERMAL_58MM, A4_INVOICE
  diagnosticData     Json?    @map("diagnostic_data")
  currency           String   @default("USD")
  taxProfileId       String?  @map("tax_profile_id")
  priceListId        String?  @map("price_list_id")
  defaultCustomerId  String?  @map("default_customer_id")
  allowDiscount      Boolean  @default(true) @map("allow_discount")
  maxDiscountPercent Decimal  @default(100) @map("max_discount_percent") @db.Decimal(5, 2)
  enableTipping      Boolean  @default(false) @map("enable_tipping")
  posProfile         Json     @default("{}") @map("pos_profile") // JSON config blob
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  registers  POSRegister[]
  quickKeys  POSQuickKey[]
  taxProfile POSTaxProfile? @relation(fields: [taxProfileId], references: [id])
  priceList  POSPriceList?  @relation(fields: [priceListId], references: [id])
  orders     POSOrder[]

  @@unique([tenantId, orgId, code])
  @@index([tenantId])
  @@map("pos_terminals")
}

model POSRegister {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  terminalId        String    @map("terminal_id")
  openedById        String    @map("opened_by_id")
  openedAt          DateTime  @default(now()) @map("opened_at")
  closedAt          DateTime? @map("closed_at")
  startingCash      Decimal   @map("starting_cash") @db.Decimal(15, 2)
  endingCash        Decimal?  @map("ending_cash") @db.Decimal(15, 2)
  actualCash        Decimal?  @map("actual_cash") @db.Decimal(15, 2)
  closingDifference Decimal?  @map("closing_difference") @db.Decimal(15, 2)
  totalSales        Decimal   @default(0) @map("total_sales") @db.Decimal(15, 2)
  totalReturns      Decimal   @default(0) @map("total_returns") @db.Decimal(15, 2)
  totalTransactions Int       @default(0) @map("total_transactions")
  status            String    @default("OPEN") // OPEN, CLOSED
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  terminal    POSTerminal @relation(fields: [terminalId], references: [id])
  shifts      POSShift[]
  cashEntries CashEntry[]
  orders      POSOrder[]

  @@index([tenantId])
  @@map("pos_registers")
}

model POSShift {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  registerId   String    @map("register_id")
  employeeId   String    @map("employee_id")
  startTime    DateTime  @default(now()) @map("start_time")
  endTime      DateTime? @map("end_time")
  totalSales   Decimal   @default(0) @map("total_sales") @db.Decimal(15, 2)
  totalReturns Decimal   @default(0) @map("total_returns") @db.Decimal(15, 2)
  cashIn       Decimal   @default(0) @map("cash_in") @db.Decimal(15, 2)
  cashOut      Decimal   @default(0) @map("cash_out") @db.Decimal(15, 2)
  notes        String?
  status       String    @default("OPEN") // OPEN, CLOSED

  register     POSRegister           @relation(fields: [registerId], references: [id], onDelete: Cascade)
  orders       POSOrder[]
  cashDrawers  PosShiftCashDrawer[]
  transactions PosShiftTransaction[]

  @@index([tenantId])
  @@map("pos_shifts")
}

model CashEntry {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  registerId String   @map("register_id")
  type       String   @default("IN") // IN, OUT
  amount     Decimal  @db.Decimal(15, 2)
  reason     String?
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  register POSRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("cash_entries")
}

model POSOrder {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  orgId               String   @map("org_id")
  orderNumber         String   @map("order_number")
  type                String   @default("SALE") // SALE, RETURN, EXCHANGE
  status              String   @default("COMPLETED") // DRAFT, COMPLETED, VOIDED, HELD, PARTIAL_RETURN
  customerId          String?  @map("customer_id")
  customerName        String?  @map("customer_name")
  terminalId          String   @map("terminal_id")
  registerId          String?  @map("register_id")
  shiftId             String?  @map("shift_id")
  cashierId           String   @map("cashier_id")
  cashierName         String?  @map("cashier_name")
  subtotal            Decimal  @default(0) @db.Decimal(15, 2)
  discountType        String?  @map("discount_type") // PERCENTAGE, FIXED
  discountValue       Decimal  @default(0) @map("discount_value") @db.Decimal(15, 2)
  discountAmount      Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxAmount           Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  roundingAmount      Decimal  @default(0) @map("rounding_amount") @db.Decimal(15, 2)
  grandTotal          Decimal  @default(0) @map("grand_total") @db.Decimal(15, 2)
  paidAmount          Decimal  @default(0) @map("paid_amount") @db.Decimal(15, 2)
  changeAmount        Decimal  @default(0) @map("change_amount") @db.Decimal(15, 2)
  tipAmount           Decimal  @default(0) @map("tip_amount") @db.Decimal(15, 2)
  loyaltyPointsEarned Int      @default(0) @map("loyalty_points_earned")
  loyaltyPointsUsed   Int      @default(0) @map("loyalty_points_used")
  couponCode          String?  @map("coupon_code")
  notes               String?
  receiptData         Json?    @map("receipt_data") // snapshot of receipt at time of sale
  originalOrderId     String?  @map("original_order_id") // for returns
