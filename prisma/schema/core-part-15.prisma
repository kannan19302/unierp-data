model DocumentRecentItem {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  documentId String   @map("document_id")
  userId     String   @map("user_id")
  lastViewed DateTime @default(now()) @map("last_viewed")
  viewCount  Int      @default(1) @map("view_count")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, documentId])
  @@index([tenantId, userId, lastViewed])
  @@map("document_recent_items")
}

model DocumentWatermark {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  documentId String   @map("document_id")
  text       String
  opacity    Float    @default(0.3)
  position   String   @default("CENTER") // CENTER, TOP_LEFT, TOP_RIGHT, BOTTOM_LEFT, BOTTOM_RIGHT, TILED
  rotation   Int      @default(-45)
  fontSize   Int      @default(48)
  color      String   @default("#000000")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentId])
  @@map("document_watermarks")
}

model StorageEncryption {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  fileId       String   @map("file_id")
  algorithm    String   @default("AES-256-GCM")
  keyId        String   @map("key_id")
  encryptedKey String   @map("encrypted_key")
  status       String   @default("ENCRYPTED") // ENCRYPTED, DECRYPTED, PENDING
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, fileId])
  @@map("storage_encryptions")
}

model StorageReplication {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  fileId         String   @map("file_id")
  sourceBucket   String   @map("source_bucket")
  targetBucket   String   @map("target_bucket")
  targetRegion   String?  @map("target_region")
  status         String   @default("PENDING") // PENDING, REPLICATING, COMPLETED, FAILED
  lastReplicated DateTime? @map("last_replicated")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([tenantId, fileId])
  @@map("storage_replications")
}

model StorageBackup {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  type        String   @default("FULL") // FULL, INCREMENTAL, DIFFERENTIAL
  status      String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  fileUrl     String?  @map("file_url")
  fileSize    BigInt?  @map("file_size")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("storage_backups")
}

model StorageAnalytic {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  date        DateTime @map("date")
  totalFiles  Int      @default(0) @map("total_files")
  totalSize   BigInt   @default(0) @map("total_size")
  fileTypes   Json     @default("{}") // {"pdf": 10, "docx": 5}
  activeUsers Int      @default(0) @map("active_users")
  operations  Int      @default(0) // read/write/delete count
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tenantId, date])
  @@map("storage_analytics")
}

model StorageAlert {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  metric    String   // storage_used, file_count, bandwidth, error_rate
  condition String   // gt, lt, gte, lte, eq
  threshold Float
  enabled   Boolean  @default(true)
  lastTriggered DateTime? @map("last_triggered")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("storage_alerts")
}

model StorageMigration {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  name           String
  sourceProvider String   @map("source_provider")
  targetProvider String   @map("target_provider")
  fileCount      Int      @default(0) @map("file_count")
  totalSize      BigInt   @default(0) @map("total_size")
  status         String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, ROLLED_BACK
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  errorLog       Json?    @map("error_log")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("storage_migrations")
}

model StorageCompression {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  fileId         String   @map("file_id")
  algorithm      String   @default("GZIP") // GZIP, BROTLI, ZSTD
  originalSize   BigInt   @map("original_size")
  compressedSize BigInt   @map("compressed_size")
  ratio          Float
  status         String   @default("COMPRESSED") // COMPRESSED, DECOMPRESSED, PENDING
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, fileId])
  @@map("storage_compressions")
}

model StorageDeduplication {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  fileHash     String   @map("file_hash")
  fileCount    Int      @default(1) @map("file_count")
  totalSize    BigInt   @map("total_size")
  savedSize    BigInt   @map("saved_size")
  status       String   @default("ACTIVE") // ACTIVE, ANALYZING, MERGED
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, fileHash])
  @@map("storage_deduplications")
}

model StorageSnapshot {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  type        String   @default("MANUAL") // MANUAL, SCHEDULED, AUTOMATIC
  status      String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  fileCount   Int      @default(0) @map("file_count")
  totalSize   BigInt   @default(0) @map("total_size")
  metadata    Json?    @default("{}")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("storage_snapshots")
}

model StorageRetentionPolicy {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  name              String
  description       String?
  retentionDays     Int      @map("retention_days")
  action            String   @default("DELETE") // DELETE, ARCHIVE, GLACIER
  fileTypes         Json?    @default("[]") // Apply to specific file types only; empty = all
  enabled           Boolean  @default(true)
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("storage_retention_policies")
}

model StorageComplianceLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  policyId   String?  @map("policy_id")
  fileId     String   @map("file_id")
  action     String   // COMPLIANT, NON_COMPLIANT, ENFORCED, EXEMPTED
  details    Json?
  checkedAt  DateTime @default(now()) @map("checked_at")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, fileId])
  @@index([tenantId, action])
  @@map("storage_compliance_logs")
}

model StorageCache {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  fileId       String   @map("file_id")
  cacheKey     String   @map("cache_key")
  cacheType    String   @default("THUMBNAIL") // THUMBNAIL, PREVIEW, METADATA, CONTENT
  fileSize     Int?     @map("file_size")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  lastAccessed DateTime @default(now()) @map("last_accessed")

  @@index([tenantId, fileId, cacheType])
  @@index([tenantId, expiresAt])
  @@map("storage_caches")
}

model StorageSync {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  name           String
  sourceProvider String   @map("source_provider")
  targetProvider String   @map("target_provider")
  syncDirection  String   @default("BIDIRECTIONAL") // PUSH, PULL, BIDIRECTIONAL
  schedule       String?  // cron expression
  lastSyncedAt   DateTime? @map("last_synced_at")
  status         String   @default("ACTIVE") // ACTIVE, PAUSED, ERROR
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("storage_syncs")
}

model WorkflowTemplate {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  category    String?
  triggerType String   @default("MANUAL")
  nodes       Json     @default("[]")
  edges       Json     @default("[]")
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId, category])
  @@map("workflow_templates")
}

model WorkflowCategory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  color       String?  @default("#1976D2")
  icon        String?  @default("folder")
  sortOrder   Int      @default(0) @map("sort_order")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tenantId, name])
  @@map("workflow_categories")
}

model WorkflowVersion {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  definitionId String   @map("definition_id")
  version      Int      @default(1)
  nodes        Json     @default("[]")
  edges        Json     @default("[]")
  settings     Json?    @default("{}")
  changeLog    String?  @map("change_log")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, definitionId, version])
  @@index([tenantId, definitionId])
  @@map("workflow_versions")
}

model WorkflowCondition {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  definitionId String   @map("definition_id")
  name         String
  field        String
  operator     String   // equals, not_equals, contains, greater_than, less_than, in, not_in, between
  value        Json
  logicGroup   String?  @default("AND") @map("logic_group")
  sortOrder    Int      @default(0) @map("sort_order")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, definitionId])
  @@map("workflow_conditions")
}

model WorkflowLoop {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  definitionId String   @map("definition_id")
  name         String
  loopField    String   @map("loop_field") // JSON array field to iterate over
  maxIterations Int     @default(100) @map("max_iterations")
  breakOn      String?  @map("break_on") // Condition to break early
  sortOrder    Int      @default(0) @map("sort_order")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, definitionId])
  @@map("workflow_loops")
}

model WorkflowSubprocess {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  parentDefinitionId String @map("parent_definition_id")
  childDefinitionId  String @map("child_definition_id")
  name            String
  inputMapping    Json     @default("{}") @map("input_mapping")
  outputMapping   Json     @default("{}") @map("output_mapping")
  sortOrder       Int      @default(0) @map("sort_order")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  parent WorkflowDefinition @relation("ParentSubprocess", fields: [parentDefinitionId], references: [id], onDelete: Cascade)
  child  WorkflowDefinition @relation("ChildSubprocess", fields: [childDefinitionId], references: [id])

  @@index([tenantId, parentDefinitionId])
  @@map("workflow_subprocesses")
}

model WorkflowErrorHandler {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  definitionId String   @map("definition_id")
  name         String
  onError      String   @default("ABORT") // ABORT, RETRY, SKIP, NOTIFY, ROUTE
  retryCount   Int      @default(3) @map("retry_count")
  retryDelay   Int      @default(60) @map("retry_delay") // seconds
  notifyRoles  String?  @map("notify_roles")
  routeToNode  String?  @map("route_to_node")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, definitionId])
  @@map("workflow_error_handlers")
}

model WorkflowNotification {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  definitionId String   @map("definition_id")
  event        String   // ON_START, ON_COMPLETE, ON_FAILURE, ON_SLA_BREACH, ON_ESCALATION
  channel      String   @default("IN_APP") // IN_APP, EMAIL, SMS, SLACK, WEBHOOK
  recipients   Json     @default("[]") // roles or user IDs
  template     String?
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, definitionId])
  @@map("workflow_notifications")
}

model WorkflowWebhook {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  definitionId String   @map("definition_id")
  url          String
  method       String   @default("POST")
  headers      Json     @default("{}")
  bodyTemplate String?  @map("body_template")
  secret       String?
  retryCount   Int      @default(3) @map("retry_count")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, definitionId])
  @@map("workflow_webhooks")
}

model WorkflowMetric {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  definitionId String   @map("definition_id")
  date         DateTime @map("date")
  executions   Int      @default(0)
  avgDuration  Int      @default(0) @map("avg_duration") // seconds
  successCount Int      @default(0) @map("success_count")
  failureCount Int      @default(0) @map("failure_count")
  avgSlaPct    Float?   @map("avg_sla_pct")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, definitionId, date])
  @@map("workflow_metrics")
}

model WorkflowTag {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  color     String?  @default("#1976D2")
  createdBy      String                   @map("created_by")
  createdAt      DateTime                 @default(now()) @map("created_at")
  tagAssignments WorkflowTagAssignment[]

  @@unique([tenantId, name])
  @@map("workflow_tags")
}

model WorkflowTagAssignment {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tagId        String   @map("tag_id")
  definitionId String   @map("definition_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tag        WorkflowTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tagId, definitionId])
  @@index([tenantId, definitionId])
  @@map("workflow_tag_assignments")
}
