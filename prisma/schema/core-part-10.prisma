model SaasApp {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  name             String
  slug             String
  description      String?  @db.Text
  shortDescription String?  @map("short_description")
  icon             String?
  banner           String?
  category         String?
  publisher        String?
  website          String?
  docsUrl          String?  @map("docs_url")
  supportUrl       String?  @map("support_url")
  pricingUrl       String?  @map("pricing_url")
  privacyUrl       String?  @map("privacy_url")
  termsUrl         String?  @map("terms_url")
  isPublished      Boolean  @default(false) @map("is_published")
  isFeatured       Boolean  @default(false) @map("is_featured")
  isFree           Boolean  @default(false) @map("is_free")
  price            Decimal  @default(0)
  setupFee         Decimal  @default(0) @map("setup_fee")
  billingMode      String   @default("ONE_TIME") // ONE_TIME, MONTHLY, YEARLY, FREE
  trialDays        Int      @default(0) @map("trial_days")
  permissions      Json     @default("[]")
  tags             String[] @default([])
  screenshots      Json     @default("[]")
  rating           Decimal  @default(0)
  installCount     Int      @default(0) @map("install_count")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  versions       SaasAppVersion[]
  installations  SaasAppInstallation[]
  permissionsRel SaasAppPermission[]

  @@index([tenantId])
  @@index([slug])
  @@index([isPublished])
  @@map("saas_apps")
}

model SaasAppVersion {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  appId         String    @map("app_id")
  version       String
  changelog     String?   @db.Text
  minApiVersion String?   @map("min_api_version")
  maxApiVersion String?   @map("max_api_version")
  isPublished   Boolean   @default(false) @map("is_published")
  releaseDate   DateTime? @map("release_date")
  downloadUrl   String?   @map("download_url")
  fileSize      Int?      @map("file_size")
  checksum      String?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  app           SaasApp               @relation(fields: [appId], references: [id], onDelete: Cascade)
  installations SaasAppInstallation[]

  @@index([tenantId])
  @@index([appId])
  @@map("saas_app_versions")
}

model SaasAppInstallation {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  appId              String    @map("app_id")
  installingTenantId String    @map("installing_tenant_id")
  versionId          String?   @map("version_id")
  status             String    @default("INSTALLING") // INSTALLING, ACTIVE, SUSPENDED, UNINSTALLED
  permissions        Json      @default("[]")
  settings           Json      @default("{}")
  installedBy        String    @map("installed_by")
  installedAt        DateTime  @default(now()) @map("installed_at")
  uninstalledAt      DateTime? @map("uninstalled_at")
  createdAt          DateTime  @default(now()) @map("created_at")
