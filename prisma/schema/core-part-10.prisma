model EcommerceOrder {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  storeId         String    @map("store_id")
  orderNumber     String    @unique @map("order_number")
  customerId      String?   @map("customer_id")
  customerEmail   String?   @map("customer_email")
  customerName    String?   @map("customer_name")
  customerPhone   String?   @map("customer_phone")
  status          String    @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  billingAddress  Json?     @map("billing_address")
  shippingAddress Json?     @map("shipping_address")
  shippingMethod  String?   @map("shipping_method")
  shippingAmount  Decimal   @default(0) @map("shipping_amount")
  subtotal        Decimal
  discountAmount  Decimal   @default(0) @map("discount_amount")
  taxAmount       Decimal   @default(0) @map("tax_amount")
  grandTotal      Decimal   @map("grand_total")
  paidAmount      Decimal   @default(0) @map("paid_amount")
  changeAmount    Decimal   @default(0) @map("change_amount")
  currency        String    @default("USD")
  couponCode      String?   @map("coupon_code")
  notes           String?
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason")
  deliveredAt     DateTime? @map("delivered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  store     EcommerceStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     EcommerceOrderItem[]
  payments  EcommercePayment[]
  shipments EcommerceShipment[]
  returns   EcommerceReturn[]
  reviews   EcommerceReview[]

  @@index([tenantId])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([orderNumber])
  @@map("ecommerce_orders")
}

model EcommerceOrderItem {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  orderId        String   @map("order_id")
  variantId      String?  @map("variant_id")
  productName    String   @map("product_name")
  sku            String
  quantity       Int
  unitPrice      Decimal  @map("unit_price")
  discountAmount Decimal  @default(0) @map("discount_amount")
  taxAmount      Decimal  @default(0) @map("tax_amount")
  lineTotal      Decimal  @map("line_total")
  createdAt      DateTime @default(now()) @map("created_at")

  order   EcommerceOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
