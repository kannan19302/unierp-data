  updatedAt         DateTime  @updatedAt @map("updated_at")

  order EcommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@map("ecommerce_shipments")
}

model EcommerceReturn {
