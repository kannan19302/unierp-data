model EcommerceProductVariant {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  listingId      String   @map("listing_id")
  sku            String
  title          String
  attributes     Json     @default("{}")
  price          Decimal
  compareAtPrice Decimal? @map("compare_at_price")
  costPrice      Decimal? @map("cost_price")
  weight         Decimal? @map("weight")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  listing       EcommerceProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  inventory     EcommerceInventory[]
  cartItems     EcommerceCartItem[]
  orderItems    EcommerceOrderItem[]
  wishlistItems EcommerceWishlistItem[]

  @@index([tenantId])
  @@index([listingId])
  @@index([sku])
  @@map("ecommerce_product_variants")
}

model EcommerceInventory {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  variantId String   @map("variant_id")
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  location  String?  @map("location")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant EcommerceProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([variantId])
  @@map("ecommerce_inventory")
}

model EcommerceCart {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  storeId        String   @map("store_id")
  sessionId      String   @map("session_id")
  customerId     String?  @map("customer_id")
  couponCode     String?  @map("coupon_code")
  subtotal       Decimal  @default(0)
  discount       Decimal  @default(0)
