model SaasSubscription {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  subscribingTenantId String    @map("subscribing_tenant_id")
  planId              String    @map("plan_id")
  status              String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED, EXPIRED, TRIALING
  quantity            Int       @default(1)
  unitPrice           Decimal   @map("unit_price")
  totalPrice          Decimal   @map("total_price")
  currency            String    @default("USD")
  billingInterval     String    @default("MONTHLY") // MONTHLY, YEARLY, QUARTERLY
  trialEndsAt         DateTime? @map("trial_ends_at")
  currentPeriodStart  DateTime? @map("current_period_start")
  currentPeriodEnd    DateTime? @map("current_period_end")
  canceledAt          DateTime? @map("canceled_at")
  cancelReason        String?   @map("cancel_reason")
  activatedAt         DateTime? @map("activated_at")
  expiresAt           DateTime? @map("expires_at")
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  plan               SaasSubscriptionPlan       @relation(fields: [planId], references: [id])
