model EmailSequence {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  orgId       String    @map("org_id")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  steps           EmailSequenceStep[]
  enrollments     EmailSequenceEnrollment[]
  autoEnrollRules CadenceAutoEnrollRule[]

  @@index([tenantId])
  @@map("email_sequences")
}

model EmailSequenceStep {
  id           String  @id @default(cuid())
  sequenceId   String  @map("sequence_id")
  templateId   String? @map("template_id")
  channel      String  @default("EMAIL") @map("channel") // EMAIL, CALL, TASK, LINKEDIN
  subject      String?
  instructions String?
  delayDays    Int     @default(1) @map("delay_days")
  sortOrder    Int     @default(0) @map("sort_order")

  sequence EmailSequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  tasks    CadenceStepTask[]

  @@index([sequenceId])
  @@map("email_sequence_steps")
}

model EmailSequenceEnrollment {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  sequenceId  String    @map("sequence_id")
  contactId   String?   @map("contact_id")
  leadId      String?   @map("lead_id")
  currentStep Int       @default(0) @map("current_step")
  status      String    @default("ACTIVE")
  nextSendAt  DateTime? @map("next_send_at")
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")

  sequence EmailSequence     @relation(fields: [sequenceId], references: [id])
  tasks    CadenceStepTask[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("email_sequence_enrollments")
}

model CadenceAutoEnrollRule {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  orgId      String    @map("org_id")
  sequenceId String    @map("sequence_id")
  name       String
  entityType String    @default("LEAD") @map("entity_type") // LEAD, CONTACT
  conditions Json      @default("{}")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("cadence_auto_enroll_rules")
}

model CadenceStepTask {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  enrollmentId String    @map("enrollment_id")
  stepId       String    @map("step_id")
  channel      String
  status       String    @default("PENDING") // PENDING, COMPLETED, SKIPPED
  dueAt        DateTime  @map("due_at")
  completedAt  DateTime? @map("completed_at")
  completedBy  String?   @map("completed_by")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  enrollment EmailSequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       EmailSequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([enrollmentId])
  @@map("cadence_step_tasks")
}

model SalesTerritory {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  orgId       String    @map("org_id")
