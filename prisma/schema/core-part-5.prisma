model ReorderRule {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  productId         String    @map("product_id")
  warehouseId       String?   @map("warehouse_id")
  minQty            Decimal   @map("min_qty") @db.Decimal(15, 3)
  maxQty            Decimal?  @map("max_qty") @db.Decimal(15, 3)
  reorderQty        Decimal   @map("reorder_qty") @db.Decimal(15, 3)
  leadTimeDays      Int       @default(0) @map("lead_time_days")
  preferredVendorId String?   @map("preferred_vendor_id")
  isActive          Boolean   @default(true) @map("is_active")
