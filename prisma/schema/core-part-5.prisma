model DemandForecastRun {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  orgId        String    @map("org_id")
  name         String
  method       String    @default("MOVING_AVERAGE") // MOVING_AVERAGE, EXPONENTIAL_SMOOTHING
  parameters   Json      @default("{}") // e.g. { windowDays, alpha, horizonDays, historyDays }
  status       String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  warehouseId  String?   @map("warehouse_id")
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?           @relation(fields: [warehouseId], references: [id])
  lines        DemandForecastLine[]
  suggestions  ReorderSuggestion[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, warehouseId])
  @@map("demand_forecast_runs")
}

model DemandForecastLine {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  runId              String   @map("run_id")
  productId          String   @map("product_id")
  warehouseId        String   @map("warehouse_id")
  period             DateTime // start date of the forecasted bucket (daily bucket)
  historicalAvgQty   Decimal  @default(0) @map("historical_avg_qty") @db.Decimal(15, 3)
  forecastedQuantity Decimal  @map("forecasted_quantity") @db.Decimal(15, 3)
  confidence         Decimal  @default(0) @db.Decimal(5, 2) // 0-100
  createdAt          DateTime @default(now()) @map("created_at")

  run       DemandForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id])
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([runId])
  @@index([tenantId, productId, warehouseId])
  @@map("demand_forecast_lines")
}

model ReorderSuggestion {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  runId             String    @map("run_id")
  productId         String    @map("product_id")
  warehouseId       String    @map("warehouse_id")
  reorderPoint      Decimal   @map("reorder_point") @db.Decimal(15, 3)
  suggestedQuantity Decimal   @map("suggested_quantity") @db.Decimal(15, 3)
  currentStockQty   Decimal   @default(0) @map("current_stock_qty") @db.Decimal(15, 3)
  basis             String    @default("FORECAST") // FORECAST
  status            String    @default("PENDING") // PENDING, ACCEPTED, DISMISSED
  decidedBy         String?   @map("decided_by")
  decidedAt         DateTime? @map("decided_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  run       DemandForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id])
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([runId])
  @@index([tenantId, productId, warehouseId])
  @@map("reorder_suggestions")
}

