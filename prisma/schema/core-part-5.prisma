  customerIds    Json      @default("[]") @map("customer_ids")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  coupons SalesCoupon[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("sales_promotions")
}

model SalesCoupon {
  id                        String   @id @default(cuid())
  tenantId                  String   @map("tenant_id")
  promotionId               String   @map("promotion_id")
  code                      String
  usageLimit                Int?     @map("usage_limit")
  usedCount                 Int      @default(0) @map("used_count")
  isActive                  Boolean  @default(true) @map("is_active")
  maxRedemptionsPerCustomer Int?     @map("max_redemptions_per_customer")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  promotion SalesPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("sales_coupons")
}

model SalesPartnerTier {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  orgId          String   @map("org_id")
  name           String
  description    String?
  commissionRate Decimal  @map("commission_rate") @db.Decimal(5, 2)
  minRevenue     Decimal? @map("min_revenue") @db.Decimal(15, 2)
  benefits       Json     @default("{}")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  partners SalesPartner[]

  @@index([tenantId])
  @@map("sales_partner_tiers")
}

model SalesPartner {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  orgId            String    @map("org_id")
  tierId           String?   @map("tier_id")
  name             String
  email            String?
  phone            String?
  website          String?
  address          Json?     @default("{}")
  commissionRate   Decimal?  @map("commission_rate") @db.Decimal(5, 2)
  referralCode     String?   @map("referral_code")
  status           String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  type             String    @default("RESELLER") // RESELLER, AFFILIATE, DISTRIBUTOR, REFERRAL
  totalRevenue     Decimal   @default(0) @map("total_revenue") @db.Decimal(15, 2)
  commissionEarned Decimal   @default(0) @map("commission_earned") @db.Decimal(15, 2)
  notes            String?
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tier                     SalesPartnerTier?              @relation(fields: [tierId], references: [id], onDelete: SetNull)
  dealRegistrations        SalesPartnerDealRegistration[]
  mdfFunds                 SalesPartnerMdfFund[]
  partnerDealRegistrations PartnerDealRegistration[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("sales_partners")
}

model StorefrontConfig {
  id           String   @id @default(cuid())
  tenantId     String   @unique @map("tenant_id")
  storeName    String   @map("store_name")
  storeSlug    String   @unique @map("store_slug") // public URL routing: /store/[storeSlug]
  isEnabled    Boolean  @default(false) @map("is_enabled")
  currency     String   @default("USD")
  contactEmail String?  @map("contact_email")
  logoUrl      String?  @map("logo_url")
  primaryColor String?  @map("primary_color")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("storefront_configs")
}

model StorefrontCategory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  listings ProductListing[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("storefront_categories")
}

model Cart {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  sessionToken String   @unique @map("session_token") // opaque random token, no customer auth
  status       String   @default("ACTIVE") @map("status") // ACTIVE, CONVERTED, ABANDONED
  currency     String   @default("USD")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("carts")
}

model CartItem {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  cartId            String   @map("cart_id")
  productListingId  String   @map("product_listing_id")
  quantity          Int
  unitPriceSnapshot Decimal  @map("unit_price_snapshot") @db.Decimal(15, 2) // captured at add-time
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productListing ProductListing @relation(fields: [productListingId], references: [id])

  @@index([tenantId])
  @@index([cartId])
  @@map("cart_items")
}

model StorefrontOrderPayment {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  salesOrderId     String   @map("sales_order_id")
  provider         String   @default("mock_gateway") // "mock_gateway" for MVP; real gateways are a drop-in swap
  providerIntentId String   @map("provider_intent_id")
  status           String   @default("PENDING") // PENDING, SUCCEEDED, FAILED, REFUNDED
  amount           Decimal  @db.Decimal(15, 2)
  currency         String   @default("USD")
  rawResponse      Json?    @map("raw_response") // whatever the gateway adapter returns, for reconciliation
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, salesOrderId])
  @@map("storefront_order_payments")
}

model StorefrontCheckoutState {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  storefrontSlug String   @map("storefront_slug")
  cartId         String   @map("cart_id")
  status         String   @default("CHECKOUT_INITIATED") // CHECKOUT_INITIATED, ORDER_CREATING, ORDER_COMPLETED, ORDER_FAILED
  salesOrderId   String?  @map("sales_order_id")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([tenantId, cartId])
  @@index([tenantId, status])
  @@map("storefront_checkout_states")
}

model FixedAssetCategory {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  name                  String
  description           String?
  depreciationMethod    String   @default("STRAIGHT_LINE") // STRAIGHT_LINE, DOUBLE_DECLINING
  expectedLifeMonths    Int      @map("expected_life_months")
  depreciationRate      Decimal? @map("depreciation_rate") @db.Decimal(5, 2)
  assetAccountId        String?  @map("asset_account_id")
  depreciationAccountId String?  @map("depreciation_account_id")
  expenseAccountId      String?  @map("expense_account_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  assets FixedAsset[]
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("fixed_asset_categories")
}

model AssetTransferLog {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  assetId         String   @map("asset_id")
  transferDate    DateTime @map("transfer_date")
  fromLocationId  String?  @map("from_location_id")
  toLocationId    String?  @map("to_location_id")
  fromCustodianId String?  @map("from_custodian_id")
  toCustodianId   String?  @map("to_custodian_id")
  reason          String?
  performedBy     String   @map("performed_by")
  createdAt       DateTime @default(now()) @map("created_at")

  asset  FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
  @@map("asset_transfer_logs")
}

model AssetMaintenanceLog {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  assetId             String    @map("asset_id")
  maintenanceDate     DateTime  @map("maintenance_date")
  type                String    @default("PREVENTIVE")
  description         String
  cost                Decimal   @db.Decimal(15, 2)
  performedBy         String    @map("performed_by")
  nextMaintenanceDate DateTime? @map("next_maintenance_date")
  createdAt           DateTime  @default(now()) @map("created_at")

  asset  FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
  @@map("asset_maintenance_logs")
}

model FixedAssetDisposal {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  assetId         String   @map("asset_id")
  disposalDate    DateTime @map("disposal_date")
  disposalType    String   // SALE, SCRAP, DONATION, THEFT
  salePrice       Decimal? @map("sale_price") @db.Decimal(15, 2)
  bookValueAtDisposal Decimal @map("book_value_at_disposal") @db.Decimal(15, 2)
  gainLoss        Decimal? @map("gain_loss") @db.Decimal(15, 2)
  reason          String?  @db.Text
  journalId       String?  @map("journal_id")
  approvedBy      String   @map("approved_by")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
  @@map("fixed_asset_disposals")
}
