  rules                      TerritoryAssignmentRule[]
  salesTerritoryForecasts    SalesTerritoryForecast[]
  salesTerritoryRealignments SalesTerritoryRealignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("sales_territories")
}

model SalesTeamMember {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
