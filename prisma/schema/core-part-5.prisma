model QuotationSignatureCertificate {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  signatureId       String   @unique @map("signature_id")
  certificateNumber String   @unique @map("certificate_number")
  documentHash      String   @map("document_hash")
  signerName        String   @map("signer_name")
  signerEmail       String   @map("signer_email")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  auditTrail        Json     @default("[]") @map("audit_trail")
  issuedAt          DateTime @default(now()) @map("issued_at")

  signature QuotationSignature @relation(fields: [signatureId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("quotation_signature_certificates")
}

model SalesPlaybook {
