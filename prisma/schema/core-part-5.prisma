  id            String   @id @default(cuid())
  vendorId      String   @map("vendor_id")
  /// Key identifier carried in a bundle signature.
  keyId         String   @unique @map("key_id")
  /// SPKI DER public key, base64. Only ever a PUBLIC key — the platform never
  /// holds a vendor private key and never signs on their behalf.
  publicKey     String   @map("public_key") @db.Text
  algorithm     String   @default("ed25519")
  /// Revocation is a state, not a delete: already-published bundles signed with
  /// this key must stay identifiable so they can be delisted.
  revoked       Boolean  @default(false)
  revokedReason String?  @map("revoked_reason")
  createdAt     DateTime @default(now()) @map("created_at")

