// ══════════════════════════════════════════════════════════════════════════════
// CRM Module — New Models for 2000+ Feature Enhancement (July 2026)
// Insert at end of schema.prisma, after SaasEmailLog model (line ~25118)
// ══════════════════════════════════════════════════════════════════════════════

// ── 1. ADVANCED CPQ & QUOTING ─────────────────────────────────────────────────

model ProductBundle {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  orgId       String   @map("org_id")
  name        String
  code        String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT
  validFrom   DateTime? @map("valid_from")
  validUntil  DateTime? @map("valid_until")
  rules       Json?    // bundling rules: {minItems, maxItems, requiredItems, discountType}
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items ProductBundleItem[]

  @@index([tenantId])
  @@map("product_bundles")
}

model ProductBundleItem {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  bundleId      String   @map("bundle_id")
  productId     String   @map("product_id")
  quantity      Int      @default(1)
  isMandatory   Boolean  @default(false) @map("is_mandatory")
  sortOrder     Int      @default(0) @map("sort_order")
  discountPct   Decimal? @map("discount_pct") @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  bundle ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bundleId])
  @@map("product_bundle_items")
}

model PricingRule {
  id            String     @id @default(cuid())
  tenantId      String     @map("tenant_id")
  orgId         String     @map("org_id")
  name          String
  ruleType      String     // VOLUME_DISCOUNT, TIERED_PRICING, CONTRACT_PRICE, PROMOTIONAL, BUNDLE
  priority      Int        @default(0)
  conditions    Json       // [{field, operator, value}] — e.g. {field:"quantity", operator:"gte", value:10}
  actions       Json       // [{type:"discount_pct", value:15}, {type:"fixed_price", value:99.99}]
  validFrom     DateTime?  @map("valid_from")
  validUntil    DateTime?  @map("valid_until")
  isActive      Boolean    @default(true) @map("is_active")
  appliedTo     String     @default("PRODUCT") // PRODUCT, BUNDLE, CATEGORY, ORDER
  targetId      String?    @map("target_id") // specific product/bundle/category ID
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("pricing_rules")
}

model QuoteVersion {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  orgId           String    @map("org_id")
  quotationId     String    @map("quotation_id")
  versionNumber   Int       @map("version_number")
  content         Json      // full snapshot of quote content at this version
  subtotal        Decimal   @db.Decimal(15, 2)
  totalDiscount   Decimal   @default(0) @map("total_discount") @db.Decimal(15, 2)
  grandTotal      Decimal   @db.Decimal(15, 2)
  createdBy       String    @map("created_by")
  changeNote      String?   @map("change_note")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([quotationId])
  @@map("quote_versions")
}

model QuoteMargin {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  quotationId     String   @map("quotation_id")
  totalCost       Decimal  @map("total_cost") @db.Decimal(15, 2)
  totalPrice      Decimal  @map("total_price") @db.Decimal(15, 2)
  marginAmount    Decimal  @map("margin_amount") @db.Decimal(15, 2)
  marginPct       Decimal  @map("margin_pct") @db.Decimal(5, 2)
  costBreakdown   Json?    @map("cost_breakdown") // [{item, cost, price, margin}]
  calculatedAt    DateTime @default(now()) @map("calculated_at")

  @@index([tenantId])
  @@index([quotationId])
  @@map("quote_margins")
}

// ── 2. CUSTOMER JOURNEY & 360 VIEW ──────────────────────────────────────────

model CustomerJourneyStage {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  sortOrder   Int      @default(0) @map("sort_order")
  description String?
  color       String?  // hex color for visualization
  createdAt   DateTime @default(now()) @map("created_at")

  events CustomerJourneyEvent[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("customer_journey_stages")
}

model CustomerJourneyEvent {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  customerId  String   @map("customer_id")
  stageId     String?  @map("stage_id")
  eventType   String   // LEAD_CREATED, OPPORTUNITY_CREATED, QUOTE_SENT, DEAL_WON, TICKET_OPENED, etc.
  source      String?  // EMAIL, CALL, CHAT, WEB, SOCIAL, REFERRAL
  description String?
  metadata    Json?    // additional event-specific data
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  stage CustomerJourneyStage? @relation(fields: [stageId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([stageId])
  @@map("customer_journey_events")
}

model NpsSurvey {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  question    String   @default("How likely are you to recommend us?")
  targetAudience String @default("ALL") // ALL, CUSTOMERS, SPECIFIC_SEGMENT
  segmentId   String?  @map("segment_id")
  sendAutomatically Boolean @default(false) @map("send_automatically")
  triggerEvent String? @map("trigger_event") // DEAL_CLOSED, TICKET_RESOLVED, RENEWAL
  delayDays   Int      @default(0) @map("delay_days")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  responses NpsResponse[]

  @@index([tenantId])
  @@map("nps_surveys")
}

model NpsResponse {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  surveyId   String   @map("survey_id")
  customerId String   @map("customer_id")
  score      Int      // 0-10
  category   String   // PROMOTER(9-10), PASSIVE(7-8), DETRACTOR(0-6)
  reason     String?
  source     String?  // EMAIL, PORTAL, IN_APP
  respondedAt DateTime @default(now()) @map("responded_at")

  survey NpsSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([surveyId])
  @@index([tenantId, customerId])
  @@map("nps_responses")
}

model ChurnPrediction {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  customerId     String   @map("customer_id")
  churnScore     Decimal  @map("churn_score") @db.Decimal(5, 2) // 0.00 - 1.00
  riskLevel      String   // LOW, MEDIUM, HIGH, CRITICAL
  primaryReason  String?  @map("primary_reason")
  contributingFactors Json? @map("contributing_factors") // [{factor, weight}]
  recommendedAction String? @map("recommended_action")
  modelVersion   String?  @map("model_version")
  predictedAt    DateTime @default(now()) @map("predicted_at")
  expiresAt      DateTime? @map("expires_at")

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("churn_predictions")
}

model ClvCalculation {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  customerId      String   @map("customer_id")
  clvAmount       Decimal  @map("clv_amount") @db.Decimal(15, 2)
  averageOrderValue Decimal @map("average_order_value") @db.Decimal(15, 2)
  purchaseFrequency Decimal @map("purchase_frequency") @db.Decimal(10, 2)
  customerLifespanMonths Int @map("customer_lifespan_months")
  predictedValue12Months Decimal? @map("predicted_value_12_months") @db.Decimal(15, 2)
  calculatedAt    DateTime @default(now()) @map("calculated_at")

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("clv_calculations")
}

model UpsellRecommendation {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  customerId      String   @map("customer_id")
  opportunityId   String?  @map("opportunity_id")
  recommendedProductId String @map("recommended_product_id")
  recommendationType String // CROSS_SELL, UPSELL, NEW_PRODUCT
  reason          String?
  confidenceScore Decimal  @map("confidence_score") @db.Decimal(5, 2)
  expectedRevenue Decimal? @map("expected_revenue") @db.Decimal(15, 2)
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, DISMISSED
  presentedAt     DateTime? @map("presented_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("upsell_recommendations")
}

// ── 3. FORECAST GOVERNANCE & DEAL DESK ──────────────────────────────────────

model ForecastAdjustment {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  orgId           String   @map("org_id")
  forecastId      String   @map("forecast_id")
  adjustedBy      String   @map("adjusted_by") // user ID of manager
  previousAmount  Decimal  @map("previous_amount") @db.Decimal(15, 2)
  adjustedAmount  Decimal  @map("adjusted_amount") @db.Decimal(15, 2)
  category        String   // COMMIT, BEST_CASE, PIPELINE, OMITTED
  reason          String?
  isRollup        Boolean  @default(false) @map("is_rollup") // true if this is a team rollup
  rollupTargetId  String?  @map("rollup_target_id") // team/user ID being rolled up
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([forecastId])
  @@map("forecast_adjustments")
}

model ForecastTeamRollup {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  managerId       String   @map("manager_id")
  period          String   // format: Q1-2026, FY2026
  teamMembers     Json     // [{userId, name, commit, bestCase, pipeline, quota}]
  totalCommit     Decimal  @map("total_commit") @db.Decimal(15, 2)
  totalBestCase   Decimal  @map("total_best_case") @db.Decimal(15, 2)
  totalPipeline   Decimal  @map("total_pipeline") @db.Decimal(15, 2)
  totalQuota      Decimal  @map("total_quota") @db.Decimal(15, 2)
  attainmentPct   Decimal  @map("attainment_pct") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, managerId, period])
  @@index([tenantId])
  @@map("forecast_team_rollups")
}

model DealDeskRequest {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  orgId           String    @map("org_id")
  opportunityId   String    @map("opportunity_id")
  requestType     String    // DISCOUNT, SPECIAL_TERMS, CONTRACT_DEVIATION, BUNDLE_PRICE
  currentValue    Decimal?  @map("current_value") @db.Decimal(15, 2)
  requestedValue  Decimal?  @map("requested_value") @db.Decimal(15, 2)
  discountPct     Decimal?  @map("discount_pct") @db.Decimal(5, 2)
  justification   String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, INFO_NEEDED
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewNotes     String?   @map("review_notes")
  escalatedTo     String?   @map("escalated_to")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([opportunityId])
  @@index([tenantId, status])
  @@map("deal_desk_requests")
}

model DealAlert {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  orgId           String   @map("org_id")
  opportunityId   String   @map("opportunity_id")
  alertType       String   // STAGE_STALL, CLOSE_DATE_SLIPPED, LOW_ACTIVITY, BUDGET_CHANGE, COMPETITOR_ACTIVITY
  severity        String   // INFO, WARNING, CRITICAL
  message         String
  metadata        Json?
  isRead          Boolean  @default(false) @map("is_read")
  acknowledgedAt  DateTime? @map("acknowledged_at")
  createdAt       DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([opportunityId])
  @@map("deal_alerts")
}

model DealAutomationRule {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  triggerEvent String  // STAGE_CHANGE, CLOSE_DATE_CHANGE, AMOUNT_CHANGE, NEW_NOTE
  conditions  Json     // [{field, operator, value}]
  actions     Json     // [{type:"assign_user", value:"userId"}, {type:"send_email", templateId:"..."}]
  isActive    Boolean  @default(true) @map("is_active")
  priority    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("deal_automation_rules")
}

// ── 4. EMAIL/ACTIVITY AUTO-CAPTURE ──────────────────────────────────────────

model EmailTrackingEvent {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  emailId     String?  @map("email_id")
  messageId   String?  @map("message_id")
  recipient   String
  eventType   String   // OPENED, CLICKED, BOUNCED, UNSUBSCRIBED, SPAM
  linkUrl     String?  @map("link_url")
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at")

  @@index([tenantId])
  @@index([tenantId, eventType])
  @@index([messageId])
  @@map("email_tracking_events")
}

model CalendarSyncLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  provider    String   // GOOGLE, OUTLOOK, EXCHANGE
  eventType   String   // MEETING_CREATED, MEETING_UPDATED, MEETING_CANCELLED
  externalId  String?  @map("external_id")
  activityId  String?  @map("activity_id") // linked Activity record
  status      String   // SYNCED, FAILED, SKIPPED
  errorLog    String?  @map("error_log")
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@index([tenantId])
  @@index([userId])
  @@map("calendar_sync_logs")
}

model EmailSequenceABTest {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  sequenceId      String   @map("sequence_id")
  name            String
  variantA        Json     // {stepId, subject, body, ...}
  variantB        Json     // {stepId, subject, body, ...}
  winner          String?  // A, B, TIE
  openedRateA     Decimal? @map("opened_rate_a") @db.Decimal(5, 2)
  openedRateB     Decimal? @map("opened_rate_b") @db.Decimal(5, 2)
  clickedRateA    Decimal? @map("clicked_rate_a") @db.Decimal(5, 2)
  clickedRateB    Decimal? @map("clicked_rate_b") @db.Decimal(5, 2)
  sampleSize      Int      @default(0) @map("sample_size")
  confidenceLevel Decimal? @map("confidence_level") @db.Decimal(5, 2)
  status          String   @default("RUNNING") // RUNNING, COMPLETED, FAILED
  startedAt       DateTime @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  @@index([tenantId])
  @@map("email_sequence_ab_tests")
}

// ── 5. CUSTOMER SUPPORT & SERVICE DESK ──────────────────────────────────────

model HelpCenterArticle {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  title         String
  slug          String
  content       String   @db.Text
  excerpt       String?
  categoryId    String?  @map("category_id")
  tags          Json?
  status        String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  viewCount     Int      @default(0) @map("view_count")
  helpfulCount  Int      @default(0) @map("helpful_count")
  notHelpfulCount Int    @default(0) @map("not_helpful_count")
  sortOrder     Int      @default(0) @map("sort_order")
  createdBy     String?  @map("created_by")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category HelpCenterCategory? @relation(fields: [categoryId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("help_center_articles")
}

model HelpCenterCategory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  slug        String
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")

  parent    HelpCenterCategory?  @relation("HelpCenterCategoryHierarchy", fields: [parentId], references: [id])
  children  HelpCenterCategory[] @relation("HelpCenterCategoryHierarchy")
  articles  HelpCenterArticle[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("help_center_categories")
}

model LiveChatSession {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  visitorId       String    @map("visitor_id")
  customerId      String?   @map("customer_id")
  contactId       String?   @map("contact_id")
  assignedAgentId String?   @map("assigned_agent_id")
  status          String    @default("ACTIVE") // ACTIVE, WAITING, CLOSED
  source          String    @default("WEB") // WEB, MOBILE, PORTAL
  pageUrl         String?   @map("page_url")
  browserInfo     Json?     @map("browser_info")
  rating          Int?      // 1-5
  durationSec     Int?      @map("duration_sec")
  transcript      Json?     // [{sender, message, timestamp}]
  tags            Json?
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([assignedAgentId])
  @@index([tenantId, status])
  @@map("live_chat_sessions")
}

model CsatSurvey {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  caseId      String   @map("case_id")
  customerId  String   @map("customer_id")
  score       Int      // 1-5
  category    String?  // SATISFIED, NEUTRAL, DISSATISFIED
  feedback    String?
  sentAt      DateTime @map("sent_at")
  respondedAt DateTime @default(now()) @map("responded_at")

  @@index([tenantId])
  @@index([caseId])
  @@map("csat_surveys")
}

model TicketMacro {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  category    String?  // GENERAL, BILLING, TECHNICAL, ACCOUNT
  actions     Json     // [{type:"set_status", value:"RESOLVED"}, {type:"add_note", value:"..."}]
  shortcut    String?  // keyboard shortcut e.g. ".r" for resolve
  isActive    Boolean  @default(true) @map("is_active")
  usageCount  Int      @default(0) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("ticket_macros")
}

model CaseEscalation {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  caseId      String   @map("case_id")
  escalatedBy String   @map("escalated_by")
  escalatedTo String   @map("escalated_to")
  reason      String
  priority    String   // URGENT, HIGH, NORMAL
  status      String   @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  resolution  String?
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([caseId])
  @@index([tenantId, status])
  @@map("case_escalations")
}

model AgentPerformance {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  agentId         String   @map("agent_id")
  period          String   // format: 2026-01, Q1-2026, FY2026
  casesResolved   Int      @default(0) @map("cases_resolved")
  avgResolutionHours Float? @map("avg_resolution_hours") @db.Decimal(10, 2)
  csatScore       Decimal? @map("csat_score") @db.Decimal(3, 2)
  firstResponseMins Float? @map("first_response_mins") @db.Decimal(10, 2)
  slaBreachCount  Int      @default(0) @map("sla_breach_count")
  chatsHandled    Int      @default(0) @map("chats_handled")
  avgChatDurationSec Int?  @map("avg_chat_duration_sec")
  customerFeedback Json?   @map("customer_feedback")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([agentId])
  @@index([tenantId, period])
  @@map("agent_performance")
}

// ── 6. SALES ENABLEMENT & CONTENT MANAGEMENT ────────────────────────────────

model ContentItem {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  title       String
  description String?
  type        String   // DOCUMENT, PRESENTATION, VIDEO, IMAGE, LINK, TEMPLATE
  categoryId  String?  @map("category_id")
  fileUrl     String?  @map("file_url")
  thumbnailUrl String? @map("thumbnail_url")
  tags        Json?
  metadata    Json?
  isPublic    Boolean  @default(false) @map("is_public")
  status      String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  version     Int      @default(1)
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category ContentCategory? @relation(fields: [categoryId], references: [id])

  @@index([tenantId])
  @@map("content_items")
}

model ContentCategory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")

  parent   ContentCategory? @relation("ContentCategoryHierarchy", fields: [parentId], references: [id])
  children ContentCategory[] @relation("ContentCategoryHierarchy")
  items    ContentItem[]

  @@index([tenantId])
  @@map("content_categories")
}

model ContentAnalytics {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  contentId   String   @map("content_id")
  viewCount   Int      @default(0) @map("view_count")
  downloadCount Int    @default(0) @map("download_count")
  shareCount  Int      @default(0) @map("share_count")
  avgTimeOnPageSec Int? @map("avg_time_on_page_sec")
  feedbackScore Decimal? @map("feedback_score") @db.Decimal(3, 2)
  associatedDealWon Int @default(0) @map("associated_deal_won")
