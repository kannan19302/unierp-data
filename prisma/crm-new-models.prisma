  @@index([campaignId])
  @@map("marketing_calendar_entries")
}

// ── 19. LANDING PAGES & WEB FORMS ───────────────────────────────────────────

model LandingPage {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  title         String
  slug          String
  content       String    @db.Text // HTML content
  campaignId    String?   @map("campaign_id")
  template      String?   // template identifier
  fields        Json?     // [{name, type, required}]
  submitAction  String?   @map("submit_action") // CREATE_LEAD, CREATE_CONTACT, REDIRECT
  redirectUrl   String?   @map("redirect_url")
  thankYouMessage String? @map("thank_you_message")
  metadata      Json?     // {seoTitle, seoDescription, ogImage}
  viewCount     Int       @default(0) @map("view_count")
  submissionCount Int     @default(0) @map("submission_count")
  isPublished   Boolean   @default(false) @map("is_published")
  publishedAt   DateTime? @map("published_at")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("landing_pages")
}

model FormSubmission {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  formId      String   @map("form_id")
  formType    String   // WEB_FORM, LANDING_PAGE
  data        Json     // submitted field values
  leadId      String?  @map("lead_id")
  metadata    Json?    // {ip, userAgent, referrer, pageUrl}
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([formId])
  @@map("form_submissions")
}

model AutoCaptureSetting {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  captureEmails  Boolean  @default(true) @map("capture_emails")
  captureCalendar Boolean @default(true) @map("capture_calendar")
  autoLinkEnabled Boolean @default(true) @map("auto_link_enabled")
  emailProviders Json?    @map("email_providers") // ["GMAIL", "OUTLOOK", "IMAP"]
  calendarProviders Json? @map("calendar_providers") // ["GOOGLE", "OUTLOOK"]
  syncIntervalMinutes Int @default(15) @map("sync_interval_minutes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("auto_capture_settings")
}

model WebVisitor {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  visitorId   String   @map("visitor_id")
  sessionId   String?  @map("session_id")
  leadId      String?  @map("lead_id")
  landingPage String?  @map("landing_page")
  referrer    String?
  source      String?  // ORGANIC, PAID, SOCIAL, EMAIL, DIRECT, REFERRAL
  campaignId  String?  @map("campaign_id")
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")
  country     String?
  city        String?
  pageViews   Int      @default(1) @map("page_views")
  timeOnSite  Int?     @default(0) @map("time_on_site") // seconds
  events      Json?    // [{type, timestamp, data}]
  firstSeen   DateTime @default(now()) @map("first_seen")
  lastSeen    DateTime @default(now()) @map("last_seen")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([visitorId])
  @@index([leadId])
  @@index([source])
  @@map("web_visitors")
}

model LinkedEmail {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  emailId   String   @map("email_id")
  messageId String?  @map("message_id")
  subject   String
  fromEmail String   @map("from_email")
  toEmail   String   @map("to_email")
  body      String?  @db.Text
  receivedAt DateTime @default(now()) @map("received_at")
  leadId    String?  @map("lead_id")
  contactId String?  @map("contact_id")
  customerId String? @map("customer_id")
  opportunityId String? @map("opportunity_id")
  isLinked  Boolean  @default(false) @map("is_linked")
  linkedAt  DateTime? @map("linked_at")
  linkedBy  String?  @map("linked_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([leadId])
  @@index([contactId])
  @@index([emailId])
  @@map("linked_emails")
}
