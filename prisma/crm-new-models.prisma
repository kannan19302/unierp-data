  createdAt DateTime @default(now()) @map("created_at")

  topic PortalForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([topicId])
  @@map("portal_forum_replies")
}

model PortalNotification {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  customerId  String    @map("customer_id")
  title       String
  message     String    @db.Text
  type        String    @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  link        String?
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, customerId, readAt])
  @@map("portal_notifications")
}

// ── 15. REVENUE INTELLIGENCE & DEAL ANALYTICS ───────────────────────────────

model RevenueIntelligenceDigest {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  period          String   // format: 2026-Q1, 2026-07
  totalPipeline   Decimal  @map("total_pipeline") @db.Decimal(15, 2)
  weightedPipeline Decimal @map("weighted_pipeline") @db.Decimal(15, 2)
  totalForecast   Decimal  @map("total_forecast") @db.Decimal(15, 2)
  totalBookings   Decimal  @map("total_bookings") @db.Decimal(15, 2)
  totalQuota      Decimal  @map("total_quota") @db.Decimal(15, 2)
  attainmentPct   Decimal  @map("attainment_pct") @db.Decimal(5, 2)
  winRate         Decimal  @map("win_rate") @db.Decimal(5, 2)
  avgDealSize     Decimal  @map("avg_deal_size") @db.Decimal(15, 2)
  avgSalesCycleDays Int   @map("avg_sales_cycle_days")
  topDeals        Json?    @map("top_deals") // [{id, name, amount, stage}]
  riskDeals       Json?    @map("risk_deals") // [{id, name, amount, risk}]
  generatedAt     DateTime @default(now()) @map("generated_at")

  @@index([tenantId])
  @@index([tenantId, period])
  @@map("revenue_intelligence_digests")
}

model SalesVelocityMetric {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  period            String   // format: 2026-01, Q1-2026
  avgCycleDays      Int      @default(0) @map("avg_cycle_days")
  avgStageDurationDays Json?  @map("avg_stage_duration_days") // {stage: days}
  winRate           Decimal  @map("win_rate") @db.Decimal(5, 2)
  avgDealSize       Decimal  @map("avg_deal_size") @db.Decimal(15, 2)
  dealsCreated       Int     @default(0) @map("deals_created")
  dealsWon          Int      @default(0) @map("deals_won")
  dealsLost         Int      @default(0) @map("deals_lost")
  pipelineAdded     Decimal  @map("pipeline_added") @db.Decimal(15, 2)
  pipelineAged30    Decimal  @map("pipeline_aged_30") @db.Decimal(15, 2)
  pipelineAged60    Decimal  @map("pipeline_aged_60") @db.Decimal(15, 2)
  pipelineAged90Plus Decimal @map("pipeline_aged_90_plus") @db.Decimal(15, 2)
  generatedAt       DateTime @default(now()) @map("generated_at")

  @@index([tenantId])
  @@index([tenantId, period])
  @@map("sales_velocity_metrics")
}

model AccountTeamMember {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  customerId  String   @map("customer_id")
  userId      String   @map("user_id")
  role        String   // EXECUTIVE_SPONSOR, ACCOUNT_MANAGER, SOLUTION_ARCHITECT, SUPPORT_MANAGER
  isPrimary   Boolean  @default(false) @map("is_primary")
  accessLevel String   @default("FULL") // FULL, READ_ONLY, LIMITED
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerId, userId])
  @@index([tenantId])
  @@index([customerId])
  @@map("account_team_members")
}

// ── 16. WEBHOOK EVENT DELIVERY ──────────────────────────────────────────────

model CrmEventDeliveryLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  eventType   String
  entityType  String   // CUSTOMER, LEAD, OPPORTUNITY, ACTIVITY, CASE
  entityId    String   @map("entity_id")
  payload     Json
  status      String   @default("PENDING") // PENDING, DELIVERED, FAILED, SKIPPED
  errorMessage String? @map("error_message")
  deliveredTo Json?    @map("delivered_to") // [{webhookId, status, statusCode}]
  createdAt   DateTime @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")

  @@index([tenantId])
  @@index([tenantId, eventType])
  @@map("crm_event_delivery_logs")
}

// ── 17. PIPELINE INSPECTION ─────────────────────────────────────────────────

model PipelineInspectionConfig {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  pipelineId      String   @map("pipeline_id")
  checkIntervalHours Int   @default(24) @map("check_interval_hours")
  rules           Json     // [{name:"stage_stall", enabled:true, thresholdDays:7}, ...]
  alertRecipients Json?    @map("alert_recipients") // [{type:"email", value:"..."}]
  autoResolveDays Int?     @default(0) @map("auto_resolve_days")
  isActive        Boolean  @default(true) @map("is_active")
  lastRunAt       DateTime? @map("last_run_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("pipeline_inspection_configs")
}

// ── 18. CAMPAIGN & MARKETING DEEPENING ──────────────────────────────────────

model CampaignAsset {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  campaignId  String   @map("campaign_id")
  type        String   // IMAGE, VIDEO, DOCUMENT, EMAIL_TEMPLATE, LANDING_PAGE, SOCIAL_POST
  name        String
  fileUrl     String?  @map("file_url")
  content     String?  @db.Text
  metadata    Json?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([campaignId])
  @@map("campaign_assets")
}

model CampaignAttribution {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  campaignId      String   @map("campaign_id")
  opportunityId   String   @map("opportunity_id")
  attributionType String   // FIRST_TOUCH, LAST_TOUCH, MULTI_TOUCH, LINEAR, TIME_DECAY
  weight          Decimal  @default(1) @map("weight") @db.Decimal(5, 2)
