model MarketingCalendarEntry {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  title       String
  description String?
  entryType   String   // CAMPAIGN, EMAIL, SOCIAL, EVENT, WEBINAR, CONTENT
