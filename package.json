{
  "name": "@kannan19302/database",
  "version": "1.0.14",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "Prisma ORM schema, client, and migrations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "prisma": [
        "dist/prisma.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "default": "./dist/prisma.js"
    }
  },
  "scripts": {
    "build": "pnpm db:generate && node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc && node scripts/copy-prisma-clients.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema && prisma generate --schema prisma/idp-schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema && prisma migrate dev --schema prisma/idp-schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema && prisma migrate deploy --schema prisma/idp-schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:platform": "tsx prisma/seed-platform.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "@prisma/config": "^6.19.3",
    "prisma": "^6.2.0"
  },
  "devDependencies": {
    "@kannan19302/config": "^1.0.2",
    "@kannan19302/shared": "file:../shared",
    "@nestjs/common": "^11.1.28",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist",
    "src",
    "prisma",
    "prisma.config.ts",
    "README.md",
    "scripts"
  ]
}
